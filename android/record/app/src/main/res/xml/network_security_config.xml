<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The development server is signed by this machine; if its certificate was added to
         the phone, the app trusts it the way the phone's browser does. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
