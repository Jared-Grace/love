<?xml version="1.0" encoding="utf-8"?>
<!-- The store build: the store updates the app, so it may not install packages itself
     (the shared library asks for that permission for the owner's self-updating build). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
