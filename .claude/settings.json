            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh /home/j/repos/love/.claude/hooks/tmux_notification_mark.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh /home/j/repos/love/.claude/hooks/claude_waiting_notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/j/repos/love; node scripts/ai.mjs ai_git 2>&1 | tail -8",
            "timeout": 90,
            "statusMessage": "Auto-committing"
          },
          {
            "type": "command",
            "command": "sh /home/j/repos/love/.claude/hooks/tmux_window_mark.sh 'fg=black,bg=colour226,bold'",
