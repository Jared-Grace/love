{"bsb_PSA_120":{"chapter":120,"lines":16,"match_rate":0.794,"confidence":0.304,"words_written":97,"words_heard":99,"words_matched":77,"starts":[6.621,9.602,15.623,18.123,24.464,32.545,38.486,43.767,45.347,48.488,51.568,54.729,57.849,59.79,62.57,68.571],"starts_heard":[7.08,8.620000000000001,15.56,17.979999999999997,23.34,29.86,36.16,45.18,45.6,48.18,52.16,54.58,57.64,59.86,63.1,69.12],"flagged":[{"line":0,"start":6.621,"start_heard":7.08,"apart":0.459,"text":"A song of ascents."},{"line":1,"start":9.602,"start_heard":8.620000000000001,"apart":0.982,"text":"In my distress I cried to the LORD,"},{"line":4,"start":24.464,"start_heard":23.34,"apart":1.124,"text":"from lying lips and a deceitful tongue."},{"line":5,"start":32.545,"start_heard":29.86,"apart":2.685,"text":"What will He do to you,"},{"line":6,"start":38.486,"start_heard":36.16,"apart":2.326,"text":"and what will be added to you,"},{"line":7,"start":43.767,"start_heard":45.18,"apart":1.413,"text":"O deceitful tongue?"},{"line":9,"start":48.488,"start_heard":48.18,"apart":0.308,"text":"with burning coals of the broom tree!"},{"line":10,"start":51.568,"start_heard":52.16,"apart":0.592,"text":"Woe to me that I dwell in Meshech,"},{"line":14,"start":62.57,"start_heard":63.1,"apart":0.53,"text":"I am in favor of peace;"},{"line":15,"start":68.571,"start_heard":69.12,"apart":0.549,"text":"but when I speak, they want war."}]},"bsb_PSA_121":{"chapter":121,"lines":17,"match_rate":0.934,"confidence":0.327,"words_written":106,"words_heard":105,"words_matched":99,"starts":[0.16,5.641,8.842,11.843,15.684,21.105,24.786,31.168,37.369,43.571,46.131,49.152,52.473,55.994,62.515,68.037,74.158],"starts_heard":[1.8399999999999999,4.760000000000001,9.06,12.06,15.120000000000001,20.84,24.419999999999998,31.16,35.92,43.08,46.44,51.16,52.72,55.98,61.82,68.28,75.02000000000001],"flagged":[{"line":0,"start":0.16,"start_heard":1.8399999999999999,"apart":1.68,"text":"A song of ascents."},{"line":1,"start":5.641,"start_heard":4.760000000000001,"apart":0.881,"text":"I lift up my eyes to the hills."},{"line":4,"start":15.684,"start_heard":15.120000000000001,"apart":0.564,"text":"the Maker of heaven and earth."},{"line":6,"start":24.786,"start_heard":24.419999999999998,"apart":0.366,"text":"your Protector will not slumber."},{"line":8,"start":37.369,"start_heard":35.92,"apart":1.449,"text":"will neither slumber nor sleep."},{"line":9,"start":43.571,"start_heard":43.08,"apart":0.491,"text":"The LORD is your keeper;"},{"line":10,"start":46.131,"start_heard":46.44,"apart":0.309,"text":"the LORD is the shade on your right hand."},{"line":11,"start":49.152,"start_heard":51.16,"apart":2.008,"text":"The sun will not strike you by day,"},{"line":14,"start":62.515,"start_heard":61.82,"apart":0.695,"text":"He will preserve your soul."},{"line":16,"start":74.158,"start_heard":75.02000000000001,"apart":0.862,"text":"both now and forevermore."}]},"bsb_PSA_122":{"chapter":122,"lines":21,"match_rate":0.888,"confidence":0.202,"words_written":134,"words_heard":126,"words_matched":119,"starts":[3.96,10.601,15.842,21.402,25.503,26.763,28.843,31.223,33.944,37.444,42.505,46.885,51.325,55.426,59.166,62.087,65.067,73.168,79.208,84.069,92.75],"starts_heard":[4.62,10.120000000000001,15.34,20.7,null,26.02,31.22,35.08,null,37.519999999999996,44.199999999999996,47.24,50.66,55.8,59.379999999999995,62.42,65.12,72.78,77.38000000000001,82.18,89.64],"flagged":[{"line":0,"start":3.96,"start_heard":4.62,"apart":0.66,"text":"A song of ascents. Of David."},{"line":1,"start":10.601,"start_heard":10.120000000000001,"apart":0.481,"text":"I was glad when they said to me,"},{"line":2,"start":15.842,"start_heard":15.34,"apart":0.502,"text":"“Let us go to the house of the LORD.”"},{"line":3,"start":21.402,"start_heard":20.7,"apart":0.702,"text":"Our feet are standing in your gates,"},{"line":4,"start":25.503,"start_heard":null,"apart":null,"text":"O Jerusalem."},{"line":5,"start":26.763,"start_heard":26.02,"apart":0.743,"text":"Jerusalem is built up"},{"line":6,"start":28.843,"start_heard":31.22,"apart":2.377,"text":"as a city united together,"},{"line":7,"start":31.223,"start_heard":35.08,"apart":3.857,"text":"where the tribes go up,"},{"line":8,"start":33.944,"start_heard":null,"apart":null,"text":"the tribes of the LORD,"},{"line":10,"start":42.505,"start_heard":44.199999999999996,"apart":1.695,"text":"to give thanks to the name of the LORD."},{"line":11,"start":46.885,"start_heard":47.24,"apart":0.355,"text":"For there the thrones of judgment stand,"},{"line":12,"start":51.325,"start_heard":50.66,"apart":0.665,"text":"the thrones of the house of David."},{"line":13,"start":55.426,"start_heard":55.8,"apart":0.374,"text":"Pray for the peace of Jerusalem:"},{"line":15,"start":62.087,"start_heard":62.42,"apart":0.333,"text":"May there be peace within your walls,"},{"line":17,"start":73.168,"start_heard":72.78,"apart":0.388,"text":"For the sake of my brothers and friends,"},{"line":18,"start":79.208,"start_heard":77.38000000000001,"apart":1.828,"text":"I will say, “Peace be within you.”"},{"line":19,"start":84.069,"start_heard":82.18,"apart":1.889,"text":"For the sake of the house of the LORD our God,"},{"line":20,"start":92.75,"start_heard":89.64,"apart":3.11,"text":"I will seek your prosperity."}]},"bsb_PSA_123":{"chapter":123,"lines":13,"match_rate":0.902,"confidence":0.21,"words_written":82,"words_heard":86,"words_matched":74,"starts":[2.36,6.341,11.502,20.544,24.545,29.766,33.827,40.728,46.989,50.71,59.592,68.433,74.895],"starts_heard":[2.86,6.12,11.360000000000001,19.799999999999997,24.439999999999998,29.54,33.699999999999996,40.58,46.54,50.3,59.019999999999996,67.60000000000001,80.7],"flagged":[{"line":0,"start":2.36,"start_heard":2.86,"apart":0.5,"text":"A song of ascents."},{"line":3,"start":20.544,"start_heard":19.799999999999997,"apart":0.744,"text":"As the eyes of servants"},{"line":8,"start":46.989,"start_heard":46.54,"apart":0.449,"text":"until He shows us mercy."},{"line":9,"start":50.71,"start_heard":50.3,"apart":0.41,"text":"Have mercy on us, O LORD, have mercy,"},{"line":10,"start":59.592,"start_heard":59.019999999999996,"apart":0.572,"text":"for we have endured much contempt."},{"line":11,"start":68.433,"start_heard":67.60000000000001,"apart":0.833,"text":"We have endured much scorn from the arrogant,"},{"line":12,"start":74.895,"start_heard":80.7,"apart":5.805,"text":"much contempt from the proud."}]},"bsb_PSA_124":{"chapter":124,"lines":17,"match_rate":0.975,"confidence":0.392,"words_written":118,"words_heard":125,"words_matched":115,"starts":[1.48,4.96,9.881,12.361,15.981,18.042,22.182,26.262,29.542,35.723,37.803,41.463,44.404,48.504,57.925,65.125,74.166],"starts_heard":[0.4,4.36,11.200000000000001,12.26,16.16,18,22.4,26.38,29.439999999999998,35.46,38.019999999999996,41.44,44.42,48.559999999999995,55.46,61.28,70.32000000000001],"flagged":[{"line":0,"start":1.48,"start_heard":0.4,"apart":1.08,"text":"A song of ascents. Of David."},{"line":1,"start":4.96,"start_heard":4.36,"apart":0.6,"text":"If the LORD had not been on our side—"},{"line":2,"start":9.881,"start_heard":11.200000000000001,"apart":1.319,"text":"let Israel now declare—"},{"line":14,"start":57.925,"start_heard":55.46,"apart":2.465,"text":"the net is torn, and we have slipped away."},{"line":15,"start":65.125,"start_heard":61.28,"apart":3.845,"text":"Our help is in the name of the LORD,"},{"line":16,"start":74.166,"start_heard":70.32000000000001,"apart":3.846,"text":"the Maker of heaven and earth."}]},"bsb_PSA_125":{"chapter":125,"lines":15,"match_rate":0.928,"confidence":0.285,"words_written":97,"words_heard":98,"words_matched":90,"starts":[1.28,4.741,11.063,17.405,23.346,28.647,33.469,37.65,43.251,48.133,53.134,58.995,64.137,67.598,74.479],"starts_heard":[0.4,4.54,10.22,16.639999999999997,23.479999999999997,28.08,33.14,37.96,42.879999999999995,48.379999999999995,54.92,60.839999999999996,64.4,67.94000000000001,74.48],"flagged":[{"line":0,"start":1.28,"start_heard":0.4,"apart":0.88,"text":"A song of ascents."},{"line":2,"start":11.063,"start_heard":10.22,"apart":0.843,"text":"It cannot be moved; it abides forever."},{"line":3,"start":17.405,"start_heard":16.639999999999997,"apart":0.765,"text":"As the mountains surround Jerusalem,"},{"line":5,"start":28.647,"start_heard":28.08,"apart":0.567,"text":"both now and forevermore."},{"line":6,"start":33.469,"start_heard":33.14,"apart":0.329,"text":"For the scepter of the wicked will not rest"},{"line":7,"start":37.65,"start_heard":37.96,"apart":0.31,"text":"upon the land allotted to the righteous,"},{"line":8,"start":43.251,"start_heard":42.879999999999995,"apart":0.371,"text":"so that the righteous will not put forth"},{"line":10,"start":53.134,"start_heard":54.92,"apart":1.786,"text":"Do good, O LORD, to those who are good,"},{"line":11,"start":58.995,"start_heard":60.839999999999996,"apart":1.845,"text":"and to the upright in heart."},{"line":13,"start":67.598,"start_heard":67.94000000000001,"apart":0.342,"text":"the LORD will banish with the evildoers."}]},"bsb_PSA_126":{"chapter":126,"lines":17,"match_rate":0.899,"confidence":0.187,"words_written":99,"words_heard":102,"words_matched":89,"starts":[3.961,7.581,14.142,17.863,23.703,27.704,33.425,38.365,42.886,47.147,52.387,57.248,59.328,62.609,65.889,70.39,77.191],"starts_heard":[4.46,7.66,14.3,18.119999999999997,23.419999999999998,27.939999999999998,33,38.68,43.26,47.48,54.519999999999996,57.62,59.4,62.9,66.26,70.74000000000001,null],"flagged":[{"line":0,"start":3.961,"start_heard":4.46,"apart":0.499,"text":"A song of ascents."},{"line":6,"start":33.425,"start_heard":33,"apart":0.425,"text":"“The LORD has done great things for them.”"},{"line":7,"start":38.365,"start_heard":38.68,"apart":0.315,"text":"The LORD has done great things for us;"},{"line":8,"start":42.886,"start_heard":43.26,"apart":0.374,"text":"we are filled with joy."},{"line":9,"start":47.147,"start_heard":47.48,"apart":0.333,"text":"Restore our captives, O LORD,"},{"line":10,"start":52.387,"start_heard":54.519999999999996,"apart":2.133,"text":"like streams in the Negev."},{"line":11,"start":57.248,"start_heard":57.62,"apart":0.372,"text":"Those who sow in tears"},{"line":14,"start":65.889,"start_heard":66.26,"apart":0.371,"text":"bearing a trail of seed,"},{"line":15,"start":70.39,"start_heard":70.74000000000001,"apart":0.35,"text":"will surely return with shouts of joy,"},{"line":16,"start":77.191,"start_heard":null,"apart":null,"text":"carrying sheaves of grain."}]},"bsb_PSA_127":{"chapter":127,"lines":17,"match_rate":0.972,"confidence":0.228,"words_written":107,"words_heard":109,"words_matched":104,"starts":[0.96,8.421,11.262,15.042,21.023,27.084,30.045,33.305,37.826,41.566,49.087,54.928,61.809,67.83,70.071,73.551,76.091],"starts_heard":[0.4,7.4,11.620000000000001,14.34,20.4,26.24,29.68,34.339999999999996,37.839999999999996,42.78,49.14,54.98,62.1,67.80000000000001,69.96000000000001,73.06,76.34],"flagged":[{"line":0,"start":0.96,"start_heard":0.4,"apart":0.56,"text":"A song of ascents. Of Solomon."},{"line":1,"start":8.421,"start_heard":7.4,"apart":1.021,"text":"Unless the LORD builds the house,"},{"line":2,"start":11.262,"start_heard":11.620000000000001,"apart":0.358,"text":"its builders labor in vain;"},{"line":3,"start":15.042,"start_heard":14.34,"apart":0.702,"text":"unless the LORD protects the city,"},{"line":4,"start":21.023,"start_heard":20.4,"apart":0.623,"text":"its watchmen stand guard in vain."},{"line":5,"start":27.084,"start_heard":26.24,"apart":0.844,"text":"In vain you rise early"},{"line":6,"start":30.045,"start_heard":29.68,"apart":0.365,"text":"and stay up late,"},{"line":7,"start":33.305,"start_heard":34.339999999999996,"apart":1.035,"text":"toiling for bread to eat—"},{"line":9,"start":41.566,"start_heard":42.78,"apart":1.214,"text":"Children are indeed a heritage from the LORD,"},{"line":15,"start":73.551,"start_heard":73.06,"apart":0.491,"text":"He will not be put to shame"}]},"bsb_PSA_128":{"chapter":128,"lines":17,"match_rate":0.939,"confidence":0.339,"words_written":98,"words_heard":102,"words_matched":92,"starts":[4.321,7.502,12.263,14.783,21.505,25.085,29.486,32.267,34.808,37.828,42.049,44.83,48.791,54.212,56.792,58.073,60.533],"starts_heard":[3.92,7.640000000000001,12.42,14.38,21.979999999999997,25.5,29.7,32.64,35.12,37.86,42.24,45.22,49.14,53.16,57.019999999999996,58.14,60.8],"flagged":[{"line":0,"start":4.321,"start_heard":3.92,"apart":0.401,"text":"A song of ascents."},{"line":3,"start":14.783,"start_heard":14.38,"apart":0.403,"text":"For when you eat the fruit of your labor,"},{"line":4,"start":21.505,"start_heard":21.979999999999997,"apart":0.475,"text":"blessings and prosperity will be yours."},{"line":5,"start":25.085,"start_heard":25.5,"apart":0.415,"text":"Your wife will be like a fruitful vine"},{"line":7,"start":32.267,"start_heard":32.64,"apart":0.373,"text":"your sons like olive shoots"},{"line":8,"start":34.808,"start_heard":35.12,"apart":0.312,"text":"sitting around your table."},{"line":11,"start":44.83,"start_heard":45.22,"apart":0.39,"text":"May the LORD bless you from Zion,"},{"line":12,"start":48.791,"start_heard":49.14,"apart":0.349,"text":"that you may see the prosperity of Jerusalem"},{"line":13,"start":54.212,"start_heard":53.16,"apart":1.052,"text":"all the days of your life,"}]},"bsb_PSA_129":{"chapter":129,"lines":18,"match_rate":0.928,"confidence":0.288,"words_written":125,"words_heard":133,"words_matched":116,"starts":[5.34,8.981,15.461,17.861,23.002,29.682,33.042,36.362,42.663,49.323,53.404,58.784,62.284,66.105,71.385,74.145,81.186,88.546],"starts_heard":[5,8.620000000000001,15.32,17.32,23.099999999999998,28.88,33.18,36.379999999999995,42.04,48.519999999999996,55.559999999999995,59.1,63.1,66.98,71.06,74.48,81.48,89.78],"flagged":[{"line":0,"start":5.34,"start_heard":5,"apart":0.34,"text":"A song of ascents."},{"line":1,"start":8.981,"start_heard":8.620000000000001,"apart":0.361,"text":"Many a time they have persecuted me from my youth—"},{"line":3,"start":17.861,"start_heard":17.32,"apart":0.541,"text":"many a time they have persecuted me from my youth,"},{"line":5,"start":29.682,"start_heard":28.88,"apart":0.802,"text":"The plowmen plowed over my back;"},{"line":8,"start":42.663,"start_heard":42.04,"apart":0.623,"text":"He has cut me from the cords of the wicked."},{"line":9,"start":49.323,"start_heard":48.519999999999996,"apart":0.803,"text":"May all who hate Zion"},{"line":10,"start":53.404,"start_heard":55.559999999999995,"apart":2.156,"text":"be turned back in shame."},{"line":11,"start":58.784,"start_heard":59.1,"apart":0.316,"text":"May they be like grass on the rooftops,"},{"line":12,"start":62.284,"start_heard":63.1,"apart":0.816,"text":"which withers before it can grow,"},{"line":13,"start":66.105,"start_heard":66.98,"apart":0.875,"text":"unable to fill the hands of the reaper,"},{"line":14,"start":71.385,"start_heard":71.06,"apart":0.325,"text":"or the arms of the binder of sheaves."},{"line":15,"start":74.145,"start_heard":74.48,"apart":0.335,"text":"May none who pass by say to them,"},{"line":17,"start":88.546,"start_heard":89.78,"apart":1.234,"text":"we bless you in the name of the LORD.”"}]},"bsb_PSA_130":{"chapter":130,"lines":19,"match_rate":0.861,"confidence":0.208,"words_written":122,"words_heard":129,"words_matched":105,"starts":[0.42,6.301,7.541,11.581,15.422,22.743,29.004,32.204,35.344,39.625,46.846,52.206,54.627,60.227,65.848,72.989,76.869,80.91,91.371],"starts_heard":[4.08,6.260000000000001,7.66,12.08,15.56,22.9,28.52,32.64,35.62,39.28,46.5,52.54,56.62,60.08,67.2,70.24000000000001,73.94000000000001,81.78,86.42],"flagged":[{"line":0,"start":0.42,"start_heard":4.08,"apart":3.66,"text":"A song of ascents."},{"line":3,"start":11.581,"start_heard":12.08,"apart":0.499,"text":"O Lord, hear my voice;"},{"line":6,"start":29.004,"start_heard":28.52,"apart":0.484,"text":"then who, O Lord, could stand?"},{"line":7,"start":32.204,"start_heard":32.64,"apart":0.436,"text":"But with You there is forgiveness,"},{"line":9,"start":39.625,"start_heard":39.28,"apart":0.345,"text":"I wait for the LORD; my soul does wait,"},{"line":10,"start":46.846,"start_heard":46.5,"apart":0.346,"text":"and in His word I put my hope."},{"line":11,"start":52.206,"start_heard":52.54,"apart":0.334,"text":"My soul waits for the Lord"},{"line":12,"start":54.627,"start_heard":56.62,"apart":1.993,"text":"more than watchmen wait for the morning—"},{"line":14,"start":65.848,"start_heard":67.2,"apart":1.352,"text":"O Israel, put your hope in the LORD,"},{"line":15,"start":72.989,"start_heard":70.24000000000001,"apart":2.749,"text":"for with the LORD is loving devotion,"},{"line":16,"start":76.869,"start_heard":73.94000000000001,"apart":2.929,"text":"and with Him is redemption in abundance."},{"line":17,"start":80.91,"start_heard":81.78,"apart":0.87,"text":"And He will redeem Israel"},{"line":18,"start":91.371,"start_heard":86.42,"apart":4.951,"text":"from all iniquity."}]},"bsb_PSA_131":{"chapter":131,"lines":10,"match_rate":0.881,"confidence":0.353,"words_written":67,"words_heard":78,"words_matched":59,"starts":[9.121,18.221,22.901,27.662,32.202,35.902,46.283,55.524,65.924,128.228],"starts_heard":[0.4,17.36,22.779999999999998,26.459999999999997,32.18,35.54,46.16,55.62,65.18,128.02],"flagged":[{"line":0,"start":9.121,"start_heard":0.4,"apart":8.721,"text":"A song of ascents. Of David."},{"line":1,"start":18.221,"start_heard":17.36,"apart":0.861,"text":"My heart is not proud, O LORD,"},{"line":3,"start":27.662,"start_heard":26.459999999999997,"apart":1.202,"text":"I do not aspire to great things"},{"line":5,"start":35.902,"start_heard":35.54,"apart":0.362,"text":"Surely I have stilled and quieted my soul;"},{"line":8,"start":65.924,"start_heard":65.18,"apart":0.744,"text":"O Israel, put your hope in the LORD,"}]},"bsb_PSA_132":{"chapter":132,"lines":41,"match_rate":0.915,"confidence":0.177,"words_written":281,"words_heard":280,"words_matched":257,"starts":[0.18,6.081,11.701,13.761,15.922,19.602,22.982,24.842,28.423,30.603,33.643,37.744,41.924,45.324,48.945,54.485,58.886,62.246,66.046,69.847,73.947,78.067,82.668,86.928,88.688,91.009,92.649,95.129,97.509,98.969,101.45,104.81,108.95,112.471,116.631,120.771,124.012,127.032,134.233,137.313,140.813],"starts_heard":[2.94,6.66,11.72,13.700000000000001,15.860000000000001,20.419999999999998,22.88,24.84,28.32,30.779999999999998,33.24,37.839999999999996,41.699999999999996,45.58,49,55.64,58.3,62,66.22,69.76,74.10000000000001,78.06,82.38000000000001,86.62,89.02000000000001,91.46000000000001,93.58000000000001,95.38000000000001,97.84,99.52000000000001,101.46000000000001,104.36,108.64,112.32000000000001,116.36,119.96000000000001,124.26,130.08,133.8,137.62,140.82],"flagged":[{"line":0,"start":0.18,"start_heard":2.94,"apart":2.76,"text":"A song of ascents."},{"line":1,"start":6.081,"start_heard":6.66,"apart":0.579,"text":"O LORD, remember on behalf of David"},{"line":5,"start":19.602,"start_heard":20.419999999999998,"apart":0.818,"text":"“I will not enter my house"},{"line":10,"start":33.643,"start_heard":33.24,"apart":0.403,"text":"a dwelling for the Mighty One of Jacob.”"},{"line":15,"start":54.485,"start_heard":55.64,"apart":1.155,"text":"Arise, O LORD, to Your resting place,"},{"line":16,"start":58.886,"start_heard":58.3,"apart":0.586,"text":"You and the ark of Your strength."},{"line":23,"start":86.928,"start_heard":86.62,"apart":0.308,"text":"“One of your descendants"},{"line":24,"start":88.688,"start_heard":89.02000000000001,"apart":0.332,"text":"I will place on your throne."},{"line":25,"start":91.009,"start_heard":91.46000000000001,"apart":0.451,"text":"If your sons keep My covenant"},{"line":26,"start":92.649,"start_heard":93.58000000000001,"apart":0.931,"text":"and the testimony I will teach them,"},{"line":28,"start":97.509,"start_heard":97.84,"apart":0.331,"text":"forever and ever.”"},{"line":29,"start":98.969,"start_heard":99.52000000000001,"apart":0.551,"text":"For the LORD has chosen Zion;"},{"line":31,"start":104.81,"start_heard":104.36,"apart":0.45,"text":"“This is My resting place forever and ever;"},{"line":32,"start":108.95,"start_heard":108.64,"apart":0.31,"text":"here I will dwell, for I have desired this home."},{"line":35,"start":120.771,"start_heard":119.96000000000001,"apart":0.811,"text":"I will clothe her priests with salvation,"},{"line":37,"start":127.032,"start_heard":130.08,"apart":3.048,"text":"There I will make a horn grow for David;"},{"line":38,"start":134.233,"start_heard":133.8,"apart":0.433,"text":"I have prepared a lamp for My anointed one."},{"line":39,"start":137.313,"start_heard":137.62,"apart":0.307,"text":"I will clothe his enemies with shame,"}]},"bsb_PSA_133":{"chapter":133,"lines":11,"match_rate":0.909,"confidence":0.455,"words_written":66,"words_heard":119,"words_matched":60,"starts":[11.741,29.722,39.222,48.903,66.344,134.408,137.508,142.429,146.529,151.829,157.189],"starts_heard":[17.099999999999998,30.479999999999997,38.48,47.98,52.08,129.02,136.88,141.84,145.96,150.5,155.86],"flagged":[{"line":0,"start":11.741,"start_heard":17.099999999999998,"apart":5.359,"text":"A song of ascents. Of David."},{"line":1,"start":29.722,"start_heard":30.479999999999997,"apart":0.758,"text":"Behold, how good and pleasant it is"},{"line":2,"start":39.222,"start_heard":38.48,"apart":0.742,"text":"when brothers live together in harmony!"},{"line":3,"start":48.903,"start_heard":47.98,"apart":0.923,"text":"It is like fine oil on the head,"},{"line":4,"start":66.344,"start_heard":52.08,"apart":14.264,"text":"running down on the beard,"},{"line":5,"start":134.408,"start_heard":129.02,"apart":5.388,"text":"running down Aaron’s beard"},{"line":6,"start":137.508,"start_heard":136.88,"apart":0.628,"text":"over the collar of his robes."},{"line":7,"start":142.429,"start_heard":141.84,"apart":0.589,"text":"It is like the dew of Hermon"},{"line":8,"start":146.529,"start_heard":145.96,"apart":0.569,"text":"falling on the mountains of Zion."},{"line":9,"start":151.829,"start_heard":150.5,"apart":1.329,"text":"For there the LORD has bestowed the blessing"},{"line":10,"start":157.189,"start_heard":155.86,"apart":1.329,"text":"of life forevermore."}]},"bsb_PSA_134":{"chapter":134,"lines":9,"match_rate":0.979,"confidence":0.258,"words_written":48,"words_heard":103,"words_matched":47,"starts":[4.22,9.881,15.541,20.021,25.502,28.762,36.582,42.223,107.667],"starts_heard":[4.720000000000001,10.200000000000001,15.26,20.299999999999997,22.72,29.22,36.4,39.46,118.02000000000001],"flagged":[{"line":0,"start":4.22,"start_heard":4.720000000000001,"apart":0.5,"text":"A song of ascents."},{"line":1,"start":9.881,"start_heard":10.200000000000001,"apart":0.319,"text":"Come, bless the LORD,"},{"line":4,"start":25.502,"start_heard":22.72,"apart":2.782,"text":"in the house of the LORD!"},{"line":5,"start":28.762,"start_heard":29.22,"apart":0.458,"text":"Lift up your hands to the sanctuary"},{"line":7,"start":42.223,"start_heard":39.46,"apart":2.763,"text":"May the LORD, the Maker of heaven and earth,"},{"line":8,"start":107.667,"start_heard":118.02000000000001,"apart":10.353,"text":"bless you from Zion."}]},"bsb_PSA_135":{"chapter":135,"lines":48,"match_rate":0.891,"confidence":0.356,"words_written":311,"words_heard":287,"words_matched":277,"starts":[2.14,5.1,8.501,12.041,15.581,19.761,24.701,29.922,34.082,37.722,41.102,44.423,47.483,50.323,53.023,55.883,58.284,60.984,63.984,67.584,69.844,75.425,78.605,82.665,85.125,88.365,89.785,91.466,94.886,98.606,103.246,108.547,111.907,115.527,119.927,122.007,124.247,127.368,130.768,133.368,137.648,141.068,145.809,148.729,152.489,156.009,159.45,162.57],"starts_heard":[2.54,5.0600000000000005,8.58,12.3,15.700000000000001,20.24,24.38,30.16,33.82,37.68,41.32,44.76,47.18,50.24,53.339999999999996,55.9,58.74,61.12,64.04,67.84,70.36,75.72,78.68,82.42,85.72,null,null,90.48,95.04,99,102.64,108.18,111.66000000000001,116.24000000000001,117.76,null,121.36,124.64,130.98000000000002,133.5,137.24,141.36,145.58,149.04,152.58,156.32,159.88,162.88],"flagged":[{"line":0,"start":2.14,"start_heard":2.54,"apart":0.4,"text":"Hallelujah!"},{"line":5,"start":19.761,"start_heard":20.24,"apart":0.479,"text":"Hallelujah, for the LORD is good;"},{"line":6,"start":24.701,"start_heard":24.38,"apart":0.321,"text":"sing praises to His name, for it is lovely."},{"line":11,"start":44.423,"start_heard":44.76,"apart":0.337,"text":"The LORD does all that pleases Him"},{"line":12,"start":47.483,"start_heard":47.18,"apart":0.303,"text":"in the heavens and on the earth,"},{"line":14,"start":53.023,"start_heard":53.339999999999996,"apart":0.317,"text":"He causes the clouds to rise"},{"line":16,"start":58.284,"start_heard":58.74,"apart":0.456,"text":"He generates the lightning with the rain"},{"line":20,"start":69.844,"start_heard":70.36,"apart":0.516,"text":"He sent signs and wonders into your midst, O Egypt,"},{"line":24,"start":85.125,"start_heard":85.72,"apart":0.595,"text":"Sihon king of the Amorites,"},{"line":25,"start":88.365,"start_heard":null,"apart":null,"text":"Og king of Bashan,"},{"line":26,"start":89.785,"start_heard":null,"apart":null,"text":"and all the kings of Canaan."},{"line":27,"start":91.466,"start_heard":90.48,"apart":0.986,"text":"He gave their land as an inheritance,"},{"line":29,"start":98.606,"start_heard":99,"apart":0.394,"text":"Your name, O LORD, endures forever,"},{"line":30,"start":103.246,"start_heard":102.64,"apart":0.606,"text":"Your renown, O LORD, through all generations."},{"line":31,"start":108.547,"start_heard":108.18,"apart":0.367,"text":"For the LORD will vindicate His people"},{"line":33,"start":115.527,"start_heard":116.24000000000001,"apart":0.713,"text":"The idols of the nations are silver and gold,"},{"line":34,"start":119.927,"start_heard":117.76,"apart":2.167,"text":"made by the hands of men."},{"line":35,"start":122.007,"start_heard":null,"apart":null,"text":"They have mouths, but cannot speak;"},{"line":36,"start":124.247,"start_heard":121.36,"apart":2.887,"text":"they have eyes, but cannot see;"},{"line":37,"start":127.368,"start_heard":124.64,"apart":2.728,"text":"they have ears, but cannot hear;"},{"line":40,"start":137.648,"start_heard":137.24,"apart":0.408,"text":"as do all who trust in them."},{"line":43,"start":148.729,"start_heard":149.04,"apart":0.311,"text":"O house of Levi, bless the LORD;"},{"line":45,"start":156.009,"start_heard":156.32,"apart":0.311,"text":"Blessed be the LORD from Zion—"},{"line":46,"start":159.45,"start_heard":159.88,"apart":0.43,"text":"He who dwells in Jerusalem."},{"line":47,"start":162.57,"start_heard":162.88,"apart":0.31,"text":"Hallelujah!"}]},"bsb_PSA_137":{"chapter":137,"lines":25,"match_rate":0.925,"confidence":0.182,"words_written":146,"words_heard":149,"words_matched":135,"starts":[0.08,8.581,12.301,14.202,16.662,21.762,28.203,32.624,38.064,41.124,44.165,47.605,51.086,53.586,57.966,60.467,62.387,67.327,69.848,73.508,75.768,78.228,80.129,83.229,85.589],"starts_heard":[1.88,8.92,12.200000000000001,14.52,16.7,21.599999999999998,27.799999999999997,31.54,36.58,39.1,44.339999999999996,47.519999999999996,51.14,53.559999999999995,56.4,60.42,62.66,67.62,71.06,74.10000000000001,76.48,78.88000000000001,80.78,83.84,85.78],"flagged":[{"line":0,"start":0.08,"start_heard":1.88,"apart":1.8,"text":"By the rivers of Babylon we sat and wept"},{"line":1,"start":8.581,"start_heard":8.92,"apart":0.339,"text":"when we remembered Zion."},{"line":3,"start":14.202,"start_heard":14.52,"apart":0.318,"text":"we hung our harps,"},{"line":6,"start":28.203,"start_heard":27.799999999999997,"apart":0.403,"text":"“Sing us a song of Zion.”"},{"line":7,"start":32.624,"start_heard":31.54,"apart":1.084,"text":"How can we sing a song of the LORD"},{"line":8,"start":38.064,"start_heard":36.58,"apart":1.484,"text":"in a foreign land?"},{"line":9,"start":41.124,"start_heard":39.1,"apart":2.024,"text":"If I forget you, O Jerusalem,"},{"line":14,"start":57.966,"start_heard":56.4,"apart":1.566,"text":"as my greatest joy!"},{"line":18,"start":69.848,"start_heard":71.06,"apart":1.212,"text":"“tear it down to its foundations!”"},{"line":19,"start":73.508,"start_heard":74.10000000000001,"apart":0.592,"text":"O Daughter of Babylon,"},{"line":20,"start":75.768,"start_heard":76.48,"apart":0.712,"text":"doomed to destruction,"},{"line":21,"start":78.228,"start_heard":78.88000000000001,"apart":0.652,"text":"blessed is he who repays you"},{"line":22,"start":80.129,"start_heard":80.78,"apart":0.651,"text":"as you have done to us."},{"line":23,"start":83.229,"start_heard":83.84,"apart":0.611,"text":"Blessed is he who seizes your infants"}]},"bsb_PSA_138":{"chapter":138,"lines":25,"match_rate":0.929,"confidence":0.151,"words_written":168,"words_heard":172,"words_matched":156,"starts":[0.52,5.001,8.281,13.262,16.983,19.864,24.584,27.425,30.005,35.266,40.027,47.188,49.709,53.77,58.85,61.491,64.071,69.172,73.233,78.634,81.174,85.275,87.896,89.836,95.057],"starts_heard":[1.26,4.32,8.02,12.9,17.919999999999998,19.959999999999997,24.619999999999997,27.56,30.22,35.23,40.24,47.059999999999995,49.72,53.74,59.5,61.58,64.18,69.12,73.30000000000001,78.78,81.18,84.66000000000001,87.42,90.52000000000001,95.54],"flagged":[{"line":0,"start":0.52,"start_heard":1.26,"apart":0.74,"text":"Of David."},{"line":1,"start":5.001,"start_heard":4.32,"apart":0.681,"text":"I give You thanks with all my heart;"},{"line":3,"start":13.262,"start_heard":12.9,"apart":0.362,"text":"I bow down toward Your holy temple"},{"line":4,"start":16.983,"start_heard":17.919999999999998,"apart":0.937,"text":"and give thanks to Your name"},{"line":14,"start":58.85,"start_heard":59.5,"apart":0.65,"text":"Though the LORD is on high,"},{"line":21,"start":85.275,"start_heard":84.66000000000001,"apart":0.615,"text":"The LORD will fulfill"},{"line":22,"start":87.896,"start_heard":87.42,"apart":0.476,"text":"His purpose for me."},{"line":23,"start":89.836,"start_heard":90.52000000000001,"apart":0.684,"text":"O LORD, Your loving devotion endures forever—"},{"line":24,"start":95.057,"start_heard":95.54,"apart":0.483,"text":"do not abandon the works of Your hands."}]},"bsb_PSA_139":{"chapter":139,"lines":58,"match_rate":0.863,"confidence":0.159,"words_written":394,"words_heard":402,"words_matched":340,"starts":[5.081,9.941,12.462,14.482,16.862,19.103,21.623,24.023,28.324,30.664,33.185,35.665,38.145,39.505,42.426,45.746,51.247,55.848,59.768,61.508,63.729,66.809,69.149,74.17,77.971,79.911,81.991,86.592,89.092,91.232,93.553,95.893,97.873,100.474,102.794,104.394,107.015,110.475,113.055,113.976,117.216,119.756,122.437,125.477,128.277,130.398,132.298,135.258,138.179,141.439,145.36,149.76,153.661,157.701,160.062,162.982,165.883,168.823],"starts_heard":[4.9,9.22,12.200000000000001,14,17.16,19.36,21.66,24.06,28.5,31.119999999999997,33.16,35.82,38.24,40.26,43.26,46.78,51.1,55.18,59.98,63,64.62,66.7,69.26,71.58000000000001,74.48,77.22,81.82000000000001,86.36,89.30000000000001,91.32000000000001,95.5,96.12,98.62,100.7,102.62,104.96000000000001,107.2,110.78,113.32000000000001,114.62,117.26,121.12,124.42,125.60000000000001,128.28,130.18,133.04,135.5,null,141.34,145.02,150.8,153,156.98000000000002,159.72,163.20000000000002,165.88,169.42000000000002],"flagged":[{"line":1,"start":9.941,"start_heard":9.22,"apart":0.721,"text":"O LORD, You have searched me"},{"line":3,"start":14.482,"start_heard":14,"apart":0.482,"text":"You know when I sit and when I rise;"},{"line":9,"start":30.664,"start_heard":31.119999999999997,"apart":0.456,"text":"You hem me in behind and before;"},{"line":13,"start":39.505,"start_heard":40.26,"apart":0.755,"text":"Where can I go to escape Your Spirit?"},{"line":14,"start":42.426,"start_heard":43.26,"apart":0.834,"text":"Where can I flee from Your presence?"},{"line":15,"start":45.746,"start_heard":46.78,"apart":1.034,"text":"If I ascend to the heavens, You are there;"},{"line":17,"start":55.848,"start_heard":55.18,"apart":0.668,"text":"If I rise on the wings of the dawn,"},{"line":19,"start":61.508,"start_heard":63,"apart":1.492,"text":"even there Your hand will guide me;"},{"line":20,"start":63.729,"start_heard":64.62,"apart":0.891,"text":"Your right hand will hold me fast."},{"line":23,"start":74.17,"start_heard":71.58000000000001,"apart":2.59,"text":"even the darkness is not dark to You,"},{"line":24,"start":77.971,"start_heard":74.48,"apart":3.491,"text":"but the night shines like the day,"},{"line":25,"start":79.911,"start_heard":77.22,"apart":2.691,"text":"for darkness is as light to You."},{"line":30,"start":93.553,"start_heard":95.5,"apart":1.947,"text":"Marvelous are Your works,"},{"line":32,"start":97.873,"start_heard":98.62,"apart":0.747,"text":"My frame was not hidden from You"},{"line":35,"start":104.394,"start_heard":104.96000000000001,"apart":0.566,"text":"in the depths of the earth."},{"line":37,"start":110.475,"start_heard":110.78,"apart":0.305,"text":"all my days were written in Your book"},{"line":39,"start":113.976,"start_heard":114.62,"apart":0.644,"text":"before one of them came to be."},{"line":41,"start":119.756,"start_heard":121.12,"apart":1.364,"text":"how vast is their sum!"},{"line":42,"start":122.437,"start_heard":124.42,"apart":1.983,"text":"If I were to count them,"},{"line":46,"start":132.298,"start_heard":133.04,"apart":0.742,"text":"O God, that You would slay the wicked—"},{"line":48,"start":138.179,"start_heard":null,"apart":null,"text":"who speak of You deceitfully;"},{"line":50,"start":145.36,"start_heard":145.02,"apart":0.34,"text":"Do I not hate those who hate You, O LORD,"},{"line":51,"start":149.76,"start_heard":150.8,"apart":1.04,"text":"and detest those who rise against You?"},{"line":52,"start":153.661,"start_heard":153,"apart":0.661,"text":"I hate them with perfect hatred;"},{"line":53,"start":157.701,"start_heard":156.98000000000002,"apart":0.721,"text":"I count them as my enemies."},{"line":54,"start":160.062,"start_heard":159.72,"apart":0.342,"text":"Search me, O God, and know my heart;"},{"line":57,"start":168.823,"start_heard":169.42000000000002,"apart":0.597,"text":"lead me in the way everlasting."}]},"bsb_PSA_140":{"chapter":140,"lines":35,"match_rate":0.885,"confidence":0.383,"words_written":235,"words_heard":239,"words_matched":208,"starts":[2.58,7.181,11.202,15.543,17.663,20.124,24.665,28.805,29.606,31.486,33.766,36.027,38.567,40.828,45.028,47.149,47.969,53.55,56.271,59.871,63.792,69.873,73.834,78.555,79.355,81.855,85.036,87.717,90.837,95.158,102.539,105.84,110.001,112.741,118.322],"starts_heard":[2.32,8.16,11.48,15.780000000000001,17.84,20.4,24.939999999999998,null,29.939999999999998,31.939999999999998,34.28,36.96,38.96,41.22,45.4,null,49.059999999999995,54.42,56.62,59.5,65.04,68.7,74.36,null,79.72,82.10000000000001,85.38000000000001,88.06,91.08000000000001,101.58000000000001,104.12,106.18,110.28,112.98,118.7],"flagged":[{"line":1,"start":7.181,"start_heard":8.16,"apart":0.979,"text":"Rescue me, O LORD, from evil men."},{"line":7,"start":28.805,"start_heard":null,"apart":null,"text":"Selah"},{"line":8,"start":29.606,"start_heard":29.939999999999998,"apart":0.334,"text":"Guard me, O LORD,"},{"line":9,"start":31.486,"start_heard":31.939999999999998,"apart":0.454,"text":"from the hands of the wicked."},{"line":10,"start":33.766,"start_heard":34.28,"apart":0.514,"text":"Keep me safe from men of violence"},{"line":11,"start":36.027,"start_heard":36.96,"apart":0.933,"text":"who scheme to make me stumble."},{"line":12,"start":38.567,"start_heard":38.96,"apart":0.393,"text":"The proud hide a snare for me;"},{"line":13,"start":40.828,"start_heard":41.22,"apart":0.392,"text":"the cords of their net are spread along the path,"},{"line":14,"start":45.028,"start_heard":45.4,"apart":0.372,"text":"and lures are set out for me."},{"line":15,"start":47.149,"start_heard":null,"apart":null,"text":"Selah"},{"line":16,"start":47.969,"start_heard":49.059999999999995,"apart":1.091,"text":"I say to the LORD, “You are my God.”"},{"line":17,"start":53.55,"start_heard":54.42,"apart":0.87,"text":"Hear, O LORD, my cry for help."},{"line":18,"start":56.271,"start_heard":56.62,"apart":0.349,"text":"O GOD the Lord, the strength of my salvation,"},{"line":19,"start":59.871,"start_heard":59.5,"apart":0.371,"text":"You shield my head in the day of battle."},{"line":20,"start":63.792,"start_heard":65.04,"apart":1.248,"text":"Grant not, O LORD, the desires of the wicked;"},{"line":21,"start":69.873,"start_heard":68.7,"apart":1.173,"text":"do not promote their evil plans,"},{"line":22,"start":73.834,"start_heard":74.36,"apart":0.526,"text":"lest they be exalted."},{"line":23,"start":78.555,"start_heard":null,"apart":null,"text":"Selah"},{"line":24,"start":79.355,"start_heard":79.72,"apart":0.365,"text":"May the heads of those who surround me"},{"line":26,"start":85.036,"start_heard":85.38000000000001,"apart":0.344,"text":"May burning coals fall on them;"},{"line":27,"start":87.717,"start_heard":88.06,"apart":0.343,"text":"may they be thrown into the fire,"},{"line":29,"start":95.158,"start_heard":101.58000000000001,"apart":6.422,"text":"May no slanderer be established in the land;"},{"line":30,"start":102.539,"start_heard":104.12,"apart":1.581,"text":"may calamity hunt down the man of violence."},{"line":31,"start":105.84,"start_heard":106.18,"apart":0.34,"text":"I know that the LORD upholds justice for the poor"},{"line":34,"start":118.322,"start_heard":118.7,"apart":0.378,"text":"the upright will dwell in Your presence."}]},"bsb_PSA_141":{"chapter":141,"lines":28,"match_rate":0.93,"confidence":0.223,"words_written":213,"words_heard":213,"words_matched":198,"starts":[2.921,6.621,14.183,17.443,21.124,25.485,29.426,32.446,37.307,41.068,43.088,47.209,50.79,53.97,58.511,62.432,66.353,70.054,73.374,76.955,82.516,85.997,87.817,89.557,93.598,98.019,103.76,108.341],"starts_heard":[3.38,5.180000000000001,14.5,17.7,21.459999999999997,25.06,29.779999999999998,32.64,38.48,41.18,44.16,48.08,50.36,54.54,58.82,63.08,66.74000000000001,70.38000000000001,73.16000000000001,77.2,82.9,86.06,87.82000000000001,90.22,93.88000000000001,96.96000000000001,103.96000000000001,108.28],"flagged":[{"line":0,"start":2.921,"start_heard":3.38,"apart":0.459,"text":"A Psalm of David."},{"line":1,"start":6.621,"start_heard":5.180000000000001,"apart":1.441,"text":"I call upon You, O LORD; come quickly to me."},{"line":2,"start":14.183,"start_heard":14.5,"apart":0.317,"text":"Hear my voice when I call to You."},{"line":4,"start":21.124,"start_heard":21.459999999999997,"apart":0.336,"text":"my uplifted hands, like the evening offering."},{"line":5,"start":25.485,"start_heard":25.06,"apart":0.425,"text":"Set a guard, O LORD, over my mouth;"},{"line":6,"start":29.426,"start_heard":29.779999999999998,"apart":0.354,"text":"keep watch at the door of my lips."},{"line":8,"start":37.307,"start_heard":38.48,"apart":1.173,"text":"or take part in works of wickedness"},{"line":10,"start":43.088,"start_heard":44.16,"apart":1.072,"text":"let me not feast on their delicacies."},{"line":11,"start":47.209,"start_heard":48.08,"apart":0.871,"text":"Let the righteous man strike me;"},{"line":12,"start":50.79,"start_heard":50.36,"apart":0.43,"text":"let his rebuke be an act of loving devotion."},{"line":13,"start":53.97,"start_heard":54.54,"apart":0.57,"text":"It is oil for my head; let me not refuse it."},{"line":14,"start":58.511,"start_heard":58.82,"apart":0.309,"text":"For my prayer is ever against the deeds of the wicked."},{"line":15,"start":62.432,"start_heard":63.08,"apart":0.648,"text":"When their rulers are thrown down from the cliffs,"},{"line":16,"start":66.353,"start_heard":66.74000000000001,"apart":0.387,"text":"the people will listen to my words,"},{"line":17,"start":70.054,"start_heard":70.38000000000001,"apart":0.326,"text":"for they are pleasant."},{"line":20,"start":82.516,"start_heard":82.9,"apart":0.384,"text":"But my eyes are fixed on You,"},{"line":23,"start":89.557,"start_heard":90.22,"apart":0.663,"text":"do not leave my soul defenseless."},{"line":25,"start":98.019,"start_heard":96.96000000000001,"apart":1.059,"text":"and from the lures of evildoers."}]},"bsb_PSA_142":{"chapter":142,"lines":23,"match_rate":0.946,"confidence":0.39,"words_written":149,"words_heard":150,"words_matched":141,"starts":[2.32,10.021,13.821,18.201,22.161,25.562,28.762,32.342,35.342,39.322,42.383,45.943,48.343,53.723,59.164,64.244,66.664,71.324,73.945,78.385,80.985,86.965,90.046],"starts_heard":[3.44,10.18,13.44,17.299999999999997,21.86,25.459999999999997,28.849999999999998,31.889999999999997,34.949999999999996,38.57,41.79,45.85,48.17,53.89,59.85,64.01,66.79,70.95,74.75,77.97,80.83000000000001,86.83000000000001,90.13000000000001],"flagged":[{"line":0,"start":2.32,"start_heard":3.44,"apart":1.12,"text":"A Maskil of David, when he was in the cave. A prayer."},{"line":2,"start":13.821,"start_heard":13.44,"apart":0.381,"text":"I lift my voice to the LORD for mercy."},{"line":3,"start":18.201,"start_heard":17.299999999999997,"apart":0.901,"text":"I pour out my complaint before Him;"},{"line":4,"start":22.161,"start_heard":21.86,"apart":0.301,"text":"I reveal my trouble to Him."},{"line":7,"start":32.342,"start_heard":31.889999999999997,"apart":0.452,"text":"Along the path I travel"},{"line":8,"start":35.342,"start_heard":34.949999999999996,"apart":0.392,"text":"they have hidden a snare for me."},{"line":9,"start":39.322,"start_heard":38.57,"apart":0.752,"text":"Look to my right and see;"},{"line":10,"start":42.383,"start_heard":41.79,"apart":0.593,"text":"no one attends to me."},{"line":14,"start":59.164,"start_heard":59.85,"apart":0.686,"text":"my portion in the land of the living.”"},{"line":17,"start":71.324,"start_heard":70.95,"apart":0.374,"text":"Rescue me from my pursuers,"},{"line":18,"start":73.945,"start_heard":74.75,"apart":0.805,"text":"for they are too strong for me."},{"line":19,"start":78.385,"start_heard":77.97,"apart":0.415,"text":"Free my soul from prison,"}]},"bsb_PSA_146":{"chapter":146,"lines":25,"match_rate":0.918,"confidence":0.208,"words_written":159,"words_heard":165,"words_matched":146,"starts":[3.24,6.941,12.021,17.082,24.343,26.563,30.943,37.904,44.645,49.585,52.186,55.386,58.386,61.587,65.507,68.427,71.648,77.688,83.909,89.01,93.81,109.832,120.573,129.534,133.834],"starts_heard":[5.74,6.7,12.26,15.860000000000001,24.84,27.06,29.959999999999997,37.58,44.3,48.96,52.24,55.92,58.68,61.199999999999996,65.48,68.48,74.26,78.64,81.86,84.32000000000001,88.32000000000001,92.86,95.92,99.06,111.10000000000001],"flagged":[{"line":0,"start":3.24,"start_heard":5.74,"apart":2.5,"text":"Hallelujah!"},{"line":3,"start":17.082,"start_heard":15.860000000000001,"apart":1.222,"text":"I will sing praises to my God while I have my being."},{"line":4,"start":24.343,"start_heard":24.84,"apart":0.497,"text":"Put not your trust in princes,"},{"line":5,"start":26.563,"start_heard":27.06,"apart":0.497,"text":"in mortal man, who cannot save."},{"line":6,"start":30.943,"start_heard":29.959999999999997,"apart":0.983,"text":"When his spirit departs, he returns to the ground;"},{"line":7,"start":37.904,"start_heard":37.58,"apart":0.324,"text":"on that very day his plans perish."},{"line":8,"start":44.645,"start_heard":44.3,"apart":0.345,"text":"Blessed is he whose help is the God of Jacob,"},{"line":9,"start":49.585,"start_heard":48.96,"apart":0.625,"text":"whose hope is in the LORD his God,"},{"line":11,"start":55.386,"start_heard":55.92,"apart":0.534,"text":"the sea, and everything in them."},{"line":13,"start":61.587,"start_heard":61.199999999999996,"apart":0.387,"text":"He executes justice for the oppressed"},{"line":16,"start":71.648,"start_heard":74.26,"apart":2.612,"text":"the LORD opens the eyes of the blind,"},{"line":17,"start":77.688,"start_heard":78.64,"apart":0.952,"text":"the LORD lifts those who are weighed down,"},{"line":18,"start":83.909,"start_heard":81.86,"apart":2.049,"text":"the LORD loves the righteous."},{"line":19,"start":89.01,"start_heard":84.32000000000001,"apart":4.69,"text":"The LORD protects foreigners;"},{"line":20,"start":93.81,"start_heard":88.32000000000001,"apart":5.49,"text":"He sustains the fatherless and the widow,"},{"line":21,"start":109.832,"start_heard":92.86,"apart":16.972,"text":"but the ways of the wicked He frustrates."},{"line":22,"start":120.573,"start_heard":95.92,"apart":24.653,"text":"The LORD reigns forever,"},{"line":23,"start":129.534,"start_heard":99.06,"apart":30.474,"text":"your God, O Zion, for all generations."},{"line":24,"start":133.834,"start_heard":111.10000000000001,"apart":22.734,"text":"Hallelujah!"}]},"bsb_PSA_148":{"chapter":148,"lines":32,"match_rate":0.974,"confidence":0.367,"words_written":190,"words_heard":189,"words_matched":185,"starts":[1.78,3.701,6.721,10.862,15.242,19.643,23.784,28.444,32.445,37.006,41.166,46.087,49.427,63.129,66.15,71.651,76.051,80.192,83.453,86.193,89.493,97.995,102.155,106.796,108.796,116.097,120.218,124.519,131.38,138.341,142.801,150.903],"starts_heard":[1.8399999999999999,3.86,6.96,11.3,15.040000000000001,19.4,23.56,28.139999999999997,32.519999999999996,36.96,40.86,46.48,50.3,62.76,66.5,71.38000000000001,76.34,80.78,83.62,86.08000000000001,89.68,97.78,102.46000000000001,106.92,109.28,115.52000000000001,120.34,125.22,132.76000000000002,138.02,142.76000000000002,150.66],"flagged":[{"line":3,"start":10.862,"start_heard":11.3,"apart":0.438,"text":"Praise Him, all His angels;"},{"line":7,"start":28.444,"start_heard":28.139999999999997,"apart":0.304,"text":"Praise Him, O highest heavens,"},{"line":10,"start":41.166,"start_heard":40.86,"apart":0.306,"text":"for He gave the command and they were created."},{"line":11,"start":46.087,"start_heard":46.48,"apart":0.393,"text":"He established them forever and ever;"},{"line":12,"start":49.427,"start_heard":50.3,"apart":0.873,"text":"He issued a decree that will never pass away."},{"line":13,"start":63.129,"start_heard":62.76,"apart":0.369,"text":"Praise the LORD from the earth,"},{"line":14,"start":66.15,"start_heard":66.5,"apart":0.35,"text":"all great sea creatures and ocean depths,"},{"line":17,"start":80.192,"start_heard":80.78,"apart":0.588,"text":"mountains and all hills,"},{"line":22,"start":102.155,"start_heard":102.46000000000001,"apart":0.305,"text":"princes and all rulers of the earth,"},{"line":24,"start":108.796,"start_heard":109.28,"apart":0.484,"text":"old and young together."},{"line":25,"start":116.097,"start_heard":115.52000000000001,"apart":0.577,"text":"Let them praise the name of the LORD,"},{"line":27,"start":124.519,"start_heard":125.22,"apart":0.701,"text":"His splendor is above the earth and the heavens."},{"line":28,"start":131.38,"start_heard":132.76000000000002,"apart":1.38,"text":"He has raised up a horn for His people,"},{"line":29,"start":138.341,"start_heard":138.02,"apart":0.321,"text":"the praise of all His saints,"}]},"bsb_PSA_149":{"chapter":149,"lines":20,"match_rate":0.97,"confidence":0.333,"words_written":132,"words_heard":147,"words_matched":128,"starts":[0.56,12.882,15.942,21.403,24.564,32.225,37.625,42.546,45.907,53.528,58.888,66.87,73.911,79.371,83.272,88.553,92.433,97.854,104.495,109.456],"starts_heard":[0.4,12.94,15.200000000000001,20.52,24.439999999999998,30.82,36.22,42.199999999999996,45.66,53.04,57.6,66.14,73.92,79.48,83.02000000000001,88.02000000000001,93.02000000000001,97.72,104.02000000000001,109.16000000000001],"flagged":[{"line":2,"start":15.942,"start_heard":15.200000000000001,"apart":0.742,"text":"His praise in the assembly of the godly."},{"line":3,"start":21.403,"start_heard":20.52,"apart":0.883,"text":"Let Israel rejoice in their Maker;"},{"line":5,"start":32.225,"start_heard":30.82,"apart":1.405,"text":"Let them praise His name with dancing,"},{"line":6,"start":37.625,"start_heard":36.22,"apart":1.405,"text":"and make music to Him with tambourine and harp."},{"line":7,"start":42.546,"start_heard":42.199999999999996,"apart":0.346,"text":"For the LORD takes pleasure in His people;"},{"line":9,"start":53.528,"start_heard":53.04,"apart":0.488,"text":"Let the saints exult in glory;"},{"line":10,"start":58.888,"start_heard":57.6,"apart":1.288,"text":"let them shout for joy upon their beds."},{"line":11,"start":66.87,"start_heard":66.14,"apart":0.73,"text":"May the high praises of God be in their mouths,"},{"line":15,"start":88.553,"start_heard":88.02000000000001,"apart":0.533,"text":"to bind their kings with chains"},{"line":16,"start":92.433,"start_heard":93.02000000000001,"apart":0.587,"text":"and their nobles with shackles of iron,"},{"line":18,"start":104.495,"start_heard":104.02000000000001,"apart":0.475,"text":"This honor is for all His saints."}]}}