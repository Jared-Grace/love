{"bsb_PSA_120":{"chapter":120,"lines":16,"match_rate":0.794,"confidence":0.304,"words_written":97,"words_heard":99,"words_matched":77,"starts":[6.621,9.602,15.623,18.123,24.464,32.545,38.486,43.767,45.347,48.488,51.568,54.729,57.849,59.79,62.57,68.571],"starts_heard":[7.08,8.620000000000001,15.56,17.979999999999997,23.34,29.86,36.16,45.18,45.6,48.18,52.16,54.58,57.64,59.86,63.1,69.12],"flagged":[{"line":0,"start":6.621,"start_heard":7.08,"apart":0.459,"text":"A song of ascents."},{"line":1,"start":9.602,"start_heard":8.620000000000001,"apart":0.982,"text":"In my distress I cried to the LORD,"},{"line":4,"start":24.464,"start_heard":23.34,"apart":1.124,"text":"from lying lips and a deceitful tongue."},{"line":5,"start":32.545,"start_heard":29.86,"apart":2.685,"text":"What will He do to you,"},{"line":6,"start":38.486,"start_heard":36.16,"apart":2.326,"text":"and what will be added to you,"},{"line":7,"start":43.767,"start_heard":45.18,"apart":1.413,"text":"O deceitful tongue?"},{"line":9,"start":48.488,"start_heard":48.18,"apart":0.308,"text":"with burning coals of the broom tree!"},{"line":10,"start":51.568,"start_heard":52.16,"apart":0.592,"text":"Woe to me that I dwell in Meshech,"},{"line":14,"start":62.57,"start_heard":63.1,"apart":0.53,"text":"I am in favor of peace;"},{"line":15,"start":68.571,"start_heard":69.12,"apart":0.549,"text":"but when I speak, they want war."}]},"bsb_PSA_121":{"chapter":121,"lines":17,"match_rate":0.934,"confidence":0.327,"words_written":106,"words_heard":105,"words_matched":99,"starts":[0.16,5.641,8.842,11.843,15.684,21.105,24.786,31.168,37.369,43.571,46.131,49.152,52.473,55.994,62.515,68.037,74.158],"starts_heard":[1.8399999999999999,4.760000000000001,9.06,12.06,15.120000000000001,20.84,24.419999999999998,31.16,35.92,43.08,46.44,51.16,52.72,55.98,61.82,68.28,75.02000000000001],"flagged":[{"line":0,"start":0.16,"start_heard":1.8399999999999999,"apart":1.68,"text":"A song of ascents."},{"line":1,"start":5.641,"start_heard":4.760000000000001,"apart":0.881,"text":"I lift up my eyes to the hills."},{"line":4,"start":15.684,"start_heard":15.120000000000001,"apart":0.564,"text":"the Maker of heaven and earth."},{"line":6,"start":24.786,"start_heard":24.419999999999998,"apart":0.366,"text":"your Protector will not slumber."},{"line":8,"start":37.369,"start_heard":35.92,"apart":1.449,"text":"will neither slumber nor sleep."},{"line":9,"start":43.571,"start_heard":43.08,"apart":0.491,"text":"The LORD is your keeper;"},{"line":10,"start":46.131,"start_heard":46.44,"apart":0.309,"text":"the LORD is the shade on your right hand."},{"line":11,"start":49.152,"start_heard":51.16,"apart":2.008,"text":"The sun will not strike you by day,"},{"line":14,"start":62.515,"start_heard":61.82,"apart":0.695,"text":"He will preserve your soul."},{"line":16,"start":74.158,"start_heard":75.02000000000001,"apart":0.862,"text":"both now and forevermore."}]},"bsb_PSA_122":{"chapter":122,"lines":21,"match_rate":0.888,"confidence":0.202,"words_written":134,"words_heard":126,"words_matched":119,"starts":[3.96,10.601,15.842,21.402,25.503,26.763,28.843,31.223,33.944,37.444,42.505,46.885,51.325,55.426,59.166,62.087,65.067,73.168,79.208,84.069,92.75],"starts_heard":[4.62,10.120000000000001,15.34,20.7,null,26.02,31.22,35.08,null,37.519999999999996,44.199999999999996,47.24,50.66,55.8,59.379999999999995,62.42,65.12,72.78,77.38000000000001,82.18,89.64],"flagged":[{"line":0,"start":3.96,"start_heard":4.62,"apart":0.66,"text":"A song of ascents. Of David."},{"line":1,"start":10.601,"start_heard":10.120000000000001,"apart":0.481,"text":"I was glad when they said to me,"},{"line":2,"start":15.842,"start_heard":15.34,"apart":0.502,"text":"“Let us go to the house of the LORD.”"},{"line":3,"start":21.402,"start_heard":20.7,"apart":0.702,"text":"Our feet are standing in your gates,"},{"line":4,"start":25.503,"start_heard":null,"apart":null,"text":"O Jerusalem."},{"line":5,"start":26.763,"start_heard":26.02,"apart":0.743,"text":"Jerusalem is built up"},{"line":6,"start":28.843,"start_heard":31.22,"apart":2.377,"text":"as a city united together,"},{"line":7,"start":31.223,"start_heard":35.08,"apart":3.857,"text":"where the tribes go up,"},{"line":8,"start":33.944,"start_heard":null,"apart":null,"text":"the tribes of the LORD,"},{"line":10,"start":42.505,"start_heard":44.199999999999996,"apart":1.695,"text":"to give thanks to the name of the LORD."},{"line":11,"start":46.885,"start_heard":47.24,"apart":0.355,"text":"For there the thrones of judgment stand,"},{"line":12,"start":51.325,"start_heard":50.66,"apart":0.665,"text":"the thrones of the house of David."},{"line":13,"start":55.426,"start_heard":55.8,"apart":0.374,"text":"Pray for the peace of Jerusalem:"},{"line":15,"start":62.087,"start_heard":62.42,"apart":0.333,"text":"May there be peace within your walls,"},{"line":17,"start":73.168,"start_heard":72.78,"apart":0.388,"text":"For the sake of my brothers and friends,"},{"line":18,"start":79.208,"start_heard":77.38000000000001,"apart":1.828,"text":"I will say, “Peace be within you.”"},{"line":19,"start":84.069,"start_heard":82.18,"apart":1.889,"text":"For the sake of the house of the LORD our God,"},{"line":20,"start":92.75,"start_heard":89.64,"apart":3.11,"text":"I will seek your prosperity."}]},"bsb_PSA_123":{"chapter":123,"lines":13,"match_rate":0.902,"confidence":0.21,"words_written":82,"words_heard":86,"words_matched":74,"starts":[2.36,6.341,11.502,20.544,24.545,29.766,33.827,40.728,46.989,50.71,59.592,68.433,74.895],"starts_heard":[2.86,6.12,11.360000000000001,19.799999999999997,24.439999999999998,29.54,33.699999999999996,40.58,46.54,50.3,59.019999999999996,67.60000000000001,80.7],"flagged":[{"line":0,"start":2.36,"start_heard":2.86,"apart":0.5,"text":"A song of ascents."},{"line":3,"start":20.544,"start_heard":19.799999999999997,"apart":0.744,"text":"As the eyes of servants"},{"line":8,"start":46.989,"start_heard":46.54,"apart":0.449,"text":"until He shows us mercy."},{"line":9,"start":50.71,"start_heard":50.3,"apart":0.41,"text":"Have mercy on us, O LORD, have mercy,"},{"line":10,"start":59.592,"start_heard":59.019999999999996,"apart":0.572,"text":"for we have endured much contempt."},{"line":11,"start":68.433,"start_heard":67.60000000000001,"apart":0.833,"text":"We have endured much scorn from the arrogant,"},{"line":12,"start":74.895,"start_heard":80.7,"apart":5.805,"text":"much contempt from the proud."}]},"bsb_PSA_124":{"chapter":124,"lines":17,"match_rate":0.975,"confidence":0.392,"words_written":118,"words_heard":125,"words_matched":115,"starts":[1.48,4.96,9.881,12.361,15.981,18.042,22.182,26.262,29.542,35.723,37.803,41.463,44.404,48.504,57.925,65.125,74.166],"starts_heard":[0.4,4.36,11.200000000000001,12.26,16.16,18,22.4,26.38,29.439999999999998,35.46,38.019999999999996,41.44,44.42,48.559999999999995,55.46,61.28,70.32000000000001],"flagged":[{"line":0,"start":1.48,"start_heard":0.4,"apart":1.08,"text":"A song of ascents. Of David."},{"line":1,"start":4.96,"start_heard":4.36,"apart":0.6,"text":"If the LORD had not been on our side—"},{"line":2,"start":9.881,"start_heard":11.200000000000001,"apart":1.319,"text":"let Israel now declare—"},{"line":14,"start":57.925,"start_heard":55.46,"apart":2.465,"text":"the net is torn, and we have slipped away."},{"line":15,"start":65.125,"start_heard":61.28,"apart":3.845,"text":"Our help is in the name of the LORD,"},{"line":16,"start":74.166,"start_heard":70.32000000000001,"apart":3.846,"text":"the Maker of heaven and earth."}]}}