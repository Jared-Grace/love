{"bsb_PSA_120":{"chapter":120,"lines":16,"match_rate":0.794,"confidence":0.304,"words_written":97,"words_heard":99,"words_matched":77,"starts":[6.621,9.602,15.623,18.123,24.464,32.545,38.486,43.767,45.347,48.488,51.568,54.729,57.849,59.79,62.57,68.571],"starts_heard":[7.08,8.620000000000001,15.56,17.979999999999997,23.34,29.86,36.16,45.18,45.6,48.18,52.16,54.58,57.64,59.86,63.1,69.12],"flagged":[{"line":0,"start":6.621,"start_heard":7.08,"apart":0.459,"text":"A song of ascents."},{"line":1,"start":9.602,"start_heard":8.620000000000001,"apart":0.982,"text":"In my distress I cried to the LORD,"},{"line":4,"start":24.464,"start_heard":23.34,"apart":1.124,"text":"from lying lips and a deceitful tongue."},{"line":5,"start":32.545,"start_heard":29.86,"apart":2.685,"text":"What will He do to you,"},{"line":6,"start":38.486,"start_heard":36.16,"apart":2.326,"text":"and what will be added to you,"},{"line":7,"start":43.767,"start_heard":45.18,"apart":1.413,"text":"O deceitful tongue?"},{"line":9,"start":48.488,"start_heard":48.18,"apart":0.308,"text":"with burning coals of the broom tree!"},{"line":10,"start":51.568,"start_heard":52.16,"apart":0.592,"text":"Woe to me that I dwell in Meshech,"},{"line":14,"start":62.57,"start_heard":63.1,"apart":0.53,"text":"I am in favor of peace;"},{"line":15,"start":68.571,"start_heard":69.12,"apart":0.549,"text":"but when I speak, they want war."}]},"bsb_PSA_121":{"chapter":121,"lines":17,"match_rate":0.934,"confidence":0.327,"words_written":106,"words_heard":105,"words_matched":99,"starts":[0.16,5.641,8.842,11.843,15.684,21.105,24.786,31.168,37.369,43.571,46.131,49.152,52.473,55.994,62.515,68.037,74.158],"starts_heard":[1.8399999999999999,4.760000000000001,9.06,12.06,15.120000000000001,20.84,24.419999999999998,31.16,35.92,43.08,46.44,51.16,52.72,55.98,61.82,68.28,75.02000000000001],"flagged":[{"line":0,"start":0.16,"start_heard":1.8399999999999999,"apart":1.68,"text":"A song of ascents."},{"line":1,"start":5.641,"start_heard":4.760000000000001,"apart":0.881,"text":"I lift up my eyes to the hills."},{"line":4,"start":15.684,"start_heard":15.120000000000001,"apart":0.564,"text":"the Maker of heaven and earth."},{"line":6,"start":24.786,"start_heard":24.419999999999998,"apart":0.366,"text":"your Protector will not slumber."},{"line":8,"start":37.369,"start_heard":35.92,"apart":1.449,"text":"will neither slumber nor sleep."},{"line":9,"start":43.571,"start_heard":43.08,"apart":0.491,"text":"The LORD is your keeper;"},{"line":10,"start":46.131,"start_heard":46.44,"apart":0.309,"text":"the LORD is the shade on your right hand."},{"line":11,"start":49.152,"start_heard":51.16,"apart":2.008,"text":"The sun will not strike you by day,"},{"line":14,"start":62.515,"start_heard":61.82,"apart":0.695,"text":"He will preserve your soul."},{"line":16,"start":74.158,"start_heard":75.02000000000001,"apart":0.862,"text":"both now and forevermore."}]},"bsb_PSA_122":{"chapter":122,"lines":21,"match_rate":0.888,"confidence":0.202,"words_written":134,"words_heard":126,"words_matched":119,"starts":[3.96,10.601,15.842,21.402,25.503,26.763,28.843,31.223,33.944,37.444,42.505,46.885,51.325,55.426,59.166,62.087,65.067,73.168,79.208,84.069,92.75],"starts_heard":[4.62,10.120000000000001,15.34,20.7,null,26.02,31.22,35.08,null,37.519999999999996,44.199999999999996,47.24,50.66,55.8,59.379999999999995,62.42,65.12,72.78,77.38000000000001,82.18,89.64],"flagged":[{"line":0,"start":3.96,"start_heard":4.62,"apart":0.66,"text":"A song of ascents. Of David."},{"line":1,"start":10.601,"start_heard":10.120000000000001,"apart":0.481,"text":"I was glad when they said to me,"},{"line":2,"start":15.842,"start_heard":15.34,"apart":0.502,"text":"“Let us go to the house of the LORD.”"},{"line":3,"start":21.402,"start_heard":20.7,"apart":0.702,"text":"Our feet are standing in your gates,"},{"line":4,"start":25.503,"start_heard":null,"apart":null,"text":"O Jerusalem."},{"line":5,"start":26.763,"start_heard":26.02,"apart":0.743,"text":"Jerusalem is built up"},{"line":6,"start":28.843,"start_heard":31.22,"apart":2.377,"text":"as a city united together,"},{"line":7,"start":31.223,"start_heard":35.08,"apart":3.857,"text":"where the tribes go up,"},{"line":8,"start":33.944,"start_heard":null,"apart":null,"text":"the tribes of the LORD,"},{"line":10,"start":42.505,"start_heard":44.199999999999996,"apart":1.695,"text":"to give thanks to the name of the LORD."},{"line":11,"start":46.885,"start_heard":47.24,"apart":0.355,"text":"For there the thrones of judgment stand,"},{"line":12,"start":51.325,"start_heard":50.66,"apart":0.665,"text":"the thrones of the house of David."},{"line":13,"start":55.426,"start_heard":55.8,"apart":0.374,"text":"Pray for the peace of Jerusalem:"},{"line":15,"start":62.087,"start_heard":62.42,"apart":0.333,"text":"May there be peace within your walls,"},{"line":17,"start":73.168,"start_heard":72.78,"apart":0.388,"text":"For the sake of my brothers and friends,"},{"line":18,"start":79.208,"start_heard":77.38000000000001,"apart":1.828,"text":"I will say, “Peace be within you.”"},{"line":19,"start":84.069,"start_heard":82.18,"apart":1.889,"text":"For the sake of the house of the LORD our God,"},{"line":20,"start":92.75,"start_heard":89.64,"apart":3.11,"text":"I will seek your prosperity."}]},"bsb_PSA_123":{"chapter":123,"lines":13,"match_rate":0.902,"confidence":0.21,"words_written":82,"words_heard":86,"words_matched":74,"starts":[2.36,6.341,11.502,20.544,24.545,29.766,33.827,40.728,46.989,50.71,59.592,68.433,74.895],"starts_heard":[2.86,6.12,11.360000000000001,19.799999999999997,24.439999999999998,29.54,33.699999999999996,40.58,46.54,50.3,59.019999999999996,67.60000000000001,80.7],"flagged":[{"line":0,"start":2.36,"start_heard":2.86,"apart":0.5,"text":"A song of ascents."},{"line":3,"start":20.544,"start_heard":19.799999999999997,"apart":0.744,"text":"As the eyes of servants"},{"line":8,"start":46.989,"start_heard":46.54,"apart":0.449,"text":"until He shows us mercy."},{"line":9,"start":50.71,"start_heard":50.3,"apart":0.41,"text":"Have mercy on us, O LORD, have mercy,"},{"line":10,"start":59.592,"start_heard":59.019999999999996,"apart":0.572,"text":"for we have endured much contempt."},{"line":11,"start":68.433,"start_heard":67.60000000000001,"apart":0.833,"text":"We have endured much scorn from the arrogant,"},{"line":12,"start":74.895,"start_heard":80.7,"apart":5.805,"text":"much contempt from the proud."}]},"bsb_PSA_124":{"chapter":124,"lines":17,"match_rate":0.975,"confidence":0.392,"words_written":118,"words_heard":125,"words_matched":115,"starts":[1.48,4.96,9.881,12.361,15.981,18.042,22.182,26.262,29.542,35.723,37.803,41.463,44.404,48.504,57.925,65.125,74.166],"starts_heard":[0.4,4.36,11.200000000000001,12.26,16.16,18,22.4,26.38,29.439999999999998,35.46,38.019999999999996,41.44,44.42,48.559999999999995,55.46,61.28,70.32000000000001],"flagged":[{"line":0,"start":1.48,"start_heard":0.4,"apart":1.08,"text":"A song of ascents. Of David."},{"line":1,"start":4.96,"start_heard":4.36,"apart":0.6,"text":"If the LORD had not been on our side—"},{"line":2,"start":9.881,"start_heard":11.200000000000001,"apart":1.319,"text":"let Israel now declare—"},{"line":14,"start":57.925,"start_heard":55.46,"apart":2.465,"text":"the net is torn, and we have slipped away."},{"line":15,"start":65.125,"start_heard":61.28,"apart":3.845,"text":"Our help is in the name of the LORD,"},{"line":16,"start":74.166,"start_heard":70.32000000000001,"apart":3.846,"text":"the Maker of heaven and earth."}]},"bsb_PSA_125":{"chapter":125,"lines":15,"match_rate":0.928,"confidence":0.285,"words_written":97,"words_heard":98,"words_matched":90,"starts":[1.28,4.741,11.063,17.405,23.346,28.647,33.469,37.65,43.251,48.133,53.134,58.995,64.137,67.598,74.479],"starts_heard":[0.4,4.54,10.22,16.639999999999997,23.479999999999997,28.08,33.14,37.96,42.879999999999995,48.379999999999995,54.92,60.839999999999996,64.4,67.94000000000001,74.48],"flagged":[{"line":0,"start":1.28,"start_heard":0.4,"apart":0.88,"text":"A song of ascents."},{"line":2,"start":11.063,"start_heard":10.22,"apart":0.843,"text":"It cannot be moved; it abides forever."},{"line":3,"start":17.405,"start_heard":16.639999999999997,"apart":0.765,"text":"As the mountains surround Jerusalem,"},{"line":5,"start":28.647,"start_heard":28.08,"apart":0.567,"text":"both now and forevermore."},{"line":6,"start":33.469,"start_heard":33.14,"apart":0.329,"text":"For the scepter of the wicked will not rest"},{"line":7,"start":37.65,"start_heard":37.96,"apart":0.31,"text":"upon the land allotted to the righteous,"},{"line":8,"start":43.251,"start_heard":42.879999999999995,"apart":0.371,"text":"so that the righteous will not put forth"},{"line":10,"start":53.134,"start_heard":54.92,"apart":1.786,"text":"Do good, O LORD, to those who are good,"},{"line":11,"start":58.995,"start_heard":60.839999999999996,"apart":1.845,"text":"and to the upright in heart."},{"line":13,"start":67.598,"start_heard":67.94000000000001,"apart":0.342,"text":"the LORD will banish with the evildoers."}]},"bsb_PSA_126":{"chapter":126,"lines":17,"match_rate":0.899,"confidence":0.187,"words_written":99,"words_heard":102,"words_matched":89,"starts":[3.961,7.581,14.142,17.863,23.703,27.704,33.425,38.365,42.886,47.147,52.387,57.248,59.328,62.609,65.889,70.39,77.191],"starts_heard":[4.46,7.66,14.3,18.119999999999997,23.419999999999998,27.939999999999998,33,38.68,43.26,47.48,54.519999999999996,57.62,59.4,62.9,66.26,70.74000000000001,null],"flagged":[{"line":0,"start":3.961,"start_heard":4.46,"apart":0.499,"text":"A song of ascents."},{"line":6,"start":33.425,"start_heard":33,"apart":0.425,"text":"“The LORD has done great things for them.”"},{"line":7,"start":38.365,"start_heard":38.68,"apart":0.315,"text":"The LORD has done great things for us;"},{"line":8,"start":42.886,"start_heard":43.26,"apart":0.374,"text":"we are filled with joy."},{"line":9,"start":47.147,"start_heard":47.48,"apart":0.333,"text":"Restore our captives, O LORD,"},{"line":10,"start":52.387,"start_heard":54.519999999999996,"apart":2.133,"text":"like streams in the Negev."},{"line":11,"start":57.248,"start_heard":57.62,"apart":0.372,"text":"Those who sow in tears"},{"line":14,"start":65.889,"start_heard":66.26,"apart":0.371,"text":"bearing a trail of seed,"},{"line":15,"start":70.39,"start_heard":70.74000000000001,"apart":0.35,"text":"will surely return with shouts of joy,"},{"line":16,"start":77.191,"start_heard":null,"apart":null,"text":"carrying sheaves of grain."}]},"bsb_PSA_127":{"chapter":127,"lines":17,"match_rate":0.972,"confidence":0.228,"words_written":107,"words_heard":109,"words_matched":104,"starts":[0.96,8.421,11.262,15.042,21.023,27.084,30.045,33.305,37.826,41.566,49.087,54.928,61.809,67.83,70.071,73.551,76.091],"starts_heard":[0.4,7.4,11.620000000000001,14.34,20.4,26.24,29.68,34.339999999999996,37.839999999999996,42.78,49.14,54.98,62.1,67.80000000000001,69.96000000000001,73.06,76.34],"flagged":[{"line":0,"start":0.96,"start_heard":0.4,"apart":0.56,"text":"A song of ascents. Of Solomon."},{"line":1,"start":8.421,"start_heard":7.4,"apart":1.021,"text":"Unless the LORD builds the house,"},{"line":2,"start":11.262,"start_heard":11.620000000000001,"apart":0.358,"text":"its builders labor in vain;"},{"line":3,"start":15.042,"start_heard":14.34,"apart":0.702,"text":"unless the LORD protects the city,"},{"line":4,"start":21.023,"start_heard":20.4,"apart":0.623,"text":"its watchmen stand guard in vain."},{"line":5,"start":27.084,"start_heard":26.24,"apart":0.844,"text":"In vain you rise early"},{"line":6,"start":30.045,"start_heard":29.68,"apart":0.365,"text":"and stay up late,"},{"line":7,"start":33.305,"start_heard":34.339999999999996,"apart":1.035,"text":"toiling for bread to eat—"},{"line":9,"start":41.566,"start_heard":42.78,"apart":1.214,"text":"Children are indeed a heritage from the LORD,"},{"line":15,"start":73.551,"start_heard":73.06,"apart":0.491,"text":"He will not be put to shame"}]},"bsb_PSA_128":{"chapter":128,"lines":17,"match_rate":0.939,"confidence":0.339,"words_written":98,"words_heard":102,"words_matched":92,"starts":[4.321,7.502,12.263,14.783,21.505,25.085,29.486,32.267,34.808,37.828,42.049,44.83,48.791,54.212,56.792,58.073,60.533],"starts_heard":[3.92,7.640000000000001,12.42,14.38,21.979999999999997,25.5,29.7,32.64,35.12,37.86,42.24,45.22,49.14,53.16,57.019999999999996,58.14,60.8],"flagged":[{"line":0,"start":4.321,"start_heard":3.92,"apart":0.401,"text":"A song of ascents."},{"line":3,"start":14.783,"start_heard":14.38,"apart":0.403,"text":"For when you eat the fruit of your labor,"},{"line":4,"start":21.505,"start_heard":21.979999999999997,"apart":0.475,"text":"blessings and prosperity will be yours."},{"line":5,"start":25.085,"start_heard":25.5,"apart":0.415,"text":"Your wife will be like a fruitful vine"},{"line":7,"start":32.267,"start_heard":32.64,"apart":0.373,"text":"your sons like olive shoots"},{"line":8,"start":34.808,"start_heard":35.12,"apart":0.312,"text":"sitting around your table."},{"line":11,"start":44.83,"start_heard":45.22,"apart":0.39,"text":"May the LORD bless you from Zion,"},{"line":12,"start":48.791,"start_heard":49.14,"apart":0.349,"text":"that you may see the prosperity of Jerusalem"},{"line":13,"start":54.212,"start_heard":53.16,"apart":1.052,"text":"all the days of your life,"}]},"bsb_PSA_129":{"chapter":129,"lines":18,"match_rate":0.928,"confidence":0.288,"words_written":125,"words_heard":133,"words_matched":116,"starts":[5.34,8.981,15.461,17.861,23.002,29.682,33.042,36.362,42.663,49.323,53.404,58.784,62.284,66.105,71.385,74.145,81.186,88.546],"starts_heard":[5,8.620000000000001,15.32,17.32,23.099999999999998,28.88,33.18,36.379999999999995,42.04,48.519999999999996,55.559999999999995,59.1,63.1,66.98,71.06,74.48,81.48,89.78],"flagged":[{"line":0,"start":5.34,"start_heard":5,"apart":0.34,"text":"A song of ascents."},{"line":1,"start":8.981,"start_heard":8.620000000000001,"apart":0.361,"text":"Many a time they have persecuted me from my youth—"},{"line":3,"start":17.861,"start_heard":17.32,"apart":0.541,"text":"many a time they have persecuted me from my youth,"},{"line":5,"start":29.682,"start_heard":28.88,"apart":0.802,"text":"The plowmen plowed over my back;"},{"line":8,"start":42.663,"start_heard":42.04,"apart":0.623,"text":"He has cut me from the cords of the wicked."},{"line":9,"start":49.323,"start_heard":48.519999999999996,"apart":0.803,"text":"May all who hate Zion"},{"line":10,"start":53.404,"start_heard":55.559999999999995,"apart":2.156,"text":"be turned back in shame."},{"line":11,"start":58.784,"start_heard":59.1,"apart":0.316,"text":"May they be like grass on the rooftops,"},{"line":12,"start":62.284,"start_heard":63.1,"apart":0.816,"text":"which withers before it can grow,"},{"line":13,"start":66.105,"start_heard":66.98,"apart":0.875,"text":"unable to fill the hands of the reaper,"},{"line":14,"start":71.385,"start_heard":71.06,"apart":0.325,"text":"or the arms of the binder of sheaves."},{"line":15,"start":74.145,"start_heard":74.48,"apart":0.335,"text":"May none who pass by say to them,"},{"line":17,"start":88.546,"start_heard":89.78,"apart":1.234,"text":"we bless you in the name of the LORD.”"}]},"bsb_PSA_130":{"chapter":130,"lines":19,"match_rate":0.861,"confidence":0.208,"words_written":122,"words_heard":129,"words_matched":105,"starts":[0.42,6.301,7.541,11.581,15.422,22.743,29.004,32.204,35.344,39.625,46.846,52.206,54.627,60.227,65.848,72.989,76.869,80.91,91.371],"starts_heard":[4.08,6.260000000000001,7.66,12.08,15.56,22.9,28.52,32.64,35.62,39.28,46.5,52.54,56.62,60.08,67.2,70.24000000000001,73.94000000000001,81.78,86.42],"flagged":[{"line":0,"start":0.42,"start_heard":4.08,"apart":3.66,"text":"A song of ascents."},{"line":3,"start":11.581,"start_heard":12.08,"apart":0.499,"text":"O Lord, hear my voice;"},{"line":6,"start":29.004,"start_heard":28.52,"apart":0.484,"text":"then who, O Lord, could stand?"},{"line":7,"start":32.204,"start_heard":32.64,"apart":0.436,"text":"But with You there is forgiveness,"},{"line":9,"start":39.625,"start_heard":39.28,"apart":0.345,"text":"I wait for the LORD; my soul does wait,"},{"line":10,"start":46.846,"start_heard":46.5,"apart":0.346,"text":"and in His word I put my hope."},{"line":11,"start":52.206,"start_heard":52.54,"apart":0.334,"text":"My soul waits for the Lord"},{"line":12,"start":54.627,"start_heard":56.62,"apart":1.993,"text":"more than watchmen wait for the morning—"},{"line":14,"start":65.848,"start_heard":67.2,"apart":1.352,"text":"O Israel, put your hope in the LORD,"},{"line":15,"start":72.989,"start_heard":70.24000000000001,"apart":2.749,"text":"for with the LORD is loving devotion,"},{"line":16,"start":76.869,"start_heard":73.94000000000001,"apart":2.929,"text":"and with Him is redemption in abundance."},{"line":17,"start":80.91,"start_heard":81.78,"apart":0.87,"text":"And He will redeem Israel"},{"line":18,"start":91.371,"start_heard":86.42,"apart":4.951,"text":"from all iniquity."}]},"bsb_PSA_131":{"chapter":131,"lines":10,"match_rate":0.881,"confidence":0.353,"words_written":67,"words_heard":78,"words_matched":59,"starts":[9.121,18.221,22.901,27.662,32.202,35.902,46.283,55.524,65.924,128.228],"starts_heard":[0.4,17.36,22.779999999999998,26.459999999999997,32.18,35.54,46.16,55.62,65.18,128.02],"flagged":[{"line":0,"start":9.121,"start_heard":0.4,"apart":8.721,"text":"A song of ascents. Of David."},{"line":1,"start":18.221,"start_heard":17.36,"apart":0.861,"text":"My heart is not proud, O LORD,"},{"line":3,"start":27.662,"start_heard":26.459999999999997,"apart":1.202,"text":"I do not aspire to great things"},{"line":5,"start":35.902,"start_heard":35.54,"apart":0.362,"text":"Surely I have stilled and quieted my soul;"},{"line":8,"start":65.924,"start_heard":65.18,"apart":0.744,"text":"O Israel, put your hope in the LORD,"}]},"bsb_PSA_132":{"chapter":132,"lines":41,"match_rate":0.915,"confidence":0.177,"words_written":281,"words_heard":280,"words_matched":257,"starts":[0.18,6.081,11.701,13.761,15.922,19.602,22.982,24.842,28.423,30.603,33.643,37.744,41.924,45.324,48.945,54.485,58.886,62.246,66.046,69.847,73.947,78.067,82.668,86.928,88.688,91.009,92.649,95.129,97.509,98.969,101.45,104.81,108.95,112.471,116.631,120.771,124.012,127.032,134.233,137.313,140.813],"starts_heard":[2.94,6.66,11.72,13.700000000000001,15.860000000000001,20.419999999999998,22.88,24.84,28.32,30.779999999999998,33.24,37.839999999999996,41.699999999999996,45.58,49,55.64,58.3,62,66.22,69.76,74.10000000000001,78.06,82.38000000000001,86.62,89.02000000000001,91.46000000000001,93.58000000000001,95.38000000000001,97.84,99.52000000000001,101.46000000000001,104.36,108.64,112.32000000000001,116.36,119.96000000000001,124.26,130.08,133.8,137.62,140.82],"flagged":[{"line":0,"start":0.18,"start_heard":2.94,"apart":2.76,"text":"A song of ascents."},{"line":1,"start":6.081,"start_heard":6.66,"apart":0.579,"text":"O LORD, remember on behalf of David"},{"line":5,"start":19.602,"start_heard":20.419999999999998,"apart":0.818,"text":"“I will not enter my house"},{"line":10,"start":33.643,"start_heard":33.24,"apart":0.403,"text":"a dwelling for the Mighty One of Jacob.”"},{"line":15,"start":54.485,"start_heard":55.64,"apart":1.155,"text":"Arise, O LORD, to Your resting place,"},{"line":16,"start":58.886,"start_heard":58.3,"apart":0.586,"text":"You and the ark of Your strength."},{"line":23,"start":86.928,"start_heard":86.62,"apart":0.308,"text":"“One of your descendants"},{"line":24,"start":88.688,"start_heard":89.02000000000001,"apart":0.332,"text":"I will place on your throne."},{"line":25,"start":91.009,"start_heard":91.46000000000001,"apart":0.451,"text":"If your sons keep My covenant"},{"line":26,"start":92.649,"start_heard":93.58000000000001,"apart":0.931,"text":"and the testimony I will teach them,"},{"line":28,"start":97.509,"start_heard":97.84,"apart":0.331,"text":"forever and ever.”"},{"line":29,"start":98.969,"start_heard":99.52000000000001,"apart":0.551,"text":"For the LORD has chosen Zion;"},{"line":31,"start":104.81,"start_heard":104.36,"apart":0.45,"text":"“This is My resting place forever and ever;"},{"line":32,"start":108.95,"start_heard":108.64,"apart":0.31,"text":"here I will dwell, for I have desired this home."},{"line":35,"start":120.771,"start_heard":119.96000000000001,"apart":0.811,"text":"I will clothe her priests with salvation,"},{"line":37,"start":127.032,"start_heard":130.08,"apart":3.048,"text":"There I will make a horn grow for David;"},{"line":38,"start":134.233,"start_heard":133.8,"apart":0.433,"text":"I have prepared a lamp for My anointed one."},{"line":39,"start":137.313,"start_heard":137.62,"apart":0.307,"text":"I will clothe his enemies with shame,"}]},"bsb_PSA_133":{"chapter":133,"lines":11,"match_rate":0.909,"confidence":0.455,"words_written":66,"words_heard":119,"words_matched":60,"starts":[11.741,29.722,39.222,48.903,66.344,134.408,137.508,142.429,146.529,151.829,157.189],"starts_heard":[17.099999999999998,30.479999999999997,38.48,47.98,52.08,129.02,136.88,141.84,145.96,150.5,155.86],"flagged":[{"line":0,"start":11.741,"start_heard":17.099999999999998,"apart":5.359,"text":"A song of ascents. Of David."},{"line":1,"start":29.722,"start_heard":30.479999999999997,"apart":0.758,"text":"Behold, how good and pleasant it is"},{"line":2,"start":39.222,"start_heard":38.48,"apart":0.742,"text":"when brothers live together in harmony!"},{"line":3,"start":48.903,"start_heard":47.98,"apart":0.923,"text":"It is like fine oil on the head,"},{"line":4,"start":66.344,"start_heard":52.08,"apart":14.264,"text":"running down on the beard,"},{"line":5,"start":134.408,"start_heard":129.02,"apart":5.388,"text":"running down Aaron’s beard"},{"line":6,"start":137.508,"start_heard":136.88,"apart":0.628,"text":"over the collar of his robes."},{"line":7,"start":142.429,"start_heard":141.84,"apart":0.589,"text":"It is like the dew of Hermon"},{"line":8,"start":146.529,"start_heard":145.96,"apart":0.569,"text":"falling on the mountains of Zion."},{"line":9,"start":151.829,"start_heard":150.5,"apart":1.329,"text":"For there the LORD has bestowed the blessing"},{"line":10,"start":157.189,"start_heard":155.86,"apart":1.329,"text":"of life forevermore."}]},"bsb_PSA_134":{"chapter":134,"lines":9,"match_rate":0.979,"confidence":0.258,"words_written":48,"words_heard":103,"words_matched":47,"starts":[4.22,9.881,15.541,20.021,25.502,28.762,36.582,42.223,107.667],"starts_heard":[4.720000000000001,10.200000000000001,15.26,20.299999999999997,22.72,29.22,36.4,39.46,118.02000000000001],"flagged":[{"line":0,"start":4.22,"start_heard":4.720000000000001,"apart":0.5,"text":"A song of ascents."},{"line":1,"start":9.881,"start_heard":10.200000000000001,"apart":0.319,"text":"Come, bless the LORD,"},{"line":4,"start":25.502,"start_heard":22.72,"apart":2.782,"text":"in the house of the LORD!"},{"line":5,"start":28.762,"start_heard":29.22,"apart":0.458,"text":"Lift up your hands to the sanctuary"},{"line":7,"start":42.223,"start_heard":39.46,"apart":2.763,"text":"May the LORD, the Maker of heaven and earth,"},{"line":8,"start":107.667,"start_heard":118.02000000000001,"apart":10.353,"text":"bless you from Zion."}]},"bsb_PSA_135":{"chapter":135,"lines":48,"match_rate":0.891,"confidence":0.356,"words_written":311,"words_heard":287,"words_matched":277,"starts":[2.14,5.1,8.501,12.041,15.581,19.761,24.701,29.922,34.082,37.722,41.102,44.423,47.483,50.323,53.023,55.883,58.284,60.984,63.984,67.584,69.844,75.425,78.605,82.665,85.125,88.365,89.785,91.466,94.886,98.606,103.246,108.547,111.907,115.527,119.927,122.007,124.247,127.368,130.768,133.368,137.648,141.068,145.809,148.729,152.489,156.009,159.45,162.57],"starts_heard":[2.54,5.0600000000000005,8.58,12.3,15.700000000000001,20.24,24.38,30.16,33.82,37.68,41.32,44.76,47.18,50.24,53.339999999999996,55.9,58.74,61.12,64.04,67.84,70.36,75.72,78.68,82.42,85.72,null,null,90.48,95.04,99,102.64,108.18,111.66000000000001,116.24000000000001,117.76,null,121.36,124.64,130.98000000000002,133.5,137.24,141.36,145.58,149.04,152.58,156.32,159.88,162.88],"flagged":[{"line":0,"start":2.14,"start_heard":2.54,"apart":0.4,"text":"Hallelujah!"},{"line":5,"start":19.761,"start_heard":20.24,"apart":0.479,"text":"Hallelujah, for the LORD is good;"},{"line":6,"start":24.701,"start_heard":24.38,"apart":0.321,"text":"sing praises to His name, for it is lovely."},{"line":11,"start":44.423,"start_heard":44.76,"apart":0.337,"text":"The LORD does all that pleases Him"},{"line":12,"start":47.483,"start_heard":47.18,"apart":0.303,"text":"in the heavens and on the earth,"},{"line":14,"start":53.023,"start_heard":53.339999999999996,"apart":0.317,"text":"He causes the clouds to rise"},{"line":16,"start":58.284,"start_heard":58.74,"apart":0.456,"text":"He generates the lightning with the rain"},{"line":20,"start":69.844,"start_heard":70.36,"apart":0.516,"text":"He sent signs and wonders into your midst, O Egypt,"},{"line":24,"start":85.125,"start_heard":85.72,"apart":0.595,"text":"Sihon king of the Amorites,"},{"line":25,"start":88.365,"start_heard":null,"apart":null,"text":"Og king of Bashan,"},{"line":26,"start":89.785,"start_heard":null,"apart":null,"text":"and all the kings of Canaan."},{"line":27,"start":91.466,"start_heard":90.48,"apart":0.986,"text":"He gave their land as an inheritance,"},{"line":29,"start":98.606,"start_heard":99,"apart":0.394,"text":"Your name, O LORD, endures forever,"},{"line":30,"start":103.246,"start_heard":102.64,"apart":0.606,"text":"Your renown, O LORD, through all generations."},{"line":31,"start":108.547,"start_heard":108.18,"apart":0.367,"text":"For the LORD will vindicate His people"},{"line":33,"start":115.527,"start_heard":116.24000000000001,"apart":0.713,"text":"The idols of the nations are silver and gold,"},{"line":34,"start":119.927,"start_heard":117.76,"apart":2.167,"text":"made by the hands of men."},{"line":35,"start":122.007,"start_heard":null,"apart":null,"text":"They have mouths, but cannot speak;"},{"line":36,"start":124.247,"start_heard":121.36,"apart":2.887,"text":"they have eyes, but cannot see;"},{"line":37,"start":127.368,"start_heard":124.64,"apart":2.728,"text":"they have ears, but cannot hear;"},{"line":40,"start":137.648,"start_heard":137.24,"apart":0.408,"text":"as do all who trust in them."},{"line":43,"start":148.729,"start_heard":149.04,"apart":0.311,"text":"O house of Levi, bless the LORD;"},{"line":45,"start":156.009,"start_heard":156.32,"apart":0.311,"text":"Blessed be the LORD from Zion—"},{"line":46,"start":159.45,"start_heard":159.88,"apart":0.43,"text":"He who dwells in Jerusalem."},{"line":47,"start":162.57,"start_heard":162.88,"apart":0.31,"text":"Hallelujah!"}]}}