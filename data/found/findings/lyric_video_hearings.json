{"bsb_PSA_120":{"chapter":120,"lines":16,"match_rate":0.794,"confidence":0.304,"words_written":97,"words_heard":99,"words_matched":77,"flagged":[{"line":0,"start":6.621,"start_heard":7.08,"apart":0.459,"text":"A song of ascents."},{"line":1,"start":9.602,"start_heard":8.620000000000001,"apart":0.982,"text":"In my distress I cried to the LORD,"},{"line":4,"start":24.464,"start_heard":23.34,"apart":1.124,"text":"from lying lips and a deceitful tongue."},{"line":5,"start":32.545,"start_heard":29.86,"apart":2.685,"text":"What will He do to you,"},{"line":6,"start":38.486,"start_heard":36.16,"apart":2.326,"text":"and what will be added to you,"},{"line":7,"start":43.767,"start_heard":45.18,"apart":1.413,"text":"O deceitful tongue?"},{"line":9,"start":48.488,"start_heard":48.18,"apart":0.308,"text":"with burning coals of the broom tree!"},{"line":10,"start":51.568,"start_heard":52.16,"apart":0.592,"text":"Woe to me that I dwell in Meshech,"},{"line":14,"start":62.57,"start_heard":63.1,"apart":0.53,"text":"I am in favor of peace;"},{"line":15,"start":68.571,"start_heard":69.12,"apart":0.549,"text":"but when I speak, they want war."}]}}