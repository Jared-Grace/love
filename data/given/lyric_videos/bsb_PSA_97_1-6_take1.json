{"passage":"Psalm 97:1-6","credit":"Berean Standard Bible","duration":74.752993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.29,"text":"The LORD reigns, let the earth rejoice;"},{"start":7.29,"end":12.58,"text":"let the distant shores be glad."},{"start":12.58,"end":17.87,"text":"Clouds and darkness surround Him;"},{"start":17.87,"end":23.15,"text":"righteousness and justice are His throne’s foundation."},{"start":23.15,"end":28.44,"text":"Fire goes before Him"},{"start":28.44,"end":33.73,"text":"and consumes His foes on every side."},{"start":33.73,"end":39.02,"text":"His lightning illuminates the world;"},{"start":39.02,"end":44.31,"text":"the earth sees and trembles."},{"start":44.31,"end":49.6,"text":"The mountains melt like wax"},{"start":49.6,"end":54.89,"text":"at the presence of the LORD,"},{"start":54.89,"end":60.18,"text":"before the Lord of all the earth."},{"start":60.18,"end":65.46,"text":"The heavens proclaim His righteousness;"},{"start":65.46,"end":70.75,"text":"all the peoples see His glory."}]}