{"passage":"Psalm 99:1-5","credit":"Berean Standard Bible","duration":48.469002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":4.83,"text":"The LORD reigns;"},{"start":4.83,"end":7.66,"text":"let the nations tremble!"},{"start":7.66,"end":10.49,"text":"He is enthroned above the cherubim;"},{"start":10.49,"end":13.33,"text":"let the earth quake!"},{"start":13.33,"end":16.16,"text":"Great is the LORD in Zion;"},{"start":16.16,"end":18.99,"text":"He is exalted above all the peoples."},{"start":18.99,"end":21.82,"text":"Let them praise Your great and awesome name—"},{"start":21.82,"end":24.65,"text":"He is holy!"},{"start":24.65,"end":27.48,"text":"The mighty King loves justice."},{"start":27.48,"end":30.31,"text":"You have established equity;"},{"start":30.31,"end":33.14,"text":"You have exercised justice"},{"start":33.14,"end":35.98,"text":"and righteousness in Jacob."},{"start":35.98,"end":38.81,"text":"Exalt the LORD our God,"},{"start":38.81,"end":41.64,"text":"and worship at His footstool;"},{"start":41.64,"end":44.47,"text":"He is holy!"}]}