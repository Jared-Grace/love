{"passage":"Psalm 102:19-22","credit":"Berean Standard Bible","duration":67.555011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":9.69,"text":"For He looked down from the heights of His sanctuary;"},{"start":9.69,"end":17.39,"text":"the LORD gazed out from heaven to earth"},{"start":17.39,"end":25.08,"text":"to hear a prisoner’s groaning,"},{"start":25.08,"end":32.78,"text":"to release those condemned to death,"},{"start":32.78,"end":40.47,"text":"that they may proclaim the name of the LORD in Zion"},{"start":40.47,"end":48.17,"text":"and praise Him in Jerusalem,"},{"start":48.17,"end":55.86,"text":"when peoples and kingdoms assemble"},{"start":55.86,"end":63.56,"text":"to serve the LORD."}]}