{"passage":"Psalm 133","credit":"Berean Standard Bible","duration":166.43,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":11.74,"end":29.67,"text":"A song of ascents. Of David."},{"start":29.72,"end":39.17,"text":"Behold, how good and pleasant it is"},{"start":39.22,"end":48.85,"text":"when brothers live together in harmony!"},{"start":48.9,"end":66.29,"text":"It is like fine oil on the head,"},{"start":66.34,"end":134.36,"text":"running down on the beard,"},{"start":134.41,"end":137.46,"text":"running down Aaron’s beard"},{"start":137.51,"end":142.38,"text":"over the collar of his robes."},{"start":142.43,"end":146.48,"text":"It is like the dew of Hermon"},{"start":146.53,"end":151.78,"text":"falling on the mountains of Zion."},{"start":151.83,"end":157.14,"text":"For there the LORD has bestowed the blessing"},{"start":157.19,"end":166.43,"text":"of life forevermore."}],"times_from":"machine"}