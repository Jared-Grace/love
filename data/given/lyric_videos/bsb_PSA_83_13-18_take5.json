{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":80.308005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.72,"text":"Make them like tumbleweed, O my God,"},{"start":7.72,"end":13.43,"text":"like chaff before the wind."},{"start":13.43,"end":19.15,"text":"As fire consumes a forest,"},{"start":19.15,"end":24.86,"text":"as a flame sets the mountains ablaze,"},{"start":24.86,"end":30.58,"text":"so pursue them with Your tempest,"},{"start":30.58,"end":36.3,"text":"and terrify them with Your storm."},{"start":36.3,"end":42.01,"text":"Cover their faces with shame,"},{"start":42.01,"end":47.73,"text":"that they may seek Your name, O LORD."},{"start":47.73,"end":53.44,"text":"May they be ever ashamed and terrified;"},{"start":53.44,"end":59.16,"text":"may they perish in disgrace."},{"start":59.16,"end":64.88,"text":"May they know that You alone,"},{"start":64.88,"end":70.59,"text":"whose name is the LORD,"},{"start":70.59,"end":76.31,"text":"are Most High over all the earth."}]}