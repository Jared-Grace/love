{"passage":"Psalm 118:1-9","credit":"Berean Standard Bible","duration":102.758005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.4,"end":6.35,"text":"Give thanks to the LORD, for He is good;"},{"start":6.4,"end":12.35,"text":"His loving devotion endures forever."},{"start":12.4,"end":14.77,"text":"Let Israel say,"},{"start":14.82,"end":19.35,"text":"“His loving devotion endures forever.”"},{"start":19.4,"end":23.81,"text":"Let the house of Aaron say,"},{"start":23.86,"end":30.81,"text":"“His loving devotion endures forever.”"},{"start":30.86,"end":34.83,"text":"Let those who fear the LORD say,"},{"start":34.88,"end":39.83,"text":"“His loving devotion endures forever.”"},{"start":39.88,"end":48.05,"text":"In my distress I called to the LORD,"},{"start":48.1,"end":53.69,"text":"and He answered and set me free."},{"start":53.74,"end":60.65,"text":"The LORD is on my side; I will not be afraid."},{"start":60.7,"end":67.11,"text":"What can man do to me?"},{"start":67.16,"end":73.29,"text":"The LORD is on my side; He is my helper."},{"start":73.34,"end":79.29,"text":"Therefore I will look in triumph on those who hate me."},{"start":79.34,"end":84.55,"text":"It is better to take refuge in the LORD"},{"start":84.6,"end":89.27,"text":"than to trust in man."},{"start":89.32,"end":94.17,"text":"It is better to take refuge in the LORD"},{"start":94.22,"end":102.76,"text":"than to trust in princes."}],"times_from":"machine"}