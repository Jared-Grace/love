{"passage":"Psalm 134","credit":"Berean Standard Bible","duration":64.405011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.49,"text":"A song of ascents."},{"start":8.49,"end":14.98,"text":"Come, bless the LORD,"},{"start":14.98,"end":21.47,"text":"all you servants of the LORD"},{"start":21.47,"end":27.96,"text":"who serve by night"},{"start":27.96,"end":34.45,"text":"in the house of the LORD!"},{"start":34.45,"end":40.94,"text":"Lift up your hands to the sanctuary"},{"start":40.94,"end":47.43,"text":"and bless the LORD!"},{"start":47.43,"end":53.92,"text":"May the LORD, the Maker of heaven and earth,"},{"start":53.92,"end":60.41,"text":"bless you from Zion."}]}