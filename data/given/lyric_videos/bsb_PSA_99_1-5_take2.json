{"passage":"Psalm 99:1-5","credit":"Berean Standard Bible","duration":57.89,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.46,"text":"The LORD reigns;"},{"start":5.46,"end":8.92,"text":"let the nations tremble!"},{"start":8.92,"end":12.38,"text":"He is enthroned above the cherubim;"},{"start":12.38,"end":15.84,"text":"let the earth quake!"},{"start":15.84,"end":19.3,"text":"Great is the LORD in Zion;"},{"start":19.3,"end":22.76,"text":"He is exalted above all the peoples."},{"start":22.76,"end":26.22,"text":"Let them praise Your great and awesome name—"},{"start":26.22,"end":29.67,"text":"He is holy!"},{"start":29.67,"end":33.13,"text":"The mighty King loves justice."},{"start":33.13,"end":36.59,"text":"You have established equity;"},{"start":36.59,"end":40.05,"text":"You have exercised justice"},{"start":40.05,"end":43.51,"text":"and righteousness in Jacob."},{"start":43.51,"end":46.97,"text":"Exalt the LORD our God,"},{"start":46.97,"end":50.43,"text":"and worship at His footstool;"},{"start":50.43,"end":53.89,"text":"He is holy!"}]}