{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":89.461995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.16,"end":5.59,"text":"A song of ascents."},{"start":5.64,"end":8.79,"text":"I lift up my eyes to the hills."},{"start":8.84,"end":11.79,"text":"From where does my help come?"},{"start":11.84,"end":15.63,"text":"My help comes from the LORD,"},{"start":15.68,"end":21.06,"text":"the Maker of heaven and earth."},{"start":21.11,"end":24.74,"text":"He will not allow your foot to slip;"},{"start":24.79,"end":31.12,"text":"your Protector will not slumber."},{"start":31.17,"end":37.32,"text":"Behold, the Protector of Israel"},{"start":37.37,"end":43.52,"text":"will neither slumber nor sleep."},{"start":43.57,"end":46.08,"text":"The LORD is your keeper;"},{"start":46.13,"end":49.1,"text":"the LORD is the shade on your right hand."},{"start":49.15,"end":52.42,"text":"The sun will not strike you by day,"},{"start":52.47,"end":55.94,"text":"nor the moon by night."},{"start":55.99,"end":62.47,"text":"The LORD will guard you from all evil;"},{"start":62.52,"end":67.99,"text":"He will preserve your soul."},{"start":68.04,"end":74.11,"text":"The LORD will watch over your coming and going,"},{"start":74.16,"end":89.46,"text":"both now and forevermore."}],"times_from":"machine"}