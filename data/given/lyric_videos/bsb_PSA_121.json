{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":89.461995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.91,"text":"A song of ascents."},{"start":6.91,"end":11.82,"text":"I lift up my eyes to the hills."},{"start":11.82,"end":16.73,"text":"From where does my help come?"},{"start":16.73,"end":21.64,"text":"My help comes from the LORD,"},{"start":21.64,"end":26.55,"text":"the Maker of heaven and earth."},{"start":26.55,"end":31.46,"text":"He will not allow your foot to slip;"},{"start":31.46,"end":36.37,"text":"your Protector will not slumber."},{"start":36.37,"end":41.28,"text":"Behold, the Protector of Israel"},{"start":41.28,"end":46.19,"text":"will neither slumber nor sleep."},{"start":46.19,"end":51.1,"text":"The LORD is your keeper;"},{"start":51.1,"end":56,"text":"the LORD is the shade on your right hand."},{"start":56,"end":60.91,"text":"The sun will not strike you by day,"},{"start":60.91,"end":65.82,"text":"nor the moon by night."},{"start":65.82,"end":70.73,"text":"The LORD will guard you from all evil;"},{"start":70.73,"end":75.64,"text":"He will preserve your soul."},{"start":75.64,"end":80.55,"text":"The LORD will watch over your coming and going,"},{"start":80.55,"end":85.46,"text":"both now and forevermore."}]}