{"passage":"Psalm 123","credit":"Berean Standard Bible","duration":82.582993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":8.26,"end":10.79,"text":"A song of ascents."},{"start":10.84,"end":15.29,"text":"I lift up my eyes to You,"},{"start":15.34,"end":18.5,"text":"the One enthroned in heaven."},{"start":18.55,"end":20.24,"text":"As the eyes of servants"},{"start":20.29,"end":24.66,"text":"look to the hand of their master,"},{"start":24.71,"end":28.3,"text":"as the eyes of a maidservant"},{"start":28.35,"end":31.92,"text":"look to the hand of her mistress,"},{"start":31.97,"end":40.66,"text":"so our eyes are on the LORD our God"},{"start":40.71,"end":47,"text":"until He shows us mercy."},{"start":47.05,"end":53.15,"text":"Have mercy on us, O LORD, have mercy,"},{"start":53.2,"end":58.27,"text":"for we have endured much contempt."},{"start":58.32,"end":66.17,"text":"We have endured much scorn from the arrogant,"},{"start":66.22,"end":82.58,"text":"much contempt from the proud."}],"times_from":"machine"}