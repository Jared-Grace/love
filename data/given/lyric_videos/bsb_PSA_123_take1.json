{"passage":"Psalm 123","credit":"Berean Standard Bible","duration":82.582993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.89,"text":"A song of ascents."},{"start":7.89,"end":13.78,"text":"I lift up my eyes to You,"},{"start":13.78,"end":19.67,"text":"the One enthroned in heaven."},{"start":19.67,"end":25.56,"text":"As the eyes of servants"},{"start":25.56,"end":31.45,"text":"look to the hand of their master,"},{"start":31.45,"end":37.35,"text":"as the eyes of a maidservant"},{"start":37.35,"end":43.24,"text":"look to the hand of her mistress,"},{"start":43.24,"end":49.13,"text":"so our eyes are on the LORD our God"},{"start":49.13,"end":55.02,"text":"until He shows us mercy."},{"start":55.02,"end":60.91,"text":"Have mercy on us, O LORD, have mercy,"},{"start":60.91,"end":66.8,"text":"for we have endured much contempt."},{"start":66.8,"end":72.69,"text":"We have endured much scorn from the arrogant,"},{"start":72.69,"end":78.58,"text":"much contempt from the proud."}]}