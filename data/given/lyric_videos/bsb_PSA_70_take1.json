{"passage":"Psalm 70","credit":"Berean Standard Bible","duration":118.407007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.61,"text":"For the choirmaster. Of David. To bring remembrance."},{"start":8.61,"end":15.22,"text":"Make haste, O God, to deliver me!"},{"start":15.22,"end":21.84,"text":"Hurry, O LORD, to help me!"},{"start":21.84,"end":28.45,"text":"May those who seek my life"},{"start":28.45,"end":35.06,"text":"be ashamed and confounded;"},{"start":35.06,"end":41.67,"text":"may those who wish me harm"},{"start":41.67,"end":48.29,"text":"be repelled and humiliated."},{"start":48.29,"end":54.9,"text":"May those who say, “Aha, aha!”"},{"start":54.9,"end":61.51,"text":"retreat because of their shame."},{"start":61.51,"end":68.12,"text":"May all who seek You"},{"start":68.12,"end":74.73,"text":"rejoice and be glad in You;"},{"start":74.73,"end":81.35,"text":"may those who love Your salvation always say,"},{"start":81.35,"end":87.96,"text":"“Let God be magnified!”"},{"start":87.96,"end":94.57,"text":"But I am poor and needy;"},{"start":94.57,"end":101.18,"text":"hurry to me, O God."},{"start":101.18,"end":107.79,"text":"You are my help and my deliverer;"},{"start":107.79,"end":114.41,"text":"O LORD, do not delay."}]}