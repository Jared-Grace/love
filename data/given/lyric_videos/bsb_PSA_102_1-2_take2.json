{"passage":"Psalm 102:1-2","credit":"Berean Standard Bible","duration":67.865011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":10.84,"text":"A prayer of one who is afflicted, when he grows faint and pours out his lament before the LORD."},{"start":10.84,"end":19.68,"text":"Hear my prayer, O LORD;"},{"start":19.68,"end":28.51,"text":"let my cry for help come before You."},{"start":28.51,"end":37.35,"text":"Do not hide Your face from me"},{"start":37.35,"end":46.19,"text":"in my day of distress."},{"start":46.19,"end":55.03,"text":"Incline Your ear to me;"},{"start":55.03,"end":63.87,"text":"answer me quickly when I call."}]}