{"passage":"Psalm 101:5-8","credit":"Berean Standard Bible","duration":74.820998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.92,"text":"Whoever slanders his neighbor in secret,"},{"start":6.92,"end":11.83,"text":"I will put to silence;"},{"start":11.83,"end":16.75,"text":"the one with haughty eyes and a proud heart,"},{"start":16.75,"end":21.66,"text":"I will not endure."},{"start":21.66,"end":26.58,"text":"My eyes favor the faithful of the land,"},{"start":26.58,"end":31.49,"text":"that they may dwell with me;"},{"start":31.49,"end":36.41,"text":"he who walks in the way of integrity"},{"start":36.41,"end":41.33,"text":"shall minister to me."},{"start":41.33,"end":46.24,"text":"No one who practices deceit"},{"start":46.24,"end":51.16,"text":"shall dwell in my house;"},{"start":51.16,"end":56.07,"text":"no one who tells lies"},{"start":56.07,"end":60.99,"text":"shall stand in my presence."},{"start":60.99,"end":65.91,"text":"Every morning I will remove all the wicked of the land,"},{"start":65.91,"end":70.82,"text":"that I may cut off every evildoer from the city of the LORD."}]}