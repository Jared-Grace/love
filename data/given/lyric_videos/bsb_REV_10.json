gitignore/lyric_video_pictures/bsb_REV_10/pd_aivazovsky_chaos_the_creation_of_the_world.png","start":null,"end":null},{"scene":"pending","name":"pd_church_schoodic_peninsula_at_sunrise","line":20,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_church_schoodic_peninsula_at_sunrise.png","start":null,"end":null},{"scene":"pending","name":"pd_fra_angelico_the_last_judgement","line":22,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_fra_angelico_the_last_judgement.png","start":null,"end":null},{"scene":"pending","name":"pd_durer_the_seven_angels_with_the_trumpets","line":24,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_durer_the_seven_angels_with_the_trumpets.png","start":null,"end":null},{"scene":"pending","name":"pd_michelangelo_isaiah","line":26,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_michelangelo_isaiah.png","start":null,"end":null},{"scene":"pending","name":"pd_master_of_the_female_half_lengths_saint_john_on_patmos","line":28,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_master_of_the_female_half_lengths_saint_john_on_patmos.png","start":null,"end":null},{"scene":"pending","name":"pd_fra_angelico_the_annunciation","line":30,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_fra_angelico_the_annunciation.png","start":null,"end":null},{"scene":"pending","name":"pd_durer_saint_john_devours_the_book","line":32,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_durer_saint_john_devours_the_book.png","start":null,"end":null},{"scene":"pending","name":"pd_melendez_figs_and_bread","line":34,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_melendez_figs_and_bread.png","start":null,"end":null},{"scene":"pending","name":"pd_van_beyeren_sumptuous_still_life","line":36,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_van_beyeren_sumptuous_still_life.png","start":null,"end":null},{"scene":"pending","name":"cup_in_the_garden","line":38,"path":"gitignore/lyric_video_pictures/bsb_REV_10/cup_in_the_garden.png","start":null,"end":null},{"scene":"pending","name":"pd_raphael_saint_paul_preaching_at_athens","line":40,"path":"gitignore/lyric_video_pictures/bsb_REV_10/pd_raphael_saint_paul_preaching_at_athens.png","start":null}],"lines":[{"text":"Then I saw another mighty angel coming down from heaven,"},{"text":"wrapped in a cloud, with a rainbow above his head."},{"text":"His face was like the sun,"},{"text":"and his legs were like pillars of fire."},{"text":"He held in his hand a small scroll, which lay open."},{"text":"He placed his right foot on the sea"},{"text":"and his left foot on the land."},{"text":"Then he cried out in a loud voice"},{"text":"like the roar of a lion."},{"text":"And when he cried out,"},{"text":"the seven thunders sounded their voices."},{"text":"When the seven thunders had spoken,"},{"text":"I was about to put it in writing."},{"text":"But I heard a voice from heaven saying,"},{"text":"Seal up what the seven thunders have said,"},{"text":"and do not write it down."},{"text":"Then the angel I had seen standing on the sea and on the land"},{"text":"lifted up his right hand to heaven."},{"text":"And he swore by Him who lives forever and ever,"},{"text":"who created heaven and everything in it,"},{"text":"the earth and everything in it,"},{"text":"and the sea and everything in it:"},{"text":"There will be no more delay!"},{"text":"But in the days of the voice of the seventh angel,"},{"text":"when he is about to sound his trumpet,"},{"text":"the mystery of God will be fulfilled,"},{"text":"just as He proclaimed to His servants the prophets."},{"text":"Then the voice that I had heard from heaven"},{"text":"spoke to me again, saying,"},{"text":"Go, take the small scroll that lies open"},{"text":"in the hand of the angel standing on the sea and on the land."},{"text":"And I went to the angel and said,"},{"text":"Give me the small scroll."},{"text":"Take it and eat it, he said."},{"text":"It will make your stomach bitter,"},{"text":"but in your mouth it will be as sweet as honey."},{"text":"So I took the small scroll from the angel's hand and ate it;"},{"text":"and it was as sweet as honey in my mouth,"},{"text":"but when I had eaten it, my stomach turned bitter."},{"text":"And they told me,"},{"text":"You must prophesy again about many peoples"},{"text":"and nations and tongues and kings."}]}
