{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":99.86,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.52,"text":"A song of ascents."},{"start":7.52,"end":13.04,"text":"I lift up my eyes to the hills."},{"start":13.04,"end":18.56,"text":"From where does my help come?"},{"start":18.56,"end":24.08,"text":"My help comes from the LORD,"},{"start":24.08,"end":29.61,"text":"the Maker of heaven and earth."},{"start":29.61,"end":35.13,"text":"He will not allow your foot to slip;"},{"start":35.13,"end":40.65,"text":"your Protector will not slumber."},{"start":40.65,"end":46.17,"text":"Behold, the Protector of Israel"},{"start":46.17,"end":51.69,"text":"will neither slumber nor sleep."},{"start":51.69,"end":57.21,"text":"The LORD is your keeper;"},{"start":57.21,"end":62.73,"text":"the LORD is the shade on your right hand."},{"start":62.73,"end":68.25,"text":"The sun will not strike you by day,"},{"start":68.25,"end":73.78,"text":"nor the moon by night."},{"start":73.78,"end":79.3,"text":"The LORD will guard you from all evil;"},{"start":79.3,"end":84.82,"text":"He will preserve your soul."},{"start":84.82,"end":90.34,"text":"The LORD will watch over your coming and going,"},{"start":90.34,"end":95.86,"text":"both now and forevermore."}]}