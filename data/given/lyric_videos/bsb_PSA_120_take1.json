{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":57.915011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.7,"end":6.61,"text":"A song of ascents."},{"start":6.66,"end":9.97,"text":"In my distress I cried to the LORD,"},{"start":10.02,"end":12.37,"text":"and He answered me."},{"start":12.42,"end":17.5,"text":"Deliver my soul, O LORD,"},{"start":17.55,"end":21.78,"text":"from lying lips and a deceitful tongue."},{"start":21.83,"end":24.56,"text":"What will He do to you,"},{"start":24.61,"end":28.36,"text":"and what will be added to you,"},{"start":28.41,"end":30.7,"text":"O deceitful tongue?"},{"start":30.75,"end":34.6,"text":"Sharp arrows will come from the warrior,"},{"start":34.65,"end":38.58,"text":"with burning coals of the broom tree!"},{"start":38.63,"end":42.38,"text":"Woe to me that I dwell in Meshech,"},{"start":42.43,"end":45.74,"text":"that I live among the tents of Kedar!"},{"start":45.79,"end":47.76,"text":"Too long have I dwelt"},{"start":47.81,"end":50.06,"text":"among those who hate peace."},{"start":50.11,"end":53.32,"text":"I am in favor of peace;"},{"start":53.37,"end":57.92,"text":"but when I speak, they want war."}],"times_from":"machine"}