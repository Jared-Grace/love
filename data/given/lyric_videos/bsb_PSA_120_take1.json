{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":57.915011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.24,"text":"A song of ascents."},{"start":5.24,"end":8.49,"text":"In my distress I cried to the LORD,"},{"start":8.49,"end":11.73,"text":"and He answered me."},{"start":11.73,"end":14.98,"text":"Deliver my soul, O LORD,"},{"start":14.98,"end":18.22,"text":"from lying lips and a deceitful tongue."},{"start":18.22,"end":21.47,"text":"What will He do to you,"},{"start":21.47,"end":24.71,"text":"and what will be added to you,"},{"start":24.71,"end":27.96,"text":"O deceitful tongue?"},{"start":27.96,"end":31.2,"text":"Sharp arrows will come from the warrior,"},{"start":31.2,"end":34.45,"text":"with burning coals of the broom tree!"},{"start":34.45,"end":37.69,"text":"Woe to me that I dwell in Meshech,"},{"start":37.69,"end":40.94,"text":"that I live among the tents of Kedar!"},{"start":40.94,"end":44.18,"text":"Too long have I dwelt"},{"start":44.18,"end":47.43,"text":"among those who hate peace."},{"start":47.43,"end":50.67,"text":"I am in favor of peace;"},{"start":50.67,"end":53.92,"text":"but when I speak, they want war."}]}