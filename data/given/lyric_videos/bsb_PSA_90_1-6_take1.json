{"passage":"Psalm 90:1-6","credit":"Berean Standard Bible","duration":66.047007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.75,"text":"A prayer of Moses the man of God."},{"start":5.75,"end":9.51,"text":"Lord, You have been our dwelling place"},{"start":9.51,"end":13.26,"text":"through all generations."},{"start":13.26,"end":17.01,"text":"Before the mountains were born"},{"start":17.01,"end":20.76,"text":"or You brought forth the earth and the world,"},{"start":20.76,"end":24.52,"text":"from everlasting to everlasting"},{"start":24.52,"end":28.27,"text":"You are God."},{"start":28.27,"end":32.02,"text":"You return man to dust,"},{"start":32.02,"end":35.78,"text":"saying, “Return, O sons of mortals.”"},{"start":35.78,"end":39.53,"text":"For in Your sight a thousand years"},{"start":39.53,"end":43.28,"text":"are but a day that passes,"},{"start":43.28,"end":47.04,"text":"or a watch of the night."},{"start":47.04,"end":50.79,"text":"You sweep them away in their sleep;"},{"start":50.79,"end":54.54,"text":"they are like the new grass of the morning—"},{"start":54.54,"end":58.29,"text":"in the morning it springs up new,"},{"start":58.29,"end":62.05,"text":"but by evening it fades and withers."}]}