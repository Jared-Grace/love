{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":58.330998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.54,"text":"Save us, O LORD our God,"},{"start":8.54,"end":15.08,"text":"and gather us from the nations,"},{"start":15.08,"end":21.62,"text":"that we may give thanks to Your holy name,"},{"start":21.62,"end":28.17,"text":"that we may glory in Your praise."},{"start":28.17,"end":34.71,"text":"Blessed be the LORD, the God of Israel,"},{"start":34.71,"end":41.25,"text":"from everlasting to everlasting."},{"start":41.25,"end":47.79,"text":"Let all the people say, “Amen!”"},{"start":47.79,"end":54.33,"text":"Hallelujah!"}]}