{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":58.330998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":5.06,"end":10.49,"text":"Save us, O LORD our God,"},{"start":10.54,"end":16.95,"text":"and gather us from the nations,"},{"start":17,"end":23.29,"text":"that we may give thanks to Your holy name,"},{"start":23.34,"end":29.28,"text":"that we may glory in Your praise."},{"start":29.33,"end":35.24,"text":"Blessed be the LORD, the God of Israel,"},{"start":35.29,"end":41.58,"text":"from everlasting to everlasting."},{"start":41.63,"end":48.68,"text":"Let all the people say, “Amen!”"},{"start":48.73,"end":58.33,"text":"Hallelujah!"}],"times_from":"machine"}