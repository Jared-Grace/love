{"passage":"Psalm 101:5-8","credit":"Berean Standard Bible","duration":65.031995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.22,"text":"Whoever slanders his neighbor in secret,"},{"start":6.22,"end":10.43,"text":"I will put to silence;"},{"start":10.43,"end":14.65,"text":"the one with haughty eyes and a proud heart,"},{"start":14.65,"end":18.87,"text":"I will not endure."},{"start":18.87,"end":23.08,"text":"My eyes favor the faithful of the land,"},{"start":23.08,"end":27.3,"text":"that they may dwell with me;"},{"start":27.3,"end":31.52,"text":"he who walks in the way of integrity"},{"start":31.52,"end":35.73,"text":"shall minister to me."},{"start":35.73,"end":39.95,"text":"No one who practices deceit"},{"start":39.95,"end":44.17,"text":"shall dwell in my house;"},{"start":44.17,"end":48.38,"text":"no one who tells lies"},{"start":48.38,"end":52.6,"text":"shall stand in my presence."},{"start":52.6,"end":56.82,"text":"Every morning I will remove all the wicked of the land,"},{"start":56.82,"end":61.03,"text":"that I may cut off every evildoer from the city of the LORD."}]}