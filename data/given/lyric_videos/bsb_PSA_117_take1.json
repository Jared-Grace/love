{"passage":"Psalm 117","credit":"Berean Standard Bible","duration":47.929002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.9,"end":13.27,"text":"Praise the LORD, all you nations!"},{"start":13.32,"end":23.49,"text":"Extol Him, all you peoples!"},{"start":23.54,"end":32.48,"text":"For great is His loving devotion toward us,"},{"start":32.53,"end":41.3,"text":"and the faithfulness of the LORD endures forever."},{"start":41.35,"end":47.93,"text":"Hallelujah!"}],"times_from":"machine"}