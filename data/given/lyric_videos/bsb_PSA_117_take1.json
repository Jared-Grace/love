{"passage":"Psalm 117","credit":"Berean Standard Bible","duration":47.929002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":10.39,"text":"Praise the LORD, all you nations!"},{"start":10.39,"end":18.77,"text":"Extol Him, all you peoples!"},{"start":18.77,"end":27.16,"text":"For great is His loving devotion toward us,"},{"start":27.16,"end":35.54,"text":"and the faithfulness of the LORD endures forever."},{"start":35.54,"end":43.93,"text":"Hallelujah!"}]}