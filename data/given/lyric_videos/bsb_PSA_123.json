{"passage":"Psalm 123","credit":"Berean Standard Bible","duration":92.818005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.68,"text":"A song of ascents."},{"start":8.68,"end":15.36,"text":"I lift up my eyes to You,"},{"start":15.36,"end":22.03,"text":"the One enthroned in heaven."},{"start":22.03,"end":28.71,"text":"As the eyes of servants"},{"start":28.71,"end":35.39,"text":"look to the hand of their master,"},{"start":35.39,"end":42.07,"text":"as the eyes of a maidservant"},{"start":42.07,"end":48.75,"text":"look to the hand of her mistress,"},{"start":48.75,"end":55.43,"text":"so our eyes are on the LORD our God"},{"start":55.43,"end":62.1,"text":"until He shows us mercy."},{"start":62.1,"end":68.78,"text":"Have mercy on us, O LORD, have mercy,"},{"start":68.78,"end":75.46,"text":"for we have endured much contempt."},{"start":75.46,"end":82.14,"text":"We have endured much scorn from the arrogant,"},{"start":82.14,"end":88.82,"text":"much contempt from the proud."}]}