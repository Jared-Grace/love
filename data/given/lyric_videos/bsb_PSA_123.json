{"passage":"Psalm 123","credit":"Berean Standard Bible","duration":92.818005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.36,"end":6.29,"text":"A song of ascents."},{"start":6.34,"end":11.45,"text":"I lift up my eyes to You,"},{"start":11.5,"end":20.49,"text":"the One enthroned in heaven."},{"start":20.54,"end":24.5,"text":"As the eyes of servants"},{"start":24.55,"end":29.72,"text":"look to the hand of their master,"},{"start":29.77,"end":33.78,"text":"as the eyes of a maidservant"},{"start":33.83,"end":40.68,"text":"look to the hand of her mistress,"},{"start":40.73,"end":46.94,"text":"so our eyes are on the LORD our God"},{"start":46.99,"end":50.66,"text":"until He shows us mercy."},{"start":50.71,"end":59.54,"text":"Have mercy on us, O LORD, have mercy,"},{"start":59.59,"end":68.38,"text":"for we have endured much contempt."},{"start":68.43,"end":74.85,"text":"We have endured much scorn from the arrogant,"},{"start":74.9,"end":92.82,"text":"much contempt from the proud."}]}