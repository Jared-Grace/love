{"passage":"Psalm 134","credit":"Berean Standard Bible","duration":138.229002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":16.69,"text":"A song of ascents."},{"start":16.69,"end":31.38,"text":"Come, bless the LORD,"},{"start":31.38,"end":46.08,"text":"all you servants of the LORD"},{"start":46.08,"end":60.77,"text":"who serve by night"},{"start":60.77,"end":75.46,"text":"in the house of the LORD!"},{"start":75.46,"end":90.15,"text":"Lift up your hands to the sanctuary"},{"start":90.15,"end":104.84,"text":"and bless the LORD!"},{"start":104.84,"end":119.54,"text":"May the LORD, the Maker of heaven and earth,"},{"start":119.54,"end":134.23,"text":"bless you from Zion."}]}