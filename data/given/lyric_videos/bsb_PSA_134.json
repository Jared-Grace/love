{"passage":"Psalm 134","credit":"Berean Standard Bible","duration":138.229002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.22,"end":9.83,"text":"A song of ascents."},{"start":9.88,"end":15.49,"text":"Come, bless the LORD,"},{"start":15.54,"end":19.97,"text":"all you servants of the LORD"},{"start":20.02,"end":25.45,"text":"who serve by night"},{"start":25.5,"end":28.71,"text":"in the house of the LORD!"},{"start":28.76,"end":36.53,"text":"Lift up your hands to the sanctuary"},{"start":36.58,"end":42.17,"text":"and bless the LORD!"},{"start":42.22,"end":107.62,"text":"May the LORD, the Maker of heaven and earth,"},{"start":107.67,"end":138.23,"text":"bless you from Zion."}]}