{"passage":"Psalm 69:14-18","credit":"Berean Standard Bible","duration":68.098005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":1.56,"end":3.87,"text":"Rescue me from the mire"},{"start":3.92,"end":7.95,"text":"and do not let me sink;"},{"start":8,"end":11.25,"text":"deliver me from my foes"},{"start":11.3,"end":15.31,"text":"and out of the deep waters."},{"start":15.36,"end":19.73,"text":"Do not let the floods engulf me"},{"start":19.78,"end":21.85,"text":"or the depths swallow me up;"},{"start":21.9,"end":27.29,"text":"let not the Pit close its mouth over me."},{"start":27.34,"end":29.59,"text":"Answer me, O LORD,"},{"start":29.64,"end":32.47,"text":"for Your loving devotion is good;"},{"start":32.52,"end":42.11,"text":"turn to me in keeping with Your great compassion."},{"start":42.16,"end":44.15,"text":"Hide not Your face from Your servant,"},{"start":44.2,"end":46.47,"text":"for I am in distress."},{"start":46.52,"end":50.61,"text":"Answer me quickly!"},{"start":50.66,"end":61.51,"text":"Draw near to my soul and redeem me;"},{"start":61.56,"end":68.1,"text":"ransom me because of my foes."}],"times_from":"machine"}