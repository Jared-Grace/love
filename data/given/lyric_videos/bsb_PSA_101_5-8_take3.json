{"passage":"Psalm 101:5-8","credit":"Berean Standard Bible","duration":77.519002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.11,"text":"Whoever slanders his neighbor in secret,"},{"start":7.11,"end":12.22,"text":"I will put to silence;"},{"start":12.22,"end":17.33,"text":"the one with haughty eyes and a proud heart,"},{"start":17.33,"end":22.43,"text":"I will not endure."},{"start":22.43,"end":27.54,"text":"My eyes favor the faithful of the land,"},{"start":27.54,"end":32.65,"text":"that they may dwell with me;"},{"start":32.65,"end":37.76,"text":"he who walks in the way of integrity"},{"start":37.76,"end":42.87,"text":"shall minister to me."},{"start":42.87,"end":47.98,"text":"No one who practices deceit"},{"start":47.98,"end":53.09,"text":"shall dwell in my house;"},{"start":53.09,"end":58.19,"text":"no one who tells lies"},{"start":58.19,"end":63.3,"text":"shall stand in my presence."},{"start":63.3,"end":68.41,"text":"Every morning I will remove all the wicked of the land,"},{"start":68.41,"end":73.52,"text":"that I may cut off every evildoer from the city of the LORD."}]}