{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":77.995011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.54,"text":"Make them like tumbleweed, O my God,"},{"start":7.54,"end":13.08,"text":"like chaff before the wind."},{"start":13.08,"end":18.61,"text":"As fire consumes a forest,"},{"start":18.61,"end":24.15,"text":"as a flame sets the mountains ablaze,"},{"start":24.15,"end":29.69,"text":"so pursue them with Your tempest,"},{"start":29.69,"end":35.23,"text":"and terrify them with Your storm."},{"start":35.23,"end":40.77,"text":"Cover their faces with shame,"},{"start":40.77,"end":46.3,"text":"that they may seek Your name, O LORD."},{"start":46.3,"end":51.84,"text":"May they be ever ashamed and terrified;"},{"start":51.84,"end":57.38,"text":"may they perish in disgrace."},{"start":57.38,"end":62.92,"text":"May they know that You alone,"},{"start":62.92,"end":68.46,"text":"whose name is the LORD,"},{"start":68.46,"end":74,"text":"are Most High over all the earth."}]}