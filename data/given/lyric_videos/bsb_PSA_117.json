{"passage":"Psalm 117","credit":"Berean Standard Bible","duration":45.276009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":9.86,"text":"Praise the LORD, all you nations!"},{"start":9.86,"end":17.71,"text":"Extol Him, all you peoples!"},{"start":17.71,"end":25.57,"text":"For great is His loving devotion toward us,"},{"start":25.57,"end":33.42,"text":"and the faithfulness of the LORD endures forever."},{"start":33.42,"end":41.28,"text":"Hallelujah!"}]}