{"passage":"Psalm 117","credit":"Berean Standard Bible","duration":45.276009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":1.98,"end":9.99,"text":"Praise the LORD, all you nations!"},{"start":10.04,"end":16.96,"text":"Extol Him, all you peoples!"},{"start":17.01,"end":23.92,"text":"For great is His loving devotion toward us,"},{"start":23.97,"end":29.78,"text":"and the faithfulness of the LORD endures forever."},{"start":29.83,"end":45.28,"text":"Hallelujah!"}],"times_from":"machine"}