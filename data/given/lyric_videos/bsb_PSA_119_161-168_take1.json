{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":73.210998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.04,"end":10.57,"text":"Rulers persecute me without cause,"},{"start":10.62,"end":17.21,"text":"but my heart fears only Your word."},{"start":17.26,"end":20.35,"text":"I rejoice in Your promise"},{"start":20.4,"end":22.97,"text":"like one who finds great spoil."},{"start":23.02,"end":27.29,"text":"I hate and abhor falsehood,"},{"start":27.34,"end":30.12,"text":"but Your law I love."},{"start":30.17,"end":33.42,"text":"Seven times a day I praise You"},{"start":33.47,"end":36.54,"text":"for Your righteous judgments."},{"start":36.59,"end":41.6,"text":"Abundant peace belongs to those who love Your law;"},{"start":41.65,"end":46.46,"text":"nothing can make them stumble."},{"start":46.51,"end":49.84,"text":"I wait for Your salvation, O LORD,"},{"start":49.89,"end":55.22,"text":"and I carry out Your commandments."},{"start":55.27,"end":59.34,"text":"I obey Your testimonies"},{"start":59.39,"end":60.6,"text":"and love them greatly."},{"start":60.65,"end":66.68,"text":"I obey Your precepts and Your testimonies,"},{"start":66.73,"end":73.21,"text":"for all my ways are before You."}],"times_from":"machine"}