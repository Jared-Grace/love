{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":73.210998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.2,"text":"Rulers persecute me without cause,"},{"start":6.2,"end":10.4,"text":"but my heart fears only Your word."},{"start":10.4,"end":14.6,"text":"I rejoice in Your promise"},{"start":14.6,"end":18.8,"text":"like one who finds great spoil."},{"start":18.8,"end":23,"text":"I hate and abhor falsehood,"},{"start":23,"end":27.2,"text":"but Your law I love."},{"start":27.2,"end":31.4,"text":"Seven times a day I praise You"},{"start":31.4,"end":35.61,"text":"for Your righteous judgments."},{"start":35.61,"end":39.81,"text":"Abundant peace belongs to those who love Your law;"},{"start":39.81,"end":44.01,"text":"nothing can make them stumble."},{"start":44.01,"end":48.21,"text":"I wait for Your salvation, O LORD,"},{"start":48.21,"end":52.41,"text":"and I carry out Your commandments."},{"start":52.41,"end":56.61,"text":"I obey Your testimonies"},{"start":56.61,"end":60.81,"text":"and love them greatly."},{"start":60.81,"end":65.01,"text":"I obey Your precepts and Your testimonies,"},{"start":65.01,"end":69.21,"text":"for all my ways are before You."}]}