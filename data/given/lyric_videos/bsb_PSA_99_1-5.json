{"passage":"Psalm 99:1-5","credit":"Berean Standard Bible","duration":74.000998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.53,"text":"The LORD reigns;"},{"start":6.53,"end":11.07,"text":"let the nations tremble!"},{"start":11.07,"end":15.6,"text":"He is enthroned above the cherubim;"},{"start":15.6,"end":20.13,"text":"let the earth quake!"},{"start":20.13,"end":24.67,"text":"Great is the LORD in Zion;"},{"start":24.67,"end":29.2,"text":"He is exalted above all the peoples."},{"start":29.2,"end":33.73,"text":"Let them praise Your great and awesome name—"},{"start":33.73,"end":38.27,"text":"He is holy!"},{"start":38.27,"end":42.8,"text":"The mighty King loves justice."},{"start":42.8,"end":47.33,"text":"You have established equity;"},{"start":47.33,"end":51.87,"text":"You have exercised justice"},{"start":51.87,"end":56.4,"text":"and righteousness in Jacob."},{"start":56.4,"end":60.93,"text":"Exalt the LORD our God,"},{"start":60.93,"end":65.47,"text":"and worship at His footstool;"},{"start":65.47,"end":70,"text":"He is holy!"}]}