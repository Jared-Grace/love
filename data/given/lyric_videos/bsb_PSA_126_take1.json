{"passage":"Psalm 126","credit":"Berean Standard Bible","duration":85.726009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.69,"text":"A song of ascents."},{"start":6.69,"end":11.38,"text":"When the LORD restored the captives of Zion,"},{"start":11.38,"end":16.07,"text":"we were like dreamers."},{"start":16.07,"end":20.76,"text":"Then our mouths were filled with laughter,"},{"start":20.76,"end":25.45,"text":"our tongues with shouts of joy."},{"start":25.45,"end":30.14,"text":"Then it was said among the nations,"},{"start":30.14,"end":34.83,"text":"“The LORD has done great things for them.”"},{"start":34.83,"end":39.52,"text":"The LORD has done great things for us;"},{"start":39.52,"end":44.21,"text":"we are filled with joy."},{"start":44.21,"end":48.9,"text":"Restore our captives, O LORD,"},{"start":48.9,"end":53.59,"text":"like streams in the Negev."},{"start":53.59,"end":58.28,"text":"Those who sow in tears"},{"start":58.28,"end":62.97,"text":"will reap with shouts of joy."},{"start":62.97,"end":67.66,"text":"He who goes out weeping,"},{"start":67.66,"end":72.35,"text":"bearing a trail of seed,"},{"start":72.35,"end":77.04,"text":"will surely return with shouts of joy,"},{"start":77.04,"end":81.73,"text":"carrying sheaves of grain."}]}