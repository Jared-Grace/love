{"passage":"Psalm 126","credit":"Berean Standard Bible","duration":85.726009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.86,"end":14.55,"text":"A song of ascents."},{"start":14.6,"end":20.63,"text":"When the LORD restored the captives of Zion,"},{"start":20.68,"end":23.65,"text":"we were like dreamers."},{"start":23.7,"end":27.27,"text":"Then our mouths were filled with laughter,"},{"start":27.32,"end":29.75,"text":"our tongues with shouts of joy."},{"start":29.8,"end":33.35,"text":"Then it was said among the nations,"},{"start":33.4,"end":39.39,"text":"“The LORD has done great things for them.”"},{"start":39.44,"end":43.77,"text":"The LORD has done great things for us;"},{"start":43.82,"end":46.83,"text":"we are filled with joy."},{"start":46.88,"end":51.33,"text":"Restore our captives, O LORD,"},{"start":51.38,"end":54.77,"text":"like streams in the Negev."},{"start":54.82,"end":58.61,"text":"Those who sow in tears"},{"start":58.66,"end":63.15,"text":"will reap with shouts of joy."},{"start":63.2,"end":65.42,"text":"He who goes out weeping,"},{"start":65.47,"end":68.06,"text":"bearing a trail of seed,"},{"start":68.11,"end":74.88,"text":"will surely return with shouts of joy,"},{"start":74.93,"end":85.73,"text":"carrying sheaves of grain."}],"times_from":"machine"}