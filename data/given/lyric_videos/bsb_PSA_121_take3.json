{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":92.97,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.12,"text":"A song of ascents."},{"start":7.12,"end":12.23,"text":"I lift up my eyes to the hills."},{"start":12.23,"end":17.35,"text":"From where does my help come?"},{"start":17.35,"end":22.46,"text":"My help comes from the LORD,"},{"start":22.46,"end":27.58,"text":"the Maker of heaven and earth."},{"start":27.58,"end":32.7,"text":"He will not allow your foot to slip;"},{"start":32.7,"end":37.81,"text":"your Protector will not slumber."},{"start":37.81,"end":42.93,"text":"Behold, the Protector of Israel"},{"start":42.93,"end":48.04,"text":"will neither slumber nor sleep."},{"start":48.04,"end":53.16,"text":"The LORD is your keeper;"},{"start":53.16,"end":58.27,"text":"the LORD is the shade on your right hand."},{"start":58.27,"end":63.39,"text":"The sun will not strike you by day,"},{"start":63.39,"end":68.51,"text":"nor the moon by night."},{"start":68.51,"end":73.62,"text":"The LORD will guard you from all evil;"},{"start":73.62,"end":78.74,"text":"He will preserve your soul."},{"start":78.74,"end":83.85,"text":"The LORD will watch over your coming and going,"},{"start":83.85,"end":88.97,"text":"both now and forevermore."}]}