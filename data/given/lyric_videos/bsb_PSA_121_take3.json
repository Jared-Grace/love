{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":92.97,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.54,"end":8.55,"text":"A song of ascents."},{"start":8.6,"end":13.07,"text":"I lift up my eyes to the hills."},{"start":13.12,"end":17.39,"text":"From where does my help come?"},{"start":17.44,"end":21.75,"text":"My help comes from the LORD,"},{"start":21.8,"end":26.05,"text":"the Maker of heaven and earth."},{"start":26.1,"end":30.03,"text":"He will not allow your foot to slip;"},{"start":30.08,"end":34.39,"text":"your Protector will not slumber."},{"start":34.44,"end":42,"text":"Behold, the Protector of Israel"},{"start":42.05,"end":46.72,"text":"will neither slumber nor sleep."},{"start":46.77,"end":48.88,"text":"The LORD is your keeper;"},{"start":48.93,"end":55.5,"text":"the LORD is the shade on your right hand."},{"start":55.55,"end":59.34,"text":"The sun will not strike you by day,"},{"start":59.39,"end":63.38,"text":"nor the moon by night."},{"start":63.43,"end":68.38,"text":"The LORD will guard you from all evil;"},{"start":68.43,"end":72.74,"text":"He will preserve your soul."},{"start":72.79,"end":77.76,"text":"The LORD will watch over your coming and going,"},{"start":77.81,"end":92.97,"text":"both now and forevermore."}],"times_from":"machine"}