{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":92.97,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.16,"end":8.17,"text":"A song of ascents."},{"start":8.22,"end":12.69,"text":"I lift up my eyes to the hills."},{"start":12.74,"end":17.01,"text":"From where does my help come?"},{"start":17.06,"end":21.35,"text":"My help comes from the LORD,"},{"start":21.4,"end":25.67,"text":"the Maker of heaven and earth."},{"start":25.72,"end":29.65,"text":"He will not allow your foot to slip;"},{"start":29.7,"end":34.01,"text":"your Protector will not slumber."},{"start":34.06,"end":41.07,"text":"Behold, the Protector of Israel"},{"start":41.12,"end":46.33,"text":"will neither slumber nor sleep."},{"start":46.38,"end":48.49,"text":"The LORD is your keeper;"},{"start":48.54,"end":55.33,"text":"the LORD is the shade on your right hand."},{"start":55.38,"end":58.95,"text":"The sun will not strike you by day,"},{"start":59,"end":62.99,"text":"nor the moon by night."},{"start":63.04,"end":68,"text":"The LORD will guard you from all evil;"},{"start":68.05,"end":72.36,"text":"He will preserve your soul."},{"start":72.41,"end":77.38,"text":"The LORD will watch over your coming and going,"},{"start":77.43,"end":92.97,"text":"both now and forevermore."}],"times_from":"machine"}