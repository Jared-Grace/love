itignore/lyric_video_pictures/bsb_REV_5/pd_apocalypse_elders_enthroned.png","start":null,"end":null},{"scene":"pending","name":"pd_dore_the_heavenly_host","line":44,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_dore_the_heavenly_host.png","start":null,"end":null},{"scene":"pending","name":"pd_van_eyck_the_adoration_of_the_lamb","line":46,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_van_eyck_the_adoration_of_the_lamb.png","start":null,"end":null},{"scene":"pending","name":"pd_angelico_lof","line":48,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_angelico_lof.png","start":null,"end":null},{"scene":"pending","name":"pd_tintoretto_animals","line":50,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_tintoretto_animals.png","start":null,"end":null},{"scene":"pending","name":"pd_deesis_pantocrator","line":52,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_deesis_pantocrator.png","start":null,"end":null},{"scene":"pending","name":"pd_durer_the_adoration_of_the_trinity","line":54,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_durer_the_adoration_of_the_trinity.png","start":null,"end":null},{"scene":"pending","name":"pd_apocalypse_elders_pay_homage","line":56,"path":"gitignore/lyric_video_pictures/bsb_REV_5/pd_apocalypse_elders_pay_homage.png","start":null}],"lines":[{"text":"Then I saw a scroll in the right hand"},{"text":"of the One seated on the throne."},{"text":"It had writing on both sides"},{"text":"and was sealed with seven seals."},{"text":"And I saw a mighty angel proclaiming in a loud voice,"},{"text":"Who is worthy to break the seals"},{"text":"and open the scroll?"},{"text":"But no one in heaven or on earth"},{"text":"or under the earth was able to open the scroll"},{"text":"or look inside it."},{"text":"And I began to weep bitterly,"},{"text":"because no one was found worthy"},{"text":"to open the scroll or look inside it."},{"text":"Then one of the elders said to me,"},{"text":"Do not weep!"},{"text":"Behold, the Lion of the tribe of Judah,"},{"text":"the Root of David, has triumphed"},{"text":"to open the scroll and its seven seals."},{"text":"Then I saw a Lamb who appeared to have been slain,"},{"text":"standing in the center of the throne,"},{"text":"encircled by the four living creatures and the elders."},{"text":"The Lamb had seven horns and seven eyes,"},{"text":"which represent the seven Spirits of God"},{"text":"sent out into all the earth."},{"text":"And He came and took the scroll"},{"text":"from the right hand of the One seated on the throne."},{"text":"When He had taken the scroll,"},{"text":"the four living creatures and the twenty-four elders"},{"text":"fell down before the Lamb."},{"text":"Each one had a harp,"},{"text":"and they were holding golden bowls full of incense,"},{"text":"which are the prayers of the saints."},{"text":"And they sang a new song:"},{"text":"Worthy are You to take the scroll and open its seals,"},{"text":"because You were slain,"},{"text":"and by Your blood You purchased for God"},{"text":"those from every tribe and tongue"},{"text":"and people and nation."},{"text":"You have made them to be a kingdom"},{"text":"and priests to serve our God,"},{"text":"and they will reign upon the earth."},{"text":"Then I looked, and I heard the voices of many angels"},{"text":"and living creatures and elders encircling the throne,"},{"text":"and their number was myriads of myriads"},{"text":"and thousands of thousands."},{"text":"In a loud voice they were saying:"},{"text":"Worthy is the Lamb, who was slain,"},{"text":"to receive power and riches"},{"text":"and wisdom and strength"},{"text":"and honor and glory and blessing!"},{"text":"And I heard every creature in heaven and on earth"},{"text":"and under the earth and in the sea,"},{"text":"and all that is in them, saying:"},{"text":"To Him who sits on the throne and to the Lamb"},{"text":"be praise and honor and glory and power"},{"text":"forever and ever!"},{"text":"And the four living creatures said, Amen,"},{"text":"and the elders fell down and worshiped."}]}
