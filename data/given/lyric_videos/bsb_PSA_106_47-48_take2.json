{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":55.502993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.19,"text":"Save us, O LORD our God,"},{"start":8.19,"end":14.38,"text":"and gather us from the nations,"},{"start":14.38,"end":20.56,"text":"that we may give thanks to Your holy name,"},{"start":20.56,"end":26.75,"text":"that we may glory in Your praise."},{"start":26.75,"end":32.94,"text":"Blessed be the LORD, the God of Israel,"},{"start":32.94,"end":39.13,"text":"from everlasting to everlasting."},{"start":39.13,"end":45.32,"text":"Let all the people say, “Amen!”"},{"start":45.32,"end":51.5,"text":"Hallelujah!"}]}