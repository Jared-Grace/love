{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":55.502993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.66,"end":10.88,"text":"Save us, O LORD our God,"},{"start":10.93,"end":15,"text":"and gather us from the nations,"},{"start":15.05,"end":19.2,"text":"that we may give thanks to Your holy name,"},{"start":19.25,"end":24.18,"text":"that we may glory in Your praise."},{"start":24.23,"end":28.5,"text":"Blessed be the LORD, the God of Israel,"},{"start":28.55,"end":32.22,"text":"from everlasting to everlasting."},{"start":32.27,"end":49.97,"text":"Let all the people say, “Amen!”"},{"start":50.02,"end":55.5,"text":"Hallelujah!"}],"times_from":"machine"}