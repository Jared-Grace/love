{"passage":"Psalm 102:19-22","credit":"Berean Standard Bible","duration":52.793991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.85,"text":"For He looked down from the heights of His sanctuary;"},{"start":7.85,"end":13.7,"text":"the LORD gazed out from heaven to earth"},{"start":13.7,"end":19.55,"text":"to hear a prisoner’s groaning,"},{"start":19.55,"end":25.4,"text":"to release those condemned to death,"},{"start":25.4,"end":31.25,"text":"that they may proclaim the name of the LORD in Zion"},{"start":31.25,"end":37.1,"text":"and praise Him in Jerusalem,"},{"start":37.1,"end":42.94,"text":"when peoples and kingdoms assemble"},{"start":42.94,"end":48.79,"text":"to serve the LORD."}]}