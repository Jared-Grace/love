{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":47.851995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.48,"end":12.21,"text":"Save us, O LORD our God,"},{"start":12.26,"end":16.33,"text":"and gather us from the nations,"},{"start":16.38,"end":21.28,"text":"that we may give thanks to Your holy name,"},{"start":21.33,"end":28.54,"text":"that we may glory in Your praise."},{"start":28.59,"end":32.72,"text":"Blessed be the LORD, the God of Israel,"},{"start":32.77,"end":37.32,"text":"from everlasting to everlasting."},{"start":37.37,"end":45.8,"text":"Let all the people say, “Amen!”"},{"start":45.85,"end":47.85,"text":"Hallelujah!"}],"times_from":"machine"}