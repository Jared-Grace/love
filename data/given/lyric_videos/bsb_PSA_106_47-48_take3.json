{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":47.851995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.23,"text":"Save us, O LORD our God,"},{"start":7.23,"end":12.46,"text":"and gather us from the nations,"},{"start":12.46,"end":17.69,"text":"that we may give thanks to Your holy name,"},{"start":17.69,"end":22.93,"text":"that we may glory in Your praise."},{"start":22.93,"end":28.16,"text":"Blessed be the LORD, the God of Israel,"},{"start":28.16,"end":33.39,"text":"from everlasting to everlasting."},{"start":33.39,"end":38.62,"text":"Let all the people say, “Amen!”"},{"start":38.62,"end":43.85,"text":"Hallelujah!"}]}