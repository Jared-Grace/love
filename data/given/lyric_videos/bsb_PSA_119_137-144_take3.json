{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":90.626009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":5.24,"end":11.25,"text":"Righteous are You, O LORD,"},{"start":11.3,"end":15.33,"text":"and upright are Your judgments."},{"start":15.38,"end":22.07,"text":"The testimonies You have laid down are righteous"},{"start":22.12,"end":30.57,"text":"and altogether faithful."},{"start":30.62,"end":35.95,"text":"My zeal has consumed me"},{"start":36,"end":42.61,"text":"because my foes forget Your words."},{"start":42.66,"end":46.81,"text":"Your promise is completely pure;"},{"start":46.86,"end":51.15,"text":"therefore Your servant loves it."},{"start":51.2,"end":53.05,"text":"I am lowly and despised,"},{"start":53.1,"end":62.63,"text":"but I do not forget Your precepts."},{"start":62.68,"end":66.93,"text":"Your righteousness is everlasting"},{"start":66.98,"end":69.72,"text":"and Your law is true."},{"start":69.77,"end":73.06,"text":"Trouble and distress have found me,"},{"start":73.11,"end":76.6,"text":"but Your commandments are my delight."},{"start":76.65,"end":80.98,"text":"Your testimonies are righteous forever."},{"start":81.03,"end":90.63,"text":"Give me understanding, that I may live."}],"times_from":"machine"}