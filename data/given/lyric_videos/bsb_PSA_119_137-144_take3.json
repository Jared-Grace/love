{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":90.626009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.29,"text":"Righteous are You, O LORD,"},{"start":7.29,"end":12.58,"text":"and upright are Your judgments."},{"start":12.58,"end":17.87,"text":"The testimonies You have laid down are righteous"},{"start":17.87,"end":23.16,"text":"and altogether faithful."},{"start":23.16,"end":28.45,"text":"My zeal has consumed me"},{"start":28.45,"end":33.73,"text":"because my foes forget Your words."},{"start":33.73,"end":39.02,"text":"Your promise is completely pure;"},{"start":39.02,"end":44.31,"text":"therefore Your servant loves it."},{"start":44.31,"end":49.6,"text":"I am lowly and despised,"},{"start":49.6,"end":54.89,"text":"but I do not forget Your precepts."},{"start":54.89,"end":60.18,"text":"Your righteousness is everlasting"},{"start":60.18,"end":65.47,"text":"and Your law is true."},{"start":65.47,"end":70.76,"text":"Trouble and distress have found me,"},{"start":70.76,"end":76.05,"text":"but Your commandments are my delight."},{"start":76.05,"end":81.34,"text":"Your testimonies are righteous forever."},{"start":81.34,"end":86.63,"text":"Give me understanding, that I may live."}]}