{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":89.383991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.96,"text":"A Psalm of thanksgiving."},{"start":7.96,"end":13.91,"text":"Make a joyful noise to the LORD,"},{"start":13.91,"end":19.87,"text":"all the earth."},{"start":19.87,"end":25.82,"text":"Serve the LORD with gladness;"},{"start":25.82,"end":31.78,"text":"come into His presence with joyful songs."},{"start":31.78,"end":37.74,"text":"Know that the LORD is God."},{"start":37.74,"end":43.69,"text":"It is He who made us, and we are His;"},{"start":43.69,"end":49.65,"text":"we are His people, and the sheep of His pasture."},{"start":49.65,"end":55.6,"text":"Enter His gates with thanksgiving"},{"start":55.6,"end":61.56,"text":"and His courts with praise;"},{"start":61.56,"end":67.52,"text":"give thanks to Him and bless His name."},{"start":67.52,"end":73.47,"text":"For the LORD is good,"},{"start":73.47,"end":79.43,"text":"and His loving devotion endures forever;"},{"start":79.43,"end":85.38,"text":"His faithfulness continues to all generations."}]}