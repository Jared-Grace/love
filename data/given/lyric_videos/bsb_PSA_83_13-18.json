{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":54.513991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.73,"text":"Make them like tumbleweed, O my God,"},{"start":5.73,"end":9.46,"text":"like chaff before the wind."},{"start":9.46,"end":13.2,"text":"As fire consumes a forest,"},{"start":13.2,"end":16.93,"text":"as a flame sets the mountains ablaze,"},{"start":16.93,"end":20.66,"text":"so pursue them with Your tempest,"},{"start":20.66,"end":24.39,"text":"and terrify them with Your storm."},{"start":24.39,"end":28.12,"text":"Cover their faces with shame,"},{"start":28.12,"end":31.85,"text":"that they may seek Your name, O LORD."},{"start":31.85,"end":35.59,"text":"May they be ever ashamed and terrified;"},{"start":35.59,"end":39.32,"text":"may they perish in disgrace."},{"start":39.32,"end":43.05,"text":"May they know that You alone,"},{"start":43.05,"end":46.78,"text":"whose name is the LORD,"},{"start":46.78,"end":50.51,"text":"are Most High over all the earth."}]}