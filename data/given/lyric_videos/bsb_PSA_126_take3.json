{"passage":"Psalm 126","credit":"Berean Standard Bible","duration":111.830998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.23,"text":"A song of ascents."},{"start":8.23,"end":14.45,"text":"When the LORD restored the captives of Zion,"},{"start":14.45,"end":20.68,"text":"we were like dreamers."},{"start":20.68,"end":26.9,"text":"Then our mouths were filled with laughter,"},{"start":26.9,"end":33.13,"text":"our tongues with shouts of joy."},{"start":33.13,"end":39.35,"text":"Then it was said among the nations,"},{"start":39.35,"end":45.58,"text":"“The LORD has done great things for them.”"},{"start":45.58,"end":51.8,"text":"The LORD has done great things for us;"},{"start":51.8,"end":58.03,"text":"we are filled with joy."},{"start":58.03,"end":64.25,"text":"Restore our captives, O LORD,"},{"start":64.25,"end":70.48,"text":"like streams in the Negev."},{"start":70.48,"end":76.7,"text":"Those who sow in tears"},{"start":76.7,"end":82.93,"text":"will reap with shouts of joy."},{"start":82.93,"end":89.15,"text":"He who goes out weeping,"},{"start":89.15,"end":95.38,"text":"bearing a trail of seed,"},{"start":95.38,"end":101.61,"text":"will surely return with shouts of joy,"},{"start":101.61,"end":107.83,"text":"carrying sheaves of grain."}]}