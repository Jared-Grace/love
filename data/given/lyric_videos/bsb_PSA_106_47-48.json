{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":45.226009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.9,"text":"Save us, O LORD our God,"},{"start":6.9,"end":11.81,"text":"and gather us from the nations,"},{"start":11.81,"end":16.71,"text":"that we may give thanks to Your holy name,"},{"start":16.71,"end":21.61,"text":"that we may glory in Your praise."},{"start":21.61,"end":26.52,"text":"Blessed be the LORD, the God of Israel,"},{"start":26.52,"end":31.42,"text":"from everlasting to everlasting."},{"start":31.42,"end":36.32,"text":"Let all the people say, “Amen!”"},{"start":36.32,"end":41.23,"text":"Hallelujah!"}]}