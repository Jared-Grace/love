{"passage":"Psalm 106:47-48","credit":"Berean Standard Bible","duration":45.226009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.02,"end":8.59,"text":"Save us, O LORD our God,"},{"start":8.64,"end":13.27,"text":"and gather us from the nations,"},{"start":13.32,"end":18.11,"text":"that we may give thanks to Your holy name,"},{"start":18.16,"end":23.33,"text":"that we may glory in Your praise."},{"start":23.38,"end":30.99,"text":"Blessed be the LORD, the God of Israel,"},{"start":31.04,"end":36.24,"text":"from everlasting to everlasting."},{"start":36.28,"end":42.96,"text":"Let all the people say, “Amen!”"},{"start":43.01,"end":45.23,"text":"Hallelujah!"}],"times_from":"machine"}