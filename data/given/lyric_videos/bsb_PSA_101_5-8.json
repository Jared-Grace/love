{"passage":"Psalm 101:5-8","credit":"Berean Standard Bible","duration":53.721995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.41,"text":"Whoever slanders his neighbor in secret,"},{"start":5.41,"end":8.82,"text":"I will put to silence;"},{"start":8.82,"end":12.23,"text":"the one with haughty eyes and a proud heart,"},{"start":12.23,"end":15.63,"text":"I will not endure."},{"start":15.63,"end":19.04,"text":"My eyes favor the faithful of the land,"},{"start":19.04,"end":22.45,"text":"that they may dwell with me;"},{"start":22.45,"end":25.86,"text":"he who walks in the way of integrity"},{"start":25.86,"end":29.27,"text":"shall minister to me."},{"start":29.27,"end":32.68,"text":"No one who practices deceit"},{"start":32.68,"end":36.09,"text":"shall dwell in my house;"},{"start":36.09,"end":39.5,"text":"no one who tells lies"},{"start":39.5,"end":42.9,"text":"shall stand in my presence."},{"start":42.9,"end":46.31,"text":"Every morning I will remove all the wicked of the land,"},{"start":46.31,"end":49.72,"text":"that I may cut off every evildoer from the city of the LORD."}]}