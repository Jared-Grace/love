{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":94.26,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.42,"end":8.51,"text":"A song of ascents."},{"start":8.56,"end":13.99,"text":"In my distress I cried to the LORD,"},{"start":14.04,"end":19.23,"text":"and He answered me."},{"start":19.28,"end":23.38,"text":"Deliver my soul, O LORD,"},{"start":23.43,"end":29.68,"text":"from lying lips and a deceitful tongue."},{"start":29.73,"end":33.28,"text":"What will He do to you,"},{"start":33.33,"end":36.96,"text":"and what will be added to you,"},{"start":37.01,"end":40.92,"text":"O deceitful tongue?"},{"start":40.97,"end":49.26,"text":"Sharp arrows will come from the warrior,"},{"start":49.31,"end":54.64,"text":"with burning coals of the broom tree!"},{"start":54.69,"end":59.26,"text":"Woe to me that I dwell in Meshech,"},{"start":59.31,"end":62.18,"text":"that I live among the tents of Kedar!"},{"start":62.23,"end":66.58,"text":"Too long have I dwelt"},{"start":66.63,"end":69.57,"text":"among those who hate peace."},{"start":69.61,"end":73.45,"text":"I am in favor of peace;"},{"start":73.5,"end":94.26,"text":"but when I speak, they want war."}],"times_from":"machine"}