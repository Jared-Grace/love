{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":94.26,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.52,"text":"A song of ascents."},{"start":7.52,"end":13.03,"text":"In my distress I cried to the LORD,"},{"start":13.03,"end":18.55,"text":"and He answered me."},{"start":18.55,"end":24.07,"text":"Deliver my soul, O LORD,"},{"start":24.07,"end":29.58,"text":"from lying lips and a deceitful tongue."},{"start":29.58,"end":35.1,"text":"What will He do to you,"},{"start":35.1,"end":40.61,"text":"and what will be added to you,"},{"start":40.61,"end":46.13,"text":"O deceitful tongue?"},{"start":46.13,"end":51.65,"text":"Sharp arrows will come from the warrior,"},{"start":51.65,"end":57.16,"text":"with burning coals of the broom tree!"},{"start":57.16,"end":62.68,"text":"Woe to me that I dwell in Meshech,"},{"start":62.68,"end":68.2,"text":"that I live among the tents of Kedar!"},{"start":68.2,"end":73.71,"text":"Too long have I dwelt"},{"start":73.71,"end":79.23,"text":"among those who hate peace."},{"start":79.23,"end":84.74,"text":"I am in favor of peace;"},{"start":84.74,"end":90.26,"text":"but when I speak, they want war."}]}