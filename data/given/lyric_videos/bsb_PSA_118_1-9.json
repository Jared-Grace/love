{"passage":"Psalm 118:1-9","credit":"Berean Standard Bible","duration":92.229002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.4,"end":8.05,"text":"Give thanks to the LORD, for He is good;"},{"start":8.1,"end":12.93,"text":"His loving devotion endures forever."},{"start":12.98,"end":15.25,"text":"Let Israel say,"},{"start":15.3,"end":21.63,"text":"“His loving devotion endures forever.”"},{"start":21.68,"end":24.45,"text":"Let the house of Aaron say,"},{"start":24.5,"end":30.87,"text":"“His loving devotion endures forever.”"},{"start":30.92,"end":33.83,"text":"Let those who fear the LORD say,"},{"start":33.88,"end":41.33,"text":"“His loving devotion endures forever.”"},{"start":41.38,"end":45.55,"text":"In my distress I called to the LORD,"},{"start":45.6,"end":50.12,"text":"and He answered and set me free."},{"start":50.17,"end":55.18,"text":"The LORD is on my side; I will not be afraid."},{"start":55.23,"end":56.88,"text":"What can man do to me?"},{"start":56.93,"end":63.38,"text":"The LORD is on my side; He is my helper."},{"start":63.43,"end":72.12,"text":"Therefore I will look in triumph on those who hate me."},{"start":72.17,"end":75.84,"text":"It is better to take refuge in the LORD"},{"start":75.89,"end":80,"text":"than to trust in man."},{"start":80.05,"end":84.02,"text":"It is better to take refuge in the LORD"},{"start":84.07,"end":92.23,"text":"than to trust in princes."}],"times_from":"machine"}