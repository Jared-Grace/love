{"passage":"Psalm 118:1-9","credit":"Berean Standard Bible","duration":92.229002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.79,"text":"Give thanks to the LORD, for He is good;"},{"start":6.79,"end":11.58,"text":"His loving devotion endures forever."},{"start":11.58,"end":16.37,"text":"Let Israel say,"},{"start":16.37,"end":21.16,"text":"“His loving devotion endures forever.”"},{"start":21.16,"end":25.95,"text":"Let the house of Aaron say,"},{"start":25.95,"end":30.74,"text":"“His loving devotion endures forever.”"},{"start":30.74,"end":35.53,"text":"Let those who fear the LORD say,"},{"start":35.53,"end":40.32,"text":"“His loving devotion endures forever.”"},{"start":40.32,"end":45.11,"text":"In my distress I called to the LORD,"},{"start":45.11,"end":49.91,"text":"and He answered and set me free."},{"start":49.91,"end":54.7,"text":"The LORD is on my side; I will not be afraid."},{"start":54.7,"end":59.49,"text":"What can man do to me?"},{"start":59.49,"end":64.28,"text":"The LORD is on my side; He is my helper."},{"start":64.28,"end":69.07,"text":"Therefore I will look in triumph on those who hate me."},{"start":69.07,"end":73.86,"text":"It is better to take refuge in the LORD"},{"start":73.86,"end":78.65,"text":"than to trust in man."},{"start":78.65,"end":83.44,"text":"It is better to take refuge in the LORD"},{"start":83.44,"end":88.23,"text":"than to trust in princes."}]}