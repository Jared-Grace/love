{"passage":"Psalm 90:1-6","credit":"Berean Standard Bible","duration":69.078005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.94,"text":"A prayer of Moses the man of God."},{"start":5.94,"end":9.88,"text":"Lord, You have been our dwelling place"},{"start":9.88,"end":13.83,"text":"through all generations."},{"start":13.83,"end":17.77,"text":"Before the mountains were born"},{"start":17.77,"end":21.71,"text":"or You brought forth the earth and the world,"},{"start":21.71,"end":25.65,"text":"from everlasting to everlasting"},{"start":25.65,"end":29.6,"text":"You are God."},{"start":29.6,"end":33.54,"text":"You return man to dust,"},{"start":33.54,"end":37.48,"text":"saying, “Return, O sons of mortals.”"},{"start":37.48,"end":41.42,"text":"For in Your sight a thousand years"},{"start":41.42,"end":45.37,"text":"are but a day that passes,"},{"start":45.37,"end":49.31,"text":"or a watch of the night."},{"start":49.31,"end":53.25,"text":"You sweep them away in their sleep;"},{"start":53.25,"end":57.19,"text":"they are like the new grass of the morning—"},{"start":57.19,"end":61.14,"text":"in the morning it springs up new,"},{"start":61.14,"end":65.08,"text":"but by evening it fades and withers."}]}