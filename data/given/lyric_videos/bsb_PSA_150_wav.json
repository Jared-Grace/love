{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":63.690998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.44,"text":"Hallelujah!"},{"start":6.44,"end":10.88,"text":"Praise God in His sanctuary."},{"start":10.88,"end":15.31,"text":"Praise Him in His mighty heavens."},{"start":15.31,"end":19.75,"text":"Praise Him for His mighty acts;"},{"start":19.75,"end":24.19,"text":"praise Him for His excellent greatness."},{"start":24.19,"end":28.63,"text":"Praise Him with the sound of the horn;"},{"start":28.63,"end":33.06,"text":"praise Him with the harp and lyre."},{"start":33.06,"end":37.5,"text":"Praise Him with tambourine and dancing;"},{"start":37.5,"end":41.94,"text":"praise Him with strings and flute."},{"start":41.94,"end":46.38,"text":"Praise Him with clashing cymbals;"},{"start":46.38,"end":50.82,"text":"praise Him with resounding cymbals."},{"start":50.82,"end":55.25,"text":"Let everything that has breath praise the LORD!"},{"start":55.25,"end":59.69,"text":"Hallelujah!"}]}