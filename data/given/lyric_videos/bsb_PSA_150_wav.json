{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":63.690998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.72,"end":8.11,"text":"Hallelujah!"},{"start":8.16,"end":11.57,"text":"Praise God in His sanctuary."},{"start":11.62,"end":14.97,"text":"Praise Him in His mighty heavens."},{"start":15.02,"end":18.41,"text":"Praise Him for His mighty acts;"},{"start":18.46,"end":24.43,"text":"praise Him for His excellent greatness."},{"start":24.48,"end":27.84,"text":"Praise Him with the sound of the horn;"},{"start":27.89,"end":31.28,"text":"praise Him with the harp and lyre."},{"start":31.33,"end":34.72,"text":"Praise Him with tambourine and dancing;"},{"start":34.77,"end":38.12,"text":"praise Him with strings and flute."},{"start":38.17,"end":41.56,"text":"Praise Him with clashing cymbals;"},{"start":41.61,"end":44.1,"text":"praise Him with resounding cymbals."},{"start":44.15,"end":50.16,"text":"Let everything that has breath praise the LORD!"},{"start":50.21,"end":63.69,"text":"Hallelujah!"}],"times_from":"machine"}