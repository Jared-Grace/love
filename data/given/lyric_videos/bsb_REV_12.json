nding","name":"pd_church_twilight_in_the_wilderness","line":42,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_church_twilight_in_the_wilderness.png","start":null,"end":null},{"scene":"pending","name":"pd_liljefors_sea_eagles","line":44,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_liljefors_sea_eagles.png","start":null,"end":null},{"scene":"pending","name":"pd_gerard_david_rest_on_the_flight_into_egypt","line":46,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_gerard_david_rest_on_the_flight_into_egypt.png","start":null,"end":null},{"scene":"pending","name":"pd_de_la_corte_the_israelites_crossing_the_red_sea","line":48,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_de_la_corte_the_israelites_crossing_the_red_sea.png","start":null,"end":null},{"scene":"pending","name":"pd_danby_avon_gorge_at_sunset","line":50,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_danby_avon_gorge_at_sunset.png","start":null,"end":null},{"scene":"pending","name":"pd_van_schrieck_serpents_and_insects","line":52,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_van_schrieck_serpents_and_insects.png","start":null,"end":null},{"scene":"pending","name":"pd_van_eyck_the_holy_virgins","line":54,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_van_eyck_the_holy_virgins.png","start":null,"end":null},{"scene":"pending","name":"pd_friedrich_monk_by_the_sea","line":56,"path":"gitignore/lyric_video_pictures/bsb_REV_12/pd_friedrich_monk_by_the_sea.png","start":null}],"lines":[{"text":"And a great sign appeared in heaven:"},{"text":"a woman clothed in the sun,"},{"text":"with the moon under her feet"},{"text":"and a crown of twelve stars on her head."},{"text":"She was pregnant and crying out"},{"text":"in the pain and agony of giving birth."},{"text":"Then another sign appeared in heaven:"},{"text":"a huge red dragon with seven heads,"},{"text":"ten horns, and seven royal crowns on his heads."},{"text":"His tail swept a third of the stars from the sky,"},{"text":"tossing them to the earth."},{"text":"And the dragon stood before the woman who was about to give birth,"},{"text":"ready to devour her child as soon as she gave birth."},{"text":"And she gave birth to a son, a male child,"},{"text":"who will rule all the nations with an iron scepter."},{"text":"And her child was caught up to God and to His throne."},{"text":"And the woman fled into the wilderness,"},{"text":"where God had prepared a place for her"},{"text":"to be nourished for 1,260 days."},{"text":"Then a war broke out in heaven:"},{"text":"Michael and his angels fought against the dragon,"},{"text":"and the dragon and his angels fought back."},{"text":"But the dragon was not strong enough,"},{"text":"and no longer was any place found in heaven for him and his angels."},{"text":"And the great dragon was hurled down,"},{"text":"that ancient serpent called the devil and Satan,"},{"text":"the deceiver of the whole world."},{"text":"He was hurled to the earth, and his angels with him."},{"text":"And I heard a loud voice in heaven saying:"},{"text":"Now have come the salvation and the power"},{"text":"and the kingdom of our God,"},{"text":"and the authority of His Christ."},{"text":"For the accuser of our brothers has been thrown down,"},{"text":"he who accuses them day and night before our God."},{"text":"They have conquered him by the blood of the Lamb"},{"text":"and by the word of their testimony."},{"text":"And they did not love their lives"},{"text":"so as to shy away from death."},{"text":"Therefore rejoice, O heavens,"},{"text":"and you who dwell in them!"},{"text":"But woe to the earth and the sea;"},{"text":"with great fury the devil has come down to you,"},{"text":"knowing he has only a short time."},{"text":"And when the dragon saw that he had been thrown to the earth,"},{"text":"he pursued the woman who had given birth to the male child."},{"text":"But the woman was given two wings of a great eagle"},{"text":"to fly from the presence of the serpent to her place in the wilderness,"},{"text":"where she was nourished for a time, and times, and half a time."},{"text":"Then from the mouth of the serpent spewed water like a river"},{"text":"to overtake the woman and sweep her away in the torrent."},{"text":"But the earth helped the woman"},{"text":"and opened its mouth to swallow up the river"},{"text":"that had poured from the dragon's mouth."},{"text":"And the dragon was enraged at the woman,"},{"text":"and went to make war with the rest of her children,"},{"text":"who keep the commandments of God"},{"text":"and hold to the testimony of Jesus."},{"text":"And the dragon stood on the shore of the sea."}]}
