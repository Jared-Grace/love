{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":74.682993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.29,"text":"When Israel departed from Egypt,"},{"start":6.29,"end":10.59,"text":"the house of Jacob from a people of foreign tongue,"},{"start":10.59,"end":14.88,"text":"Judah became God’s sanctuary,"},{"start":14.88,"end":19.17,"text":"Israel His dominion."},{"start":19.17,"end":23.46,"text":"The sea observed and fled;"},{"start":23.46,"end":27.76,"text":"the Jordan turned back;"},{"start":27.76,"end":32.05,"text":"the mountains skipped like rams,"},{"start":32.05,"end":36.34,"text":"the hills like lambs."},{"start":36.34,"end":40.63,"text":"Why was it, O sea, that you fled,"},{"start":40.63,"end":44.93,"text":"O Jordan, that you turned back,"},{"start":44.93,"end":49.22,"text":"O mountains, that you skipped like rams,"},{"start":49.22,"end":53.51,"text":"O hills, like lambs?"},{"start":53.51,"end":57.8,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":57.8,"end":62.1,"text":"at the presence of the God of Jacob,"},{"start":62.1,"end":66.39,"text":"who turned the rock into a pool,"},{"start":66.39,"end":70.68,"text":"the flint into a fountain of water!"}]}