{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":74.682993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.3,"end":7.67,"text":"When Israel departed from Egypt,"},{"start":7.72,"end":11.61,"text":"the house of Jacob from a people of foreign tongue,"},{"start":11.66,"end":16.29,"text":"Judah became God’s sanctuary,"},{"start":16.35,"end":21.54,"text":"Israel His dominion."},{"start":21.59,"end":24.92,"text":"The sea observed and fled;"},{"start":24.97,"end":27.2,"text":"the Jordan turned back;"},{"start":27.25,"end":29.98,"text":"the mountains skipped like rams,"},{"start":30.03,"end":33.72,"text":"the hills like lambs."},{"start":33.77,"end":37.38,"text":"Why was it, O sea, that you fled,"},{"start":37.43,"end":40.58,"text":"O Jordan, that you turned back,"},{"start":40.63,"end":43.98,"text":"O mountains, that you skipped like rams,"},{"start":44.03,"end":49.13,"text":"O hills, like lambs?"},{"start":49.18,"end":57.27,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":57.32,"end":61.89,"text":"at the presence of the God of Jacob,"},{"start":61.94,"end":65.63,"text":"who turned the rock into a pool,"},{"start":65.68,"end":74.68,"text":"the flint into a fountain of water!"}],"times_from":"machine"}