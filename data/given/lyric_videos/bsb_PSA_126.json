{"passage":"Psalm 126","credit":"Berean Standard Bible","duration":85.611995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.96,"end":7.53,"text":"A song of ascents."},{"start":7.58,"end":14.09,"text":"When the LORD restored the captives of Zion,"},{"start":14.14,"end":17.81,"text":"we were like dreamers."},{"start":17.86,"end":23.65,"text":"Then our mouths were filled with laughter,"},{"start":23.7,"end":27.65,"text":"our tongues with shouts of joy."},{"start":27.7,"end":33.38,"text":"Then it was said among the nations,"},{"start":33.42,"end":38.32,"text":"“The LORD has done great things for them.”"},{"start":38.37,"end":42.84,"text":"The LORD has done great things for us;"},{"start":42.89,"end":47.1,"text":"we are filled with joy."},{"start":47.15,"end":52.34,"text":"Restore our captives, O LORD,"},{"start":52.39,"end":57.2,"text":"like streams in the Negev."},{"start":57.25,"end":59.28,"text":"Those who sow in tears"},{"start":59.33,"end":62.56,"text":"will reap with shouts of joy."},{"start":62.61,"end":65.84,"text":"He who goes out weeping,"},{"start":65.89,"end":70.34,"text":"bearing a trail of seed,"},{"start":70.39,"end":77.14,"text":"will surely return with shouts of joy,"},{"start":77.19,"end":85.61,"text":"carrying sheaves of grain."}],"times_from":"machine"}