{"passage":"Psalm 126","credit":"Berean Standard Bible","duration":85.611995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.68,"text":"A song of ascents."},{"start":6.68,"end":11.37,"text":"When the LORD restored the captives of Zion,"},{"start":11.37,"end":16.05,"text":"we were like dreamers."},{"start":16.05,"end":20.73,"text":"Then our mouths were filled with laughter,"},{"start":20.73,"end":25.42,"text":"our tongues with shouts of joy."},{"start":25.42,"end":30.1,"text":"Then it was said among the nations,"},{"start":30.1,"end":34.78,"text":"“The LORD has done great things for them.”"},{"start":34.78,"end":39.46,"text":"The LORD has done great things for us;"},{"start":39.46,"end":44.15,"text":"we are filled with joy."},{"start":44.15,"end":48.83,"text":"Restore our captives, O LORD,"},{"start":48.83,"end":53.51,"text":"like streams in the Negev."},{"start":53.51,"end":58.2,"text":"Those who sow in tears"},{"start":58.2,"end":62.88,"text":"will reap with shouts of joy."},{"start":62.88,"end":67.56,"text":"He who goes out weeping,"},{"start":67.56,"end":72.25,"text":"bearing a trail of seed,"},{"start":72.25,"end":76.93,"text":"will surely return with shouts of joy,"},{"start":76.93,"end":81.61,"text":"carrying sheaves of grain."}]}