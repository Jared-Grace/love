{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":95.301995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.25,"text":"A song of ascents."},{"start":7.25,"end":12.51,"text":"I lift up my eyes to the hills."},{"start":12.51,"end":17.76,"text":"From where does my help come?"},{"start":17.76,"end":23.01,"text":"My help comes from the LORD,"},{"start":23.01,"end":28.27,"text":"the Maker of heaven and earth."},{"start":28.27,"end":33.52,"text":"He will not allow your foot to slip;"},{"start":33.52,"end":38.77,"text":"your Protector will not slumber."},{"start":38.77,"end":44.02,"text":"Behold, the Protector of Israel"},{"start":44.02,"end":49.28,"text":"will neither slumber nor sleep."},{"start":49.28,"end":54.53,"text":"The LORD is your keeper;"},{"start":54.53,"end":59.78,"text":"the LORD is the shade on your right hand."},{"start":59.78,"end":65.04,"text":"The sun will not strike you by day,"},{"start":65.04,"end":70.29,"text":"nor the moon by night."},{"start":70.29,"end":75.54,"text":"The LORD will guard you from all evil;"},{"start":75.54,"end":80.8,"text":"He will preserve your soul."},{"start":80.8,"end":86.05,"text":"The LORD will watch over your coming and going,"},{"start":86.05,"end":91.3,"text":"both now and forevermore."}]}