{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":95.301995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.02,"end":7.37,"text":"A song of ascents."},{"start":7.42,"end":11.39,"text":"I lift up my eyes to the hills."},{"start":11.44,"end":15.61,"text":"From where does my help come?"},{"start":15.66,"end":19.88,"text":"My help comes from the LORD,"},{"start":19.93,"end":24.14,"text":"the Maker of heaven and earth."},{"start":24.19,"end":28.68,"text":"He will not allow your foot to slip;"},{"start":28.73,"end":33.66,"text":"your Protector will not slumber."},{"start":33.71,"end":41.8,"text":"Behold, the Protector of Israel"},{"start":41.85,"end":45.32,"text":"will neither slumber nor sleep."},{"start":45.37,"end":48.48,"text":"The LORD is your keeper;"},{"start":48.53,"end":53.76,"text":"the LORD is the shade on your right hand."},{"start":53.81,"end":58.36,"text":"The sun will not strike you by day,"},{"start":58.41,"end":62.44,"text":"nor the moon by night."},{"start":62.49,"end":67.21,"text":"The LORD will guard you from all evil;"},{"start":67.26,"end":70.01,"text":"He will preserve your soul."},{"start":70.06,"end":82.37,"text":"The LORD will watch over your coming and going,"},{"start":82.42,"end":95.3,"text":"both now and forevermore."}],"times_from":"machine"}