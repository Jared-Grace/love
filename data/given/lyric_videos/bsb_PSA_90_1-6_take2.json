{"passage":"Psalm 90:1-6","credit":"Berean Standard Bible","duration":75.803991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.36,"text":"A prayer of Moses the man of God."},{"start":6.36,"end":10.73,"text":"Lord, You have been our dwelling place"},{"start":10.73,"end":15.09,"text":"through all generations."},{"start":15.09,"end":19.45,"text":"Before the mountains were born"},{"start":19.45,"end":23.81,"text":"or You brought forth the earth and the world,"},{"start":23.81,"end":28.18,"text":"from everlasting to everlasting"},{"start":28.18,"end":32.54,"text":"You are God."},{"start":32.54,"end":36.9,"text":"You return man to dust,"},{"start":36.9,"end":41.26,"text":"saying, “Return, O sons of mortals.”"},{"start":41.26,"end":45.63,"text":"For in Your sight a thousand years"},{"start":45.63,"end":49.99,"text":"are but a day that passes,"},{"start":49.99,"end":54.35,"text":"or a watch of the night."},{"start":54.35,"end":58.72,"text":"You sweep them away in their sleep;"},{"start":58.72,"end":63.08,"text":"they are like the new grass of the morning—"},{"start":63.08,"end":67.44,"text":"in the morning it springs up new,"},{"start":67.44,"end":71.8,"text":"but by evening it fades and withers."}]}