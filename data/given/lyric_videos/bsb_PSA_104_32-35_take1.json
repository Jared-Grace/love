{"passage":"Psalm 104:32-35","credit":"Berean Standard Bible","duration":59.760998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.24,"end":5.91,"text":"He looks on the earth,"},{"start":5.96,"end":8.01,"text":"and it trembles;"},{"start":8.06,"end":9.81,"text":"He touches the mountains,"},{"start":9.86,"end":12.69,"text":"and they smolder."},{"start":12.74,"end":20.4,"text":"I will sing to the LORD all my life;"},{"start":20.45,"end":25.44,"text":"I will sing praise to my God while I have my being."},{"start":25.49,"end":29.28,"text":"May my meditation be pleasing to Him,"},{"start":29.33,"end":31.92,"text":"for I rejoice in the LORD."},{"start":31.97,"end":42.51,"text":"May sinners vanish from the earth"},{"start":42.56,"end":47.91,"text":"and the wicked be no more."},{"start":47.96,"end":55.23,"text":"Bless the LORD, O my soul."},{"start":55.28,"end":59.76,"text":"Hallelujah!"}],"times_from":"machine"}