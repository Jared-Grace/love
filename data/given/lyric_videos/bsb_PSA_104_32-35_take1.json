{"passage":"Psalm 104:32-35","credit":"Berean Standard Bible","duration":59.760998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.48,"text":"He looks on the earth,"},{"start":6.48,"end":10.96,"text":"and it trembles;"},{"start":10.96,"end":15.44,"text":"He touches the mountains,"},{"start":15.44,"end":19.92,"text":"and they smolder."},{"start":19.92,"end":24.4,"text":"I will sing to the LORD all my life;"},{"start":24.4,"end":28.88,"text":"I will sing praise to my God while I have my being."},{"start":28.88,"end":33.36,"text":"May my meditation be pleasing to Him,"},{"start":33.36,"end":37.84,"text":"for I rejoice in the LORD."},{"start":37.84,"end":42.32,"text":"May sinners vanish from the earth"},{"start":42.32,"end":46.8,"text":"and the wicked be no more."},{"start":46.8,"end":51.28,"text":"Bless the LORD, O my soul."},{"start":51.28,"end":55.76,"text":"Hallelujah!"}]}