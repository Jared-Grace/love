{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":85.450998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.97,"text":"Rulers persecute me without cause,"},{"start":6.97,"end":11.93,"text":"but my heart fears only Your word."},{"start":11.93,"end":16.9,"text":"I rejoice in Your promise"},{"start":16.9,"end":21.86,"text":"like one who finds great spoil."},{"start":21.86,"end":26.83,"text":"I hate and abhor falsehood,"},{"start":26.83,"end":31.79,"text":"but Your law I love."},{"start":31.79,"end":36.76,"text":"Seven times a day I praise You"},{"start":36.76,"end":41.73,"text":"for Your righteous judgments."},{"start":41.73,"end":46.69,"text":"Abundant peace belongs to those who love Your law;"},{"start":46.69,"end":51.66,"text":"nothing can make them stumble."},{"start":51.66,"end":56.62,"text":"I wait for Your salvation, O LORD,"},{"start":56.62,"end":61.59,"text":"and I carry out Your commandments."},{"start":61.59,"end":66.55,"text":"I obey Your testimonies"},{"start":66.55,"end":71.52,"text":"and love them greatly."},{"start":71.52,"end":76.49,"text":"I obey Your precepts and Your testimonies,"},{"start":76.49,"end":81.45,"text":"for all my ways are before You."}]}