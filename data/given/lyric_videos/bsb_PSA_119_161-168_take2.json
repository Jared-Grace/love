{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":85.450998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":7.58,"end":13.63,"text":"Rulers persecute me without cause,"},{"start":13.68,"end":20.71,"text":"but my heart fears only Your word."},{"start":20.76,"end":23.83,"text":"I rejoice in Your promise"},{"start":23.88,"end":27.59,"text":"like one who finds great spoil."},{"start":27.64,"end":32.67,"text":"I hate and abhor falsehood,"},{"start":32.72,"end":34.96,"text":"but Your law I love."},{"start":35.01,"end":38.38,"text":"Seven times a day I praise You"},{"start":38.42,"end":40.34,"text":"for Your righteous judgments."},{"start":40.39,"end":45.96,"text":"Abundant peace belongs to those who love Your law;"},{"start":46.01,"end":49.64,"text":"nothing can make them stumble."},{"start":49.69,"end":54.1,"text":"I wait for Your salvation, O LORD,"},{"start":54.15,"end":59.76,"text":"and I carry out Your commandments."},{"start":59.81,"end":66.56,"text":"I obey Your testimonies"},{"start":66.61,"end":69.3,"text":"and love them greatly."},{"start":69.35,"end":74.06,"text":"I obey Your precepts and Your testimonies,"},{"start":74.11,"end":85.45,"text":"for all my ways are before You."}],"times_from":"machine"}