{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":79.629002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.16,"end":6.67,"text":"A song of ascents."},{"start":6.72,"end":12.35,"text":"In my distress I cried to the LORD,"},{"start":12.4,"end":14.57,"text":"and He answered me."},{"start":14.62,"end":19.75,"text":"Deliver my soul, O LORD,"},{"start":19.8,"end":26.31,"text":"from lying lips and a deceitful tongue."},{"start":26.36,"end":30.29,"text":"What will He do to you,"},{"start":30.34,"end":36.37,"text":"and what will be added to you,"},{"start":36.42,"end":38.27,"text":"O deceitful tongue?"},{"start":38.32,"end":44.3,"text":"Sharp arrows will come from the warrior,"},{"start":44.35,"end":48.18,"text":"with burning coals of the broom tree!"},{"start":48.23,"end":55,"text":"Woe to me that I dwell in Meshech,"},{"start":55.05,"end":59.82,"text":"that I live among the tents of Kedar!"},{"start":59.87,"end":62.48,"text":"Too long have I dwelt"},{"start":62.53,"end":64.94,"text":"among those who hate peace."},{"start":64.99,"end":70.66,"text":"I am in favor of peace;"},{"start":70.71,"end":79.63,"text":"but when I speak, they want war."}],"times_from":"machine"}