{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":79.629002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.6,"text":"A song of ascents."},{"start":6.6,"end":11.2,"text":"In my distress I cried to the LORD,"},{"start":11.2,"end":15.81,"text":"and He answered me."},{"start":15.81,"end":20.41,"text":"Deliver my soul, O LORD,"},{"start":20.41,"end":25.01,"text":"from lying lips and a deceitful tongue."},{"start":25.01,"end":29.61,"text":"What will He do to you,"},{"start":29.61,"end":34.21,"text":"and what will be added to you,"},{"start":34.21,"end":38.81,"text":"O deceitful tongue?"},{"start":38.81,"end":43.42,"text":"Sharp arrows will come from the warrior,"},{"start":43.42,"end":48.02,"text":"with burning coals of the broom tree!"},{"start":48.02,"end":52.62,"text":"Woe to me that I dwell in Meshech,"},{"start":52.62,"end":57.22,"text":"that I live among the tents of Kedar!"},{"start":57.22,"end":61.82,"text":"Too long have I dwelt"},{"start":61.82,"end":66.43,"text":"among those who hate peace."},{"start":66.43,"end":71.03,"text":"I am in favor of peace;"},{"start":71.03,"end":75.63,"text":"but when I speak, they want war."}]}