{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":75.43,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.96,"text":"A Psalm of thanksgiving."},{"start":6.96,"end":11.92,"text":"Make a joyful noise to the LORD,"},{"start":11.92,"end":16.88,"text":"all the earth."},{"start":16.88,"end":21.84,"text":"Serve the LORD with gladness;"},{"start":21.84,"end":26.8,"text":"come into His presence with joyful songs."},{"start":26.8,"end":31.76,"text":"Know that the LORD is God."},{"start":31.76,"end":36.72,"text":"It is He who made us, and we are His;"},{"start":36.72,"end":41.67,"text":"we are His people, and the sheep of His pasture."},{"start":41.67,"end":46.63,"text":"Enter His gates with thanksgiving"},{"start":46.63,"end":51.59,"text":"and His courts with praise;"},{"start":51.59,"end":56.55,"text":"give thanks to Him and bless His name."},{"start":56.55,"end":61.51,"text":"For the LORD is good,"},{"start":61.51,"end":66.47,"text":"and His loving devotion endures forever;"},{"start":66.47,"end":71.43,"text":"His faithfulness continues to all generations."}]}