{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":74.456009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.89,"text":"A Psalm of thanksgiving."},{"start":6.89,"end":11.78,"text":"Make a joyful noise to the LORD,"},{"start":11.78,"end":16.67,"text":"all the earth."},{"start":16.67,"end":21.56,"text":"Serve the LORD with gladness;"},{"start":21.56,"end":26.45,"text":"come into His presence with joyful songs."},{"start":26.45,"end":31.34,"text":"Know that the LORD is God."},{"start":31.34,"end":36.23,"text":"It is He who made us, and we are His;"},{"start":36.23,"end":41.12,"text":"we are His people, and the sheep of His pasture."},{"start":41.12,"end":46.01,"text":"Enter His gates with thanksgiving"},{"start":46.01,"end":50.9,"text":"and His courts with praise;"},{"start":50.9,"end":55.79,"text":"give thanks to Him and bless His name."},{"start":55.79,"end":60.68,"text":"For the LORD is good,"},{"start":60.68,"end":65.57,"text":"and His loving devotion endures forever;"},{"start":65.57,"end":70.46,"text":"His faithfulness continues to all generations."}]}