{"passage":"Psalm 104:32-35","credit":"Berean Standard Bible","duration":41.680998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":4.97,"text":"He looks on the earth,"},{"start":4.97,"end":7.95,"text":"and it trembles;"},{"start":7.95,"end":10.92,"text":"He touches the mountains,"},{"start":10.92,"end":13.89,"text":"and they smolder."},{"start":13.89,"end":16.87,"text":"I will sing to the LORD all my life;"},{"start":16.87,"end":19.84,"text":"I will sing praise to my God while I have my being."},{"start":19.84,"end":22.81,"text":"May my meditation be pleasing to Him,"},{"start":22.81,"end":25.79,"text":"for I rejoice in the LORD."},{"start":25.79,"end":28.76,"text":"May sinners vanish from the earth"},{"start":28.76,"end":31.73,"text":"and the wicked be no more."},{"start":31.73,"end":34.71,"text":"Bless the LORD, O my soul."},{"start":34.71,"end":37.68,"text":"Hallelujah!"}]}