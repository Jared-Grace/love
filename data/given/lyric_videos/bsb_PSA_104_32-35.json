{"passage":"Psalm 104:32-35","credit":"Berean Standard Bible","duration":41.680998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.04,"end":5.81,"text":"He looks on the earth,"},{"start":5.86,"end":7.41,"text":"and it trembles;"},{"start":7.46,"end":9.4,"text":"He touches the mountains,"},{"start":9.45,"end":10.74,"text":"and they smolder."},{"start":10.79,"end":13.36,"text":"I will sing to the LORD all my life;"},{"start":13.41,"end":17.08,"text":"I will sing praise to my God while I have my being."},{"start":17.13,"end":21.12,"text":"May my meditation be pleasing to Him,"},{"start":21.17,"end":25,"text":"for I rejoice in the LORD."},{"start":25.05,"end":27.24,"text":"May sinners vanish from the earth"},{"start":27.29,"end":30.15,"text":"and the wicked be no more."},{"start":30.2,"end":37.03,"text":"Bless the LORD, O my soul."},{"start":37.08,"end":41.68,"text":"Hallelujah!"}],"times_from":"machine"}