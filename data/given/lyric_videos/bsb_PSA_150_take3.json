{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":82.830998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.28,"end":8.45,"text":"Hallelujah!"},{"start":8.5,"end":14.07,"text":"Praise God in His sanctuary."},{"start":14.12,"end":18.93,"text":"Praise Him in His mighty heavens."},{"start":18.98,"end":24.95,"text":"Praise Him for His mighty acts;"},{"start":25,"end":29.05,"text":"praise Him for His excellent greatness."},{"start":29.1,"end":37.72,"text":"Praise Him with the sound of the horn;"},{"start":37.77,"end":43.7,"text":"praise Him with the harp and lyre."},{"start":43.75,"end":49.74,"text":"Praise Him with tambourine and dancing;"},{"start":49.79,"end":55.72,"text":"praise Him with strings and flute."},{"start":55.77,"end":58.72,"text":"Praise Him with clashing cymbals;"},{"start":58.77,"end":65.46,"text":"praise Him with resounding cymbals."},{"start":65.51,"end":78.98,"text":"Let everything that has breath praise the LORD!"},{"start":79.03,"end":82.83,"text":"Hallelujah!"}],"times_from":"machine"}