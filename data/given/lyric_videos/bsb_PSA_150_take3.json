{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":82.830998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.91,"text":"Hallelujah!"},{"start":7.91,"end":13.82,"text":"Praise God in His sanctuary."},{"start":13.82,"end":19.73,"text":"Praise Him in His mighty heavens."},{"start":19.73,"end":25.64,"text":"Praise Him for His mighty acts;"},{"start":25.64,"end":31.55,"text":"praise Him for His excellent greatness."},{"start":31.55,"end":37.46,"text":"Praise Him with the sound of the horn;"},{"start":37.46,"end":43.37,"text":"praise Him with the harp and lyre."},{"start":43.37,"end":49.28,"text":"Praise Him with tambourine and dancing;"},{"start":49.28,"end":55.19,"text":"praise Him with strings and flute."},{"start":55.19,"end":61.1,"text":"Praise Him with clashing cymbals;"},{"start":61.1,"end":67.01,"text":"praise Him with resounding cymbals."},{"start":67.01,"end":72.92,"text":"Let everything that has breath praise the LORD!"},{"start":72.92,"end":78.83,"text":"Hallelujah!"}]}