{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":78.585011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.16,"end":11.53,"text":"Rulers persecute me without cause,"},{"start":11.58,"end":19.19,"text":"but my heart fears only Your word."},{"start":19.24,"end":22.81,"text":"I rejoice in Your promise"},{"start":22.86,"end":26.45,"text":"like one who finds great spoil."},{"start":26.5,"end":30.99,"text":"I hate and abhor falsehood,"},{"start":31.04,"end":33.81,"text":"but Your law I love."},{"start":33.86,"end":38.19,"text":"Seven times a day I praise You"},{"start":38.24,"end":41.43,"text":"for Your righteous judgments."},{"start":41.48,"end":46.87,"text":"Abundant peace belongs to those who love Your law;"},{"start":46.92,"end":49.99,"text":"nothing can make them stumble."},{"start":50.04,"end":54.51,"text":"I wait for Your salvation, O LORD,"},{"start":54.56,"end":60.19,"text":"and I carry out Your commandments."},{"start":60.24,"end":65.15,"text":"I obey Your testimonies"},{"start":65.2,"end":67.79,"text":"and love them greatly."},{"start":67.84,"end":73.62,"text":"I obey Your precepts and Your testimonies,"},{"start":73.67,"end":78.59,"text":"for all my ways are before You."}],"times_from":"machine"}