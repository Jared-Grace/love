{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":78.585011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.54,"text":"Rulers persecute me without cause,"},{"start":6.54,"end":11.07,"text":"but my heart fears only Your word."},{"start":11.07,"end":15.61,"text":"I rejoice in Your promise"},{"start":15.61,"end":20.15,"text":"like one who finds great spoil."},{"start":20.15,"end":24.68,"text":"I hate and abhor falsehood,"},{"start":24.68,"end":29.22,"text":"but Your law I love."},{"start":29.22,"end":33.76,"text":"Seven times a day I praise You"},{"start":33.76,"end":38.29,"text":"for Your righteous judgments."},{"start":38.29,"end":42.83,"text":"Abundant peace belongs to those who love Your law;"},{"start":42.83,"end":47.37,"text":"nothing can make them stumble."},{"start":47.37,"end":51.9,"text":"I wait for Your salvation, O LORD,"},{"start":51.9,"end":56.44,"text":"and I carry out Your commandments."},{"start":56.44,"end":60.98,"text":"I obey Your testimonies"},{"start":60.98,"end":65.51,"text":"and love them greatly."},{"start":65.51,"end":70.05,"text":"I obey Your precepts and Your testimonies,"},{"start":70.05,"end":74.59,"text":"for all my ways are before You."}]}