{"passage":"Psalm 90:1-6","credit":"Berean Standard Bible","duration":63.941995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.62,"text":"A prayer of Moses the man of God."},{"start":5.62,"end":9.24,"text":"Lord, You have been our dwelling place"},{"start":9.24,"end":12.86,"text":"through all generations."},{"start":12.86,"end":16.49,"text":"Before the mountains were born"},{"start":16.49,"end":20.11,"text":"or You brought forth the earth and the world,"},{"start":20.11,"end":23.73,"text":"from everlasting to everlasting"},{"start":23.73,"end":27.35,"text":"You are God."},{"start":27.35,"end":30.97,"text":"You return man to dust,"},{"start":30.97,"end":34.59,"text":"saying, “Return, O sons of mortals.”"},{"start":34.59,"end":38.21,"text":"For in Your sight a thousand years"},{"start":38.21,"end":41.84,"text":"are but a day that passes,"},{"start":41.84,"end":45.46,"text":"or a watch of the night."},{"start":45.46,"end":49.08,"text":"You sweep them away in their sleep;"},{"start":49.08,"end":52.7,"text":"they are like the new grass of the morning—"},{"start":52.7,"end":56.32,"text":"in the morning it springs up new,"},{"start":56.32,"end":59.94,"text":"but by evening it fades and withers."}]}