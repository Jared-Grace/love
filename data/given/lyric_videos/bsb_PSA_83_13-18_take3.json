{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":76.513991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.42,"text":"Make them like tumbleweed, O my God,"},{"start":7.42,"end":12.85,"text":"like chaff before the wind."},{"start":12.85,"end":18.27,"text":"As fire consumes a forest,"},{"start":18.27,"end":23.7,"text":"as a flame sets the mountains ablaze,"},{"start":23.7,"end":29.12,"text":"so pursue them with Your tempest,"},{"start":29.12,"end":34.54,"text":"and terrify them with Your storm."},{"start":34.54,"end":39.97,"text":"Cover their faces with shame,"},{"start":39.97,"end":45.39,"text":"that they may seek Your name, O LORD."},{"start":45.39,"end":50.82,"text":"May they be ever ashamed and terrified;"},{"start":50.82,"end":56.24,"text":"may they perish in disgrace."},{"start":56.24,"end":61.67,"text":"May they know that You alone,"},{"start":61.67,"end":67.09,"text":"whose name is the LORD,"},{"start":67.09,"end":72.51,"text":"are Most High over all the earth."}]}