{"passage":"Psalm 119:129-136","credit":"Berean Standard Bible","duration":74.168005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.48,"end":10.47,"text":"Wonderful are Your testimonies;"},{"start":10.52,"end":14.39,"text":"therefore I obey them."},{"start":14.44,"end":19.27,"text":"The unfolding of Your words gives light;"},{"start":19.32,"end":21.61,"text":"it informs the simple."},{"start":21.66,"end":25.15,"text":"I open my mouth and pant,"},{"start":25.2,"end":29.59,"text":"longing for Your commandments."},{"start":29.64,"end":34.55,"text":"Turn to me and show me mercy,"},{"start":34.6,"end":40.65,"text":"as You do to those who love Your name."},{"start":40.7,"end":44.56,"text":"Order my steps in Your word;"},{"start":44.61,"end":48.14,"text":"let no sin rule over me."},{"start":48.19,"end":51.64,"text":"Redeem me from the oppression of man,"},{"start":51.69,"end":54.54,"text":"that I may keep Your precepts."},{"start":54.59,"end":58.46,"text":"Make Your face shine upon Your servant,"},{"start":58.51,"end":64.08,"text":"and teach me Your statutes."},{"start":64.13,"end":67.42,"text":"My eyes shed streams of tears"},{"start":67.47,"end":74.17,"text":"because Your law is not obeyed."}],"times_from":"machine"}