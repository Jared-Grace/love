{"passage":"Psalm 119:129-136","credit":"Berean Standard Bible","duration":74.168005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.26,"text":"Wonderful are Your testimonies;"},{"start":6.26,"end":10.52,"text":"therefore I obey them."},{"start":10.52,"end":14.78,"text":"The unfolding of Your words gives light;"},{"start":14.78,"end":19.04,"text":"it informs the simple."},{"start":19.04,"end":23.3,"text":"I open my mouth and pant,"},{"start":23.3,"end":27.56,"text":"longing for Your commandments."},{"start":27.56,"end":31.82,"text":"Turn to me and show me mercy,"},{"start":31.82,"end":36.08,"text":"as You do to those who love Your name."},{"start":36.08,"end":40.34,"text":"Order my steps in Your word;"},{"start":40.34,"end":44.61,"text":"let no sin rule over me."},{"start":44.61,"end":48.87,"text":"Redeem me from the oppression of man,"},{"start":48.87,"end":53.13,"text":"that I may keep Your precepts."},{"start":53.13,"end":57.39,"text":"Make Your face shine upon Your servant,"},{"start":57.39,"end":61.65,"text":"and teach me Your statutes."},{"start":61.65,"end":65.91,"text":"My eyes shed streams of tears"},{"start":65.91,"end":70.17,"text":"because Your law is not obeyed."}]}