{"passage":"Psalm 119:1-8","credit":"Berean Standard Bible","duration":78.757007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.55,"text":"Blessed are those whose way is blameless,"},{"start":6.55,"end":11.09,"text":"who walk in the Law of the LORD."},{"start":11.09,"end":15.64,"text":"Blessed are those who keep His testimonies"},{"start":15.64,"end":20.19,"text":"and seek Him with all their heart."},{"start":20.19,"end":24.74,"text":"They do no iniquity;"},{"start":24.74,"end":29.28,"text":"they walk in His ways."},{"start":29.28,"end":33.83,"text":"You have ordained Your precepts,"},{"start":33.83,"end":38.38,"text":"that we should keep them diligently."},{"start":38.38,"end":42.93,"text":"Oh, that my ways were committed"},{"start":42.93,"end":47.47,"text":"to keeping Your statutes!"},{"start":47.47,"end":52.02,"text":"Then I would not be ashamed"},{"start":52.02,"end":56.57,"text":"when I consider all Your commandments."},{"start":56.57,"end":61.12,"text":"I will praise You with an upright heart"},{"start":61.12,"end":65.66,"text":"when I learn Your righteous judgments."},{"start":65.66,"end":70.21,"text":"I will keep Your statutes;"},{"start":70.21,"end":74.76,"text":"do not utterly forsake me."}]}