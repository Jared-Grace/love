{"passage":"Psalm 119:1-8","credit":"Berean Standard Bible","duration":78.757007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.76,"end":7.79,"text":"Blessed are those whose way is blameless,"},{"start":7.84,"end":12.27,"text":"who walk in the Law of the LORD."},{"start":12.32,"end":17.43,"text":"Blessed are those who keep His testimonies"},{"start":17.48,"end":20.88,"text":"and seek Him with all their heart."},{"start":20.93,"end":24.9,"text":"They do no iniquity;"},{"start":24.95,"end":29.48,"text":"they walk in His ways."},{"start":29.53,"end":32.42,"text":"You have ordained Your precepts,"},{"start":32.47,"end":37.84,"text":"that we should keep them diligently."},{"start":37.89,"end":44.74,"text":"Oh, that my ways were committed"},{"start":44.79,"end":49.82,"text":"to keeping Your statutes!"},{"start":49.87,"end":53.84,"text":"Then I would not be ashamed"},{"start":53.89,"end":59.42,"text":"when I consider all Your commandments."},{"start":59.47,"end":64.3,"text":"I will praise You with an upright heart"},{"start":64.35,"end":67.41,"text":"when I learn Your righteous judgments."},{"start":67.46,"end":71.53,"text":"I will keep Your statutes;"},{"start":71.58,"end":78.76,"text":"do not utterly forsake me."}],"times_from":"machine"}