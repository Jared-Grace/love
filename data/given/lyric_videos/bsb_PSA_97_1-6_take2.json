{"passage":"Psalm 97:1-6","credit":"Berean Standard Bible","duration":75.73,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.36,"text":"The LORD reigns, let the earth rejoice;"},{"start":7.36,"end":12.73,"text":"let the distant shores be glad."},{"start":12.73,"end":18.09,"text":"Clouds and darkness surround Him;"},{"start":18.09,"end":23.46,"text":"righteousness and justice are His throne’s foundation."},{"start":23.46,"end":28.82,"text":"Fire goes before Him"},{"start":28.82,"end":34.18,"text":"and consumes His foes on every side."},{"start":34.18,"end":39.55,"text":"His lightning illuminates the world;"},{"start":39.55,"end":44.91,"text":"the earth sees and trembles."},{"start":44.91,"end":50.27,"text":"The mountains melt like wax"},{"start":50.27,"end":55.64,"text":"at the presence of the LORD,"},{"start":55.64,"end":61,"text":"before the Lord of all the earth."},{"start":61,"end":66.37,"text":"The heavens proclaim His righteousness;"},{"start":66.37,"end":71.73,"text":"all the peoples see His glory."}]}