{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":59.457007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":5.46,"end":9.05,"text":"Hallelujah!"},{"start":9.1,"end":12.67,"text":"Praise God in His sanctuary."},{"start":12.72,"end":15.92,"text":"Praise Him in His mighty heavens."},{"start":15.97,"end":19.1,"text":"Praise Him for His mighty acts;"},{"start":19.15,"end":22.7,"text":"praise Him for His excellent greatness."},{"start":22.75,"end":25.9,"text":"Praise Him with the sound of the horn;"},{"start":25.95,"end":29.12,"text":"praise Him with the harp and lyre."},{"start":29.17,"end":32.72,"text":"Praise Him with tambourine and dancing;"},{"start":32.77,"end":35.92,"text":"praise Him with strings and flute."},{"start":35.97,"end":40.3,"text":"Praise Him with clashing cymbals;"},{"start":40.35,"end":49.5,"text":"praise Him with resounding cymbals."},{"start":49.55,"end":57.55,"text":"Let everything that has breath praise the LORD!"},{"start":57.6,"end":59.46,"text":"Hallelujah!"}],"times_from":"machine"}