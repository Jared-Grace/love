{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":59.457007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.11,"text":"Hallelujah!"},{"start":6.11,"end":10.22,"text":"Praise God in His sanctuary."},{"start":10.22,"end":14.34,"text":"Praise Him in His mighty heavens."},{"start":14.34,"end":18.45,"text":"Praise Him for His mighty acts;"},{"start":18.45,"end":22.56,"text":"praise Him for His excellent greatness."},{"start":22.56,"end":26.67,"text":"Praise Him with the sound of the horn;"},{"start":26.67,"end":30.78,"text":"praise Him with the harp and lyre."},{"start":30.78,"end":34.9,"text":"Praise Him with tambourine and dancing;"},{"start":34.9,"end":39.01,"text":"praise Him with strings and flute."},{"start":39.01,"end":43.12,"text":"Praise Him with clashing cymbals;"},{"start":43.12,"end":47.23,"text":"praise Him with resounding cymbals."},{"start":47.23,"end":51.34,"text":"Let everything that has breath praise the LORD!"},{"start":51.34,"end":55.46,"text":"Hallelujah!"}]}