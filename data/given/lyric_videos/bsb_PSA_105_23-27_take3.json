{"passage":"Psalm 105:23-27","credit":"Berean Standard Bible","duration":59.147007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.31,"text":"Then Israel entered Egypt;"},{"start":7.31,"end":12.63,"text":"Jacob dwelt in the land of Ham."},{"start":12.63,"end":17.94,"text":"And the LORD made His people very fruitful,"},{"start":17.94,"end":23.26,"text":"more numerous than their foes,"},{"start":23.26,"end":28.57,"text":"whose hearts He turned to hate His people,"},{"start":28.57,"end":33.89,"text":"to conspire against His servants."},{"start":33.89,"end":39.2,"text":"He sent Moses His servant,"},{"start":39.2,"end":44.52,"text":"and Aaron, whom He had chosen."},{"start":44.52,"end":49.83,"text":"They performed His miraculous signs among them,"},{"start":49.83,"end":55.15,"text":"and wonders in the land of Ham."}]}