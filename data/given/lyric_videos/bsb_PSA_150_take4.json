{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":69.651995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.9,"text":"Hallelujah!"},{"start":6.9,"end":11.79,"text":"Praise God in His sanctuary."},{"start":11.79,"end":16.69,"text":"Praise Him in His mighty heavens."},{"start":16.69,"end":21.59,"text":"Praise Him for His mighty acts;"},{"start":21.59,"end":26.48,"text":"praise Him for His excellent greatness."},{"start":26.48,"end":31.38,"text":"Praise Him with the sound of the horn;"},{"start":31.38,"end":36.27,"text":"praise Him with the harp and lyre."},{"start":36.27,"end":41.17,"text":"Praise Him with tambourine and dancing;"},{"start":41.17,"end":46.07,"text":"praise Him with strings and flute."},{"start":46.07,"end":50.96,"text":"Praise Him with clashing cymbals;"},{"start":50.96,"end":55.86,"text":"praise Him with resounding cymbals."},{"start":55.86,"end":60.76,"text":"Let everything that has breath praise the LORD!"},{"start":60.76,"end":65.65,"text":"Hallelujah!"}]}