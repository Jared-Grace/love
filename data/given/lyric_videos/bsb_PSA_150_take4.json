{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":69.651995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":5.2,"end":9.01,"text":"Hallelujah!"},{"start":9.06,"end":14.07,"text":"Praise God in His sanctuary."},{"start":14.12,"end":18.73,"text":"Praise Him in His mighty heavens."},{"start":18.78,"end":22.27,"text":"Praise Him for His mighty acts;"},{"start":22.32,"end":28.1,"text":"praise Him for His excellent greatness."},{"start":28.15,"end":31.62,"text":"Praise Him with the sound of the horn;"},{"start":31.67,"end":37.48,"text":"praise Him with the harp and lyre."},{"start":37.53,"end":42.16,"text":"Praise Him with tambourine and dancing;"},{"start":42.21,"end":45.66,"text":"praise Him with strings and flute."},{"start":45.71,"end":49.94,"text":"Praise Him with clashing cymbals;"},{"start":49.99,"end":54.64,"text":"praise Him with resounding cymbals."},{"start":54.69,"end":65.16,"text":"Let everything that has breath praise the LORD!"},{"start":65.21,"end":69.65,"text":"Hallelujah!"}],"times_from":"machine"}