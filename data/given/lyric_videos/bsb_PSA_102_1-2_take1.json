{"passage":"Psalm 102:1-2","credit":"Berean Standard Bible","duration":45.906009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.7,"text":"A prayer of one who is afflicted, when he grows faint and pours out his lament before the LORD."},{"start":7.7,"end":13.4,"text":"Hear my prayer, O LORD;"},{"start":13.4,"end":19.1,"text":"let my cry for help come before You."},{"start":19.1,"end":24.8,"text":"Do not hide Your face from me"},{"start":24.8,"end":30.5,"text":"in my day of distress."},{"start":30.5,"end":36.21,"text":"Incline Your ear to me;"},{"start":36.21,"end":41.91,"text":"answer me quickly when I call."}]}