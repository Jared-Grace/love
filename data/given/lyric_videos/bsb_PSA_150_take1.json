{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":48.963991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.3,"text":"Hallelujah!"},{"start":5.3,"end":8.61,"text":"Praise God in His sanctuary."},{"start":8.61,"end":11.91,"text":"Praise Him in His mighty heavens."},{"start":11.91,"end":15.22,"text":"Praise Him for His mighty acts;"},{"start":15.22,"end":18.52,"text":"praise Him for His excellent greatness."},{"start":18.52,"end":21.83,"text":"Praise Him with the sound of the horn;"},{"start":21.83,"end":25.13,"text":"praise Him with the harp and lyre."},{"start":25.13,"end":28.44,"text":"Praise Him with tambourine and dancing;"},{"start":28.44,"end":31.74,"text":"praise Him with strings and flute."},{"start":31.74,"end":35.05,"text":"Praise Him with clashing cymbals;"},{"start":35.05,"end":38.35,"text":"praise Him with resounding cymbals."},{"start":38.35,"end":41.66,"text":"Let everything that has breath praise the LORD!"},{"start":41.66,"end":44.96,"text":"Hallelujah!"}]}