{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":48.963991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.86,"end":5.65,"text":"Hallelujah!"},{"start":5.7,"end":9.25,"text":"Praise God in His sanctuary."},{"start":9.31,"end":11.84,"text":"Praise Him in His mighty heavens."},{"start":11.89,"end":14.14,"text":"Praise Him for His mighty acts;"},{"start":14.19,"end":17.06,"text":"praise Him for His excellent greatness."},{"start":17.11,"end":19.64,"text":"Praise Him with the sound of the horn;"},{"start":19.69,"end":22.24,"text":"praise Him with the harp and lyre."},{"start":22.29,"end":25.82,"text":"Praise Him with tambourine and dancing;"},{"start":25.87,"end":29.71,"text":"praise Him with strings and flute."},{"start":29.76,"end":34.61,"text":"Praise Him with clashing cymbals;"},{"start":34.66,"end":38.51,"text":"praise Him with resounding cymbals."},{"start":38.56,"end":45.31,"text":"Let everything that has breath praise the LORD!"},{"start":45.36,"end":48.96,"text":"Hallelujah!"}],"times_from":"machine"}