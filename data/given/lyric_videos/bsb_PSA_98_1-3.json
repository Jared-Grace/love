{"passage":"Psalm 98:1-3","credit":"Berean Standard Bible","duration":43.961995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.45,"text":"A Psalm."},{"start":5.45,"end":8.9,"text":"Sing to the LORD a new song,"},{"start":8.9,"end":12.35,"text":"for He has done wonders;"},{"start":12.35,"end":15.8,"text":"His right hand and holy arm"},{"start":15.8,"end":19.26,"text":"have gained Him the victory."},{"start":19.26,"end":22.71,"text":"The LORD has proclaimed His salvation"},{"start":22.71,"end":26.16,"text":"and revealed His righteousness to the nations."},{"start":26.16,"end":29.61,"text":"He has remembered His love and faithfulness"},{"start":29.61,"end":33.06,"text":"to the house of Israel;"},{"start":33.06,"end":36.51,"text":"all the ends of the earth"},{"start":36.51,"end":39.96,"text":"have seen the salvation of our God."}]}