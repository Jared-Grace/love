{"passage":"Psalm 96:11-13","credit":"Berean Standard Bible","duration":52.625011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":5.89,"text":"Let the heavens be glad"},{"start":5.89,"end":9.77,"text":"and the earth rejoice;"},{"start":9.77,"end":13.66,"text":"let the sea resound,"},{"start":13.66,"end":17.54,"text":"and all that fills it."},{"start":17.54,"end":21.43,"text":"Let the fields exult,"},{"start":21.43,"end":25.31,"text":"and all that is in them."},{"start":25.31,"end":29.2,"text":"Then all the trees of the forest"},{"start":29.2,"end":33.08,"text":"will sing for joy before the LORD,"},{"start":33.08,"end":36.97,"text":"for He is coming—"},{"start":36.97,"end":40.85,"text":"He is coming to judge the earth."},{"start":40.85,"end":44.74,"text":"He will judge the world in righteousness"},{"start":44.74,"end":48.63,"text":"and the peoples in His faithfulness."}]}