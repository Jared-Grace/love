{"passage":"Psalm 119:33-40","credit":"Berean Standard Bible","duration":86.851995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.78,"end":11.13,"text":"Teach me, O LORD, the way of Your statutes,"},{"start":11.18,"end":17.73,"text":"and I will keep them to the end."},{"start":17.78,"end":24.47,"text":"Give me understanding that I may obey Your law,"},{"start":24.52,"end":31.07,"text":"and follow it with all my heart."},{"start":31.12,"end":37.72,"text":"Direct me in the path of Your commandments,"},{"start":37.77,"end":43.78,"text":"for there I find delight."},{"start":43.83,"end":48,"text":"Turn my heart to Your testimonies"},{"start":48.05,"end":51.04,"text":"and not to covetous gain."},{"start":51.09,"end":54.6,"text":"Turn my eyes away from worthless things;"},{"start":54.65,"end":60.46,"text":"revive me with Your word."},{"start":60.51,"end":64.22,"text":"Establish Your word to Your servant,"},{"start":64.27,"end":67.3,"text":"to produce reverence for You."},{"start":67.35,"end":70.66,"text":"Turn away the disgrace I dread,"},{"start":70.71,"end":73.66,"text":"for Your judgments are good."},{"start":73.71,"end":77.94,"text":"How I long for Your precepts!"},{"start":77.99,"end":86.85,"text":"Revive me in Your righteousness."}],"times_from":"machine"}