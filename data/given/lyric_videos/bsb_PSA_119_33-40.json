{"passage":"Psalm 119:33-40","credit":"Berean Standard Bible","duration":86.851995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.05,"text":"Teach me, O LORD, the way of Your statutes,"},{"start":7.05,"end":12.11,"text":"and I will keep them to the end."},{"start":12.11,"end":17.16,"text":"Give me understanding that I may obey Your law,"},{"start":17.16,"end":22.21,"text":"and follow it with all my heart."},{"start":22.21,"end":27.27,"text":"Direct me in the path of Your commandments,"},{"start":27.27,"end":32.32,"text":"for there I find delight."},{"start":32.32,"end":37.37,"text":"Turn my heart to Your testimonies"},{"start":37.37,"end":42.43,"text":"and not to covetous gain."},{"start":42.43,"end":47.48,"text":"Turn my eyes away from worthless things;"},{"start":47.48,"end":52.53,"text":"revive me with Your word."},{"start":52.53,"end":57.59,"text":"Establish Your word to Your servant,"},{"start":57.59,"end":62.64,"text":"to produce reverence for You."},{"start":62.64,"end":67.69,"text":"Turn away the disgrace I dread,"},{"start":67.69,"end":72.75,"text":"for Your judgments are good."},{"start":72.75,"end":77.8,"text":"How I long for Your precepts!"},{"start":77.8,"end":82.85,"text":"Revive me in Your righteousness."}]}