{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":90.596009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.29,"text":"Righteous are You, O LORD,"},{"start":7.29,"end":12.57,"text":"and upright are Your judgments."},{"start":12.57,"end":17.86,"text":"The testimonies You have laid down are righteous"},{"start":17.86,"end":23.15,"text":"and altogether faithful."},{"start":23.15,"end":28.44,"text":"My zeal has consumed me"},{"start":28.44,"end":33.72,"text":"because my foes forget Your words."},{"start":33.72,"end":39.01,"text":"Your promise is completely pure;"},{"start":39.01,"end":44.3,"text":"therefore Your servant loves it."},{"start":44.3,"end":49.59,"text":"I am lowly and despised,"},{"start":49.59,"end":54.87,"text":"but I do not forget Your precepts."},{"start":54.87,"end":60.16,"text":"Your righteousness is everlasting"},{"start":60.16,"end":65.45,"text":"and Your law is true."},{"start":65.45,"end":70.73,"text":"Trouble and distress have found me,"},{"start":70.73,"end":76.02,"text":"but Your commandments are my delight."},{"start":76.02,"end":81.31,"text":"Your testimonies are righteous forever."},{"start":81.31,"end":86.6,"text":"Give me understanding, that I may live."}]}