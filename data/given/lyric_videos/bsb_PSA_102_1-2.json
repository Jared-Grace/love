{"passage":"Psalm 102:1-2","credit":"Berean Standard Bible","duration":49.833991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.26,"text":"A prayer of one who is afflicted, when he grows faint and pours out his lament before the LORD."},{"start":8.26,"end":14.52,"text":"Hear my prayer, O LORD;"},{"start":14.52,"end":20.79,"text":"let my cry for help come before You."},{"start":20.79,"end":27.05,"text":"Do not hide Your face from me"},{"start":27.05,"end":33.31,"text":"in my day of distress."},{"start":33.31,"end":39.57,"text":"Incline Your ear to me;"},{"start":39.57,"end":45.83,"text":"answer me quickly when I call."}]}