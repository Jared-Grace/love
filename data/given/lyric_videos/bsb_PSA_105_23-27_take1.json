{"passage":"Psalm 105:23-27","credit":"Berean Standard Bible","duration":73.672993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.77,"text":"Then Israel entered Egypt;"},{"start":8.77,"end":15.53,"text":"Jacob dwelt in the land of Ham."},{"start":15.53,"end":22.3,"text":"And the LORD made His people very fruitful,"},{"start":22.3,"end":29.07,"text":"more numerous than their foes,"},{"start":29.07,"end":35.84,"text":"whose hearts He turned to hate His people,"},{"start":35.84,"end":42.6,"text":"to conspire against His servants."},{"start":42.6,"end":49.37,"text":"He sent Moses His servant,"},{"start":49.37,"end":56.14,"text":"and Aaron, whom He had chosen."},{"start":56.14,"end":62.91,"text":"They performed His miraculous signs among them,"},{"start":62.91,"end":69.67,"text":"and wonders in the land of Ham."}]}