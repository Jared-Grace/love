{"passage":"Psalm 128","credit":"Berean Standard Bible","duration":87.64,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.46,"end":7.69,"text":"A song of ascents."},{"start":7.74,"end":11.61,"text":"Blessed are all who fear the LORD,"},{"start":11.66,"end":14.39,"text":"who walk in His ways!"},{"start":14.44,"end":20.02,"text":"For when you eat the fruit of your labor,"},{"start":20.07,"end":23.9,"text":"blessings and prosperity will be yours."},{"start":23.95,"end":28.2,"text":"Your wife will be like a fruitful vine"},{"start":28.25,"end":31.06,"text":"flourishing within your house,"},{"start":31.11,"end":34.38,"text":"your sons like olive shoots"},{"start":34.43,"end":37.7,"text":"sitting around your table."},{"start":37.75,"end":44.62,"text":"In this way indeed shall blessing come"},{"start":44.67,"end":52.88,"text":"to the man who fears the LORD."},{"start":52.93,"end":57.22,"text":"May the LORD bless you from Zion,"},{"start":57.27,"end":62.72,"text":"that you may see the prosperity of Jerusalem"},{"start":62.77,"end":69.03,"text":"all the days of your life,"},{"start":69.08,"end":70.35,"text":"that you may see"},{"start":70.4,"end":74.39,"text":"your children’s children."},{"start":74.44,"end":87.64,"text":"Peace be upon Israel!"}],"times_from":"machine"}