{"passage":"Psalm 128","credit":"Berean Standard Bible","duration":87.64,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.8,"text":"A song of ascents."},{"start":6.8,"end":11.6,"text":"Blessed are all who fear the LORD,"},{"start":11.6,"end":16.41,"text":"who walk in His ways!"},{"start":16.41,"end":21.21,"text":"For when you eat the fruit of your labor,"},{"start":21.21,"end":26.01,"text":"blessings and prosperity will be yours."},{"start":26.01,"end":30.81,"text":"Your wife will be like a fruitful vine"},{"start":30.81,"end":35.62,"text":"flourishing within your house,"},{"start":35.62,"end":40.42,"text":"your sons like olive shoots"},{"start":40.42,"end":45.22,"text":"sitting around your table."},{"start":45.22,"end":50.02,"text":"In this way indeed shall blessing come"},{"start":50.02,"end":54.83,"text":"to the man who fears the LORD."},{"start":54.83,"end":59.63,"text":"May the LORD bless you from Zion,"},{"start":59.63,"end":64.43,"text":"that you may see the prosperity of Jerusalem"},{"start":64.43,"end":69.23,"text":"all the days of your life,"},{"start":69.23,"end":74.04,"text":"that you may see"},{"start":74.04,"end":78.84,"text":"your children’s children."},{"start":78.84,"end":83.64,"text":"Peace be upon Israel!"}]}