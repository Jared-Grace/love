{"passage":"Psalm 69:14-18","credit":"Berean Standard Bible","duration":91.313991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.4,"end":4.03,"text":"Rescue me from the mire"},{"start":4.08,"end":7.37,"text":"and do not let me sink;"},{"start":7.42,"end":12.19,"text":"deliver me from my foes"},{"start":12.24,"end":15.35,"text":"and out of the deep waters."},{"start":15.4,"end":19.08,"text":"Do not let the floods engulf me"},{"start":19.13,"end":22.41,"text":"or the depths swallow me up;"},{"start":22.46,"end":26.61,"text":"let not the Pit close its mouth over me."},{"start":26.66,"end":30.49,"text":"Answer me, O LORD,"},{"start":30.54,"end":36.81,"text":"for Your loving devotion is good;"},{"start":36.86,"end":45.61,"text":"turn to me in keeping with Your great compassion."},{"start":45.66,"end":50.05,"text":"Hide not Your face from Your servant,"},{"start":50.1,"end":54.03,"text":"for I am in distress."},{"start":54.08,"end":70.03,"text":"Answer me quickly!"},{"start":70.08,"end":79.25,"text":"Draw near to my soul and redeem me;"},{"start":79.3,"end":91.31,"text":"ransom me because of my foes."}],"times_from":"machine"}