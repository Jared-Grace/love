{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":87.570998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.1,"text":"Righteous are You, O LORD,"},{"start":7.1,"end":12.2,"text":"and upright are Your judgments."},{"start":12.2,"end":17.29,"text":"The testimonies You have laid down are righteous"},{"start":17.29,"end":22.39,"text":"and altogether faithful."},{"start":22.39,"end":27.49,"text":"My zeal has consumed me"},{"start":27.49,"end":32.59,"text":"because my foes forget Your words."},{"start":32.59,"end":37.69,"text":"Your promise is completely pure;"},{"start":37.69,"end":42.79,"text":"therefore Your servant loves it."},{"start":42.79,"end":47.88,"text":"I am lowly and despised,"},{"start":47.88,"end":52.98,"text":"but I do not forget Your precepts."},{"start":52.98,"end":58.08,"text":"Your righteousness is everlasting"},{"start":58.08,"end":63.18,"text":"and Your law is true."},{"start":63.18,"end":68.28,"text":"Trouble and distress have found me,"},{"start":68.28,"end":73.37,"text":"but Your commandments are my delight."},{"start":73.37,"end":78.47,"text":"Your testimonies are righteous forever."},{"start":78.47,"end":83.57,"text":"Give me understanding, that I may live."}]}