{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":87.570998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.14,"end":5.21,"text":"Righteous are You, O LORD,"},{"start":5.26,"end":8.57,"text":"and upright are Your judgments."},{"start":8.62,"end":13.35,"text":"The testimonies You have laid down are righteous"},{"start":13.4,"end":16.33,"text":"and altogether faithful."},{"start":16.38,"end":19.43,"text":"My zeal has consumed me"},{"start":19.48,"end":22.87,"text":"because my foes forget Your words."},{"start":22.92,"end":26.15,"text":"Your promise is completely pure;"},{"start":26.2,"end":30.65,"text":"therefore Your servant loves it."},{"start":30.7,"end":34.53,"text":"I am lowly and despised,"},{"start":34.58,"end":42.1,"text":"but I do not forget Your precepts."},{"start":42.15,"end":46.24,"text":"Your righteousness is everlasting"},{"start":46.29,"end":49.36,"text":"and Your law is true."},{"start":49.41,"end":52.08,"text":"Trouble and distress have found me,"},{"start":52.13,"end":58.42,"text":"but Your commandments are my delight."},{"start":58.47,"end":64.96,"text":"Your testimonies are righteous forever."},{"start":65.01,"end":87.57,"text":"Give me understanding, that I may live."}],"times_from":"machine"}