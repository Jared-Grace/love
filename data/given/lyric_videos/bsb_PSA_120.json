{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":79.712993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.61,"text":"A song of ascents."},{"start":6.61,"end":11.21,"text":"In my distress I cried to the LORD,"},{"start":11.21,"end":15.82,"text":"and He answered me."},{"start":15.82,"end":20.43,"text":"Deliver my soul, O LORD,"},{"start":20.43,"end":25.04,"text":"from lying lips and a deceitful tongue."},{"start":25.04,"end":29.64,"text":"What will He do to you,"},{"start":29.64,"end":34.25,"text":"and what will be added to you,"},{"start":34.25,"end":38.86,"text":"O deceitful tongue?"},{"start":38.86,"end":43.46,"text":"Sharp arrows will come from the warrior,"},{"start":43.46,"end":48.07,"text":"with burning coals of the broom tree!"},{"start":48.07,"end":52.68,"text":"Woe to me that I dwell in Meshech,"},{"start":52.68,"end":57.28,"text":"that I live among the tents of Kedar!"},{"start":57.28,"end":61.89,"text":"Too long have I dwelt"},{"start":61.89,"end":66.5,"text":"among those who hate peace."},{"start":66.5,"end":71.11,"text":"I am in favor of peace;"},{"start":71.11,"end":75.71,"text":"but when I speak, they want war."}]}