{"passage":"Psalm 120","credit":"Berean Standard Bible","duration":79.712993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":6.62,"end":9.55,"text":"A song of ascents."},{"start":9.6,"end":15.57,"text":"In my distress I cried to the LORD,"},{"start":15.62,"end":18.07,"text":"and He answered me."},{"start":18.12,"end":24.41,"text":"Deliver my soul, O LORD,"},{"start":24.46,"end":32.5,"text":"from lying lips and a deceitful tongue."},{"start":32.55,"end":38.44,"text":"What will He do to you,"},{"start":38.49,"end":43.72,"text":"and what will be added to you,"},{"start":43.77,"end":45.3,"text":"O deceitful tongue?"},{"start":45.35,"end":48.44,"text":"Sharp arrows will come from the warrior,"},{"start":48.49,"end":51.52,"text":"with burning coals of the broom tree!"},{"start":51.57,"end":54.68,"text":"Woe to me that I dwell in Meshech,"},{"start":54.73,"end":57.8,"text":"that I live among the tents of Kedar!"},{"start":57.85,"end":59.74,"text":"Too long have I dwelt"},{"start":59.79,"end":62.52,"text":"among those who hate peace."},{"start":62.57,"end":68.52,"text":"I am in favor of peace;"},{"start":68.57,"end":79.71,"text":"but when I speak, they want war."}],"times_from":"machine"}