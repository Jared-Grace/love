{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":80.743991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.34,"end":5.39,"text":"A song of ascents."},{"start":5.44,"end":9.39,"text":"I lift up my eyes to the hills."},{"start":9.44,"end":13.19,"text":"From where does my help come?"},{"start":13.24,"end":16.26,"text":"My help comes from the LORD,"},{"start":16.31,"end":20.02,"text":"the Maker of heaven and earth."},{"start":20.07,"end":24.12,"text":"He will not allow your foot to slip;"},{"start":24.17,"end":29.98,"text":"your Protector will not slumber."},{"start":30.03,"end":33.4,"text":"Behold, the Protector of Israel"},{"start":33.45,"end":39.58,"text":"will neither slumber nor sleep."},{"start":39.63,"end":43.68,"text":"The LORD is your keeper;"},{"start":43.73,"end":49.17,"text":"the LORD is the shade on your right hand."},{"start":49.22,"end":52.97,"text":"The sun will not strike you by day,"},{"start":53.02,"end":55.55,"text":"nor the moon by night."},{"start":55.6,"end":59.51,"text":"The LORD will guard you from all evil;"},{"start":59.56,"end":62.93,"text":"He will preserve your soul."},{"start":62.98,"end":75.27,"text":"The LORD will watch over your coming and going,"},{"start":75.32,"end":80.74,"text":"both now and forevermore."}],"times_from":"machine"}