{"passage":"Psalm 121","credit":"Berean Standard Bible","duration":80.743991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.4,"text":"A song of ascents."},{"start":6.4,"end":10.79,"text":"I lift up my eyes to the hills."},{"start":10.79,"end":15.19,"text":"From where does my help come?"},{"start":15.19,"end":19.59,"text":"My help comes from the LORD,"},{"start":19.59,"end":23.98,"text":"the Maker of heaven and earth."},{"start":23.98,"end":28.38,"text":"He will not allow your foot to slip;"},{"start":28.38,"end":32.78,"text":"your Protector will not slumber."},{"start":32.78,"end":37.17,"text":"Behold, the Protector of Israel"},{"start":37.17,"end":41.57,"text":"will neither slumber nor sleep."},{"start":41.57,"end":45.97,"text":"The LORD is your keeper;"},{"start":45.97,"end":50.36,"text":"the LORD is the shade on your right hand."},{"start":50.36,"end":54.76,"text":"The sun will not strike you by day,"},{"start":54.76,"end":59.16,"text":"nor the moon by night."},{"start":59.16,"end":63.55,"text":"The LORD will guard you from all evil;"},{"start":63.55,"end":67.95,"text":"He will preserve your soul."},{"start":67.95,"end":72.35,"text":"The LORD will watch over your coming and going,"},{"start":72.35,"end":76.74,"text":"both now and forevermore."}]}