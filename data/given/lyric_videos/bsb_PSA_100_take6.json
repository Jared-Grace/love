{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":85.19,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.66,"text":"A Psalm of thanksgiving."},{"start":7.66,"end":13.31,"text":"Make a joyful noise to the LORD,"},{"start":13.31,"end":18.97,"text":"all the earth."},{"start":18.97,"end":24.63,"text":"Serve the LORD with gladness;"},{"start":24.63,"end":30.28,"text":"come into His presence with joyful songs."},{"start":30.28,"end":35.94,"text":"Know that the LORD is God."},{"start":35.94,"end":41.6,"text":"It is He who made us, and we are His;"},{"start":41.6,"end":47.25,"text":"we are His people, and the sheep of His pasture."},{"start":47.25,"end":52.91,"text":"Enter His gates with thanksgiving"},{"start":52.91,"end":58.56,"text":"and His courts with praise;"},{"start":58.56,"end":64.22,"text":"give thanks to Him and bless His name."},{"start":64.22,"end":69.88,"text":"For the LORD is good,"},{"start":69.88,"end":75.53,"text":"and His loving devotion endures forever;"},{"start":75.53,"end":81.19,"text":"His faithfulness continues to all generations."}]}