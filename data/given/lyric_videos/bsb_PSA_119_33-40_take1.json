{"passage":"Psalm 119:33-40","credit":"Berean Standard Bible","duration":90.626009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.29,"text":"Teach me, O LORD, the way of Your statutes,"},{"start":7.29,"end":12.58,"text":"and I will keep them to the end."},{"start":12.58,"end":17.87,"text":"Give me understanding that I may obey Your law,"},{"start":17.87,"end":23.16,"text":"and follow it with all my heart."},{"start":23.16,"end":28.45,"text":"Direct me in the path of Your commandments,"},{"start":28.45,"end":33.73,"text":"for there I find delight."},{"start":33.73,"end":39.02,"text":"Turn my heart to Your testimonies"},{"start":39.02,"end":44.31,"text":"and not to covetous gain."},{"start":44.31,"end":49.6,"text":"Turn my eyes away from worthless things;"},{"start":49.6,"end":54.89,"text":"revive me with Your word."},{"start":54.89,"end":60.18,"text":"Establish Your word to Your servant,"},{"start":60.18,"end":65.47,"text":"to produce reverence for You."},{"start":65.47,"end":70.76,"text":"Turn away the disgrace I dread,"},{"start":70.76,"end":76.05,"text":"for Your judgments are good."},{"start":76.05,"end":81.34,"text":"How I long for Your precepts!"},{"start":81.34,"end":86.63,"text":"Revive me in Your righteousness."}]}