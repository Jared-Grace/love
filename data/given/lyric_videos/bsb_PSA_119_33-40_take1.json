{"passage":"Psalm 119:33-40","credit":"Berean Standard Bible","duration":90.626009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.7,"end":8.97,"text":"Teach me, O LORD, the way of Your statutes,"},{"start":9.02,"end":16.03,"text":"and I will keep them to the end."},{"start":16.08,"end":21.25,"text":"Give me understanding that I may obey Your law,"},{"start":21.3,"end":26.63,"text":"and follow it with all my heart."},{"start":26.68,"end":32.71,"text":"Direct me in the path of Your commandments,"},{"start":32.76,"end":35.32,"text":"for there I find delight."},{"start":35.37,"end":38.86,"text":"Turn my heart to Your testimonies"},{"start":38.91,"end":41.48,"text":"and not to covetous gain."},{"start":41.53,"end":47.06,"text":"Turn my eyes away from worthless things;"},{"start":47.11,"end":52.7,"text":"revive me with Your word."},{"start":52.75,"end":58.34,"text":"Establish Your word to Your servant,"},{"start":58.39,"end":65.28,"text":"to produce reverence for You."},{"start":65.33,"end":70.3,"text":"Turn away the disgrace I dread,"},{"start":70.35,"end":73.48,"text":"for Your judgments are good."},{"start":73.53,"end":77.22,"text":"How I long for Your precepts!"},{"start":77.27,"end":90.63,"text":"Revive me in Your righteousness."}],"times_from":"machine"}