{"passage":"Psalm 96:11-13","credit":"Berean Standard Bible","duration":66.829002,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.07,"text":"Let the heavens be glad"},{"start":7.07,"end":12.14,"text":"and the earth rejoice;"},{"start":12.14,"end":17.21,"text":"let the sea resound,"},{"start":17.21,"end":22.28,"text":"and all that fills it."},{"start":22.28,"end":27.35,"text":"Let the fields exult,"},{"start":27.35,"end":32.41,"text":"and all that is in them."},{"start":32.41,"end":37.48,"text":"Then all the trees of the forest"},{"start":37.48,"end":42.55,"text":"will sing for joy before the LORD,"},{"start":42.55,"end":47.62,"text":"for He is coming—"},{"start":47.62,"end":52.69,"text":"He is coming to judge the earth."},{"start":52.69,"end":57.76,"text":"He will judge the world in righteousness"},{"start":57.76,"end":62.83,"text":"and the peoples in His faithfulness."}]}