{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":79.670998,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.26,"text":"A Psalm of thanksgiving."},{"start":7.26,"end":12.52,"text":"Make a joyful noise to the LORD,"},{"start":12.52,"end":17.79,"text":"all the earth."},{"start":17.79,"end":23.05,"text":"Serve the LORD with gladness;"},{"start":23.05,"end":28.31,"text":"come into His presence with joyful songs."},{"start":28.31,"end":33.57,"text":"Know that the LORD is God."},{"start":33.57,"end":38.84,"text":"It is He who made us, and we are His;"},{"start":38.84,"end":44.1,"text":"we are His people, and the sheep of His pasture."},{"start":44.1,"end":49.36,"text":"Enter His gates with thanksgiving"},{"start":49.36,"end":54.62,"text":"and His courts with praise;"},{"start":54.62,"end":59.88,"text":"give thanks to Him and bless His name."},{"start":59.88,"end":65.15,"text":"For the LORD is good,"},{"start":65.15,"end":70.41,"text":"and His loving devotion endures forever;"},{"start":70.41,"end":75.67,"text":"His faithfulness continues to all generations."}]}