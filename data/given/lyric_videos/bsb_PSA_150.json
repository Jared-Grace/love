{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":104.96,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.33,"end":4.84,"text":"Hallelujah!"},{"start":4.89,"end":11.5,"text":"Praise God in His sanctuary."},{"start":12.27,"end":21.7,"text":"Praise Him in His mighty heavens."},{"start":25.09,"end":31.6,"text":"Praise Him for His mighty acts;"},{"start":31.65,"end":38.3,"text":"praise Him for His excellent greatness."},{"start":38.35,"end":44.29,"text":"Praise Him with the sound of the horn;"},{"start":44.34,"end":51.43,"text":"praise Him with the harp and lyre."},{"start":51.48,"end":58.22,"text":"Praise Him with tambourine and dancing;"},{"start":58.27,"end":64.46,"text":"praise Him with strings and flute."},{"start":64.51,"end":70.61,"text":"Praise Him with clashing cymbals;"},{"start":70.66,"end":77.16,"text":"praise Him with resounding cymbals."},{"start":77.21,"end":84.87,"text":"Let everything that has breath"},{"start":84.92,"end":92.78,"text":"praise the LORD!"},{"start":96.33,"end":100.58,"text":"Hallelujah!"}],"times_from":"machine"}