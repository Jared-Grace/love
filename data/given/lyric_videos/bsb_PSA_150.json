{"passage":"Psalm 150","credit":"Berean Standard Bible","duration":104.96,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.26,"end":5.67,"text":"Hallelujah!"},{"start":5.72,"end":12.81,"text":"Praise God in His sanctuary."},{"start":12.86,"end":25.62,"text":"Praise Him in His mighty heavens."},{"start":25.67,"end":32.16,"text":"Praise Him for His mighty acts;"},{"start":32.21,"end":38.74,"text":"praise Him for His excellent greatness."},{"start":38.79,"end":45.18,"text":"Praise Him with the sound of the horn;"},{"start":45.23,"end":51.78,"text":"praise Him with the harp and lyre."},{"start":51.83,"end":58.42,"text":"Praise Him with tambourine and dancing;"},{"start":58.47,"end":65.06,"text":"praise Him with strings and flute."},{"start":65.11,"end":71.76,"text":"Praise Him with clashing cymbals;"},{"start":71.81,"end":77.75,"text":"praise Him with resounding cymbals."},{"start":77.8,"end":86.39,"text":"Let everything that has breath"},{"start":86.44,"end":92.27,"text":"praise the LORD!"},{"start":92.32,"end":104.96,"text":"Hallelujah!"}],"times_from":"machine"}