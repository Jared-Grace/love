{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":82.435011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2.98,"end":6.45,"text":"Righteous are You, O LORD,"},{"start":6.5,"end":10.03,"text":"and upright are Your judgments."},{"start":10.08,"end":16.59,"text":"The testimonies You have laid down are righteous"},{"start":16.64,"end":19.59,"text":"and altogether faithful."},{"start":19.64,"end":22.83,"text":"My zeal has consumed me"},{"start":22.88,"end":26.28,"text":"because my foes forget Your words."},{"start":26.33,"end":29.74,"text":"Your promise is completely pure;"},{"start":29.79,"end":35.28,"text":"therefore Your servant loves it."},{"start":35.33,"end":39.28,"text":"I am lowly and despised,"},{"start":39.33,"end":43.1,"text":"but I do not forget Your precepts."},{"start":43.15,"end":47,"text":"Your righteousness is everlasting"},{"start":47.05,"end":50,"text":"and Your law is true."},{"start":50.05,"end":52.64,"text":"Trouble and distress have found me,"},{"start":52.69,"end":56.08,"text":"but Your commandments are my delight."},{"start":56.13,"end":62.24,"text":"Your testimonies are righteous forever."},{"start":62.29,"end":82.44,"text":"Give me understanding, that I may live."}],"times_from":"machine"}