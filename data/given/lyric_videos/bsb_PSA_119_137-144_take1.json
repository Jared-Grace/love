{"passage":"Psalm 119:137-144","credit":"Berean Standard Bible","duration":82.435011,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.78,"text":"Righteous are You, O LORD,"},{"start":6.78,"end":11.55,"text":"and upright are Your judgments."},{"start":11.55,"end":16.33,"text":"The testimonies You have laid down are righteous"},{"start":16.33,"end":21.11,"text":"and altogether faithful."},{"start":21.11,"end":25.89,"text":"My zeal has consumed me"},{"start":25.89,"end":30.66,"text":"because my foes forget Your words."},{"start":30.66,"end":35.44,"text":"Your promise is completely pure;"},{"start":35.44,"end":40.22,"text":"therefore Your servant loves it."},{"start":40.22,"end":44.99,"text":"I am lowly and despised,"},{"start":44.99,"end":49.77,"text":"but I do not forget Your precepts."},{"start":49.77,"end":54.55,"text":"Your righteousness is everlasting"},{"start":54.55,"end":59.33,"text":"and Your law is true."},{"start":59.33,"end":64.1,"text":"Trouble and distress have found me,"},{"start":64.1,"end":68.88,"text":"but Your commandments are my delight."},{"start":68.88,"end":73.66,"text":"Your testimonies are righteous forever."},{"start":73.66,"end":78.44,"text":"Give me understanding, that I may live."}]}