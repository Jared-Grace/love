{"passage":"Psalm 105:23-27","credit":"Berean Standard Bible","duration":87.393991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":10.14,"text":"Then Israel entered Egypt;"},{"start":10.14,"end":18.28,"text":"Jacob dwelt in the land of Ham."},{"start":18.28,"end":26.42,"text":"And the LORD made His people very fruitful,"},{"start":26.42,"end":34.56,"text":"more numerous than their foes,"},{"start":34.56,"end":42.7,"text":"whose hearts He turned to hate His people,"},{"start":42.7,"end":50.84,"text":"to conspire against His servants."},{"start":50.84,"end":58.98,"text":"He sent Moses His servant,"},{"start":58.98,"end":67.12,"text":"and Aaron, whom He had chosen."},{"start":67.12,"end":75.25,"text":"They performed His miraculous signs among them,"},{"start":75.25,"end":83.39,"text":"and wonders in the land of Ham."}]}