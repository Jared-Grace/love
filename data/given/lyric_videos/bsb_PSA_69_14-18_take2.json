{"passage":"Psalm 69:14-18","credit":"Berean Standard Bible","duration":70.881995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":0.4,"end":4.65,"text":"Rescue me from the mire"},{"start":4.7,"end":8.31,"text":"and do not let me sink;"},{"start":8.36,"end":12.13,"text":"deliver me from my foes"},{"start":12.18,"end":16.35,"text":"and out of the deep waters."},{"start":16.4,"end":19.97,"text":"Do not let the floods engulf me"},{"start":20.02,"end":22.77,"text":"or the depths swallow me up;"},{"start":22.82,"end":28.61,"text":"let not the Pit close its mouth over me."},{"start":28.66,"end":31.95,"text":"Answer me, O LORD,"},{"start":32,"end":36.57,"text":"for Your loving devotion is good;"},{"start":36.62,"end":41.81,"text":"turn to me in keeping with Your great compassion."},{"start":41.86,"end":46.37,"text":"Hide not Your face from Your servant,"},{"start":46.42,"end":49.27,"text":"for I am in distress."},{"start":49.32,"end":55.55,"text":"Answer me quickly!"},{"start":55.6,"end":59.03,"text":"Draw near to my soul and redeem me;"},{"start":59.08,"end":70.88,"text":"ransom me because of my foes."}],"times_from":"machine"}