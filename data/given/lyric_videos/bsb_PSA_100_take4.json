{"passage":"Psalm 100","credit":"Berean Standard Bible","duration":79.891995,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.28,"text":"A Psalm of thanksgiving."},{"start":7.28,"end":12.56,"text":"Make a joyful noise to the LORD,"},{"start":12.56,"end":17.83,"text":"all the earth."},{"start":17.83,"end":23.11,"text":"Serve the LORD with gladness;"},{"start":23.11,"end":28.39,"text":"come into His presence with joyful songs."},{"start":28.39,"end":33.67,"text":"Know that the LORD is God."},{"start":33.67,"end":38.95,"text":"It is He who made us, and we are His;"},{"start":38.95,"end":44.22,"text":"we are His people, and the sheep of His pasture."},{"start":44.22,"end":49.5,"text":"Enter His gates with thanksgiving"},{"start":49.5,"end":54.78,"text":"and His courts with praise;"},{"start":54.78,"end":60.06,"text":"give thanks to Him and bless His name."},{"start":60.06,"end":65.34,"text":"For the LORD is good,"},{"start":65.34,"end":70.61,"text":"and His loving devotion endures forever;"},{"start":70.61,"end":75.89,"text":"His faithfulness continues to all generations."}]}