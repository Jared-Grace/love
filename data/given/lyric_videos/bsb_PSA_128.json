{"passage":"Psalm 128","credit":"Berean Standard Bible","duration":74.216009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.01,"text":"A song of ascents."},{"start":6.01,"end":10.03,"text":"Blessed are all who fear the LORD,"},{"start":10.03,"end":14.04,"text":"who walk in His ways!"},{"start":14.04,"end":18.05,"text":"For when you eat the fruit of your labor,"},{"start":18.05,"end":22.06,"text":"blessings and prosperity will be yours."},{"start":22.06,"end":26.08,"text":"Your wife will be like a fruitful vine"},{"start":26.08,"end":30.09,"text":"flourishing within your house,"},{"start":30.09,"end":34.1,"text":"your sons like olive shoots"},{"start":34.1,"end":38.11,"text":"sitting around your table."},{"start":38.11,"end":42.13,"text":"In this way indeed shall blessing come"},{"start":42.13,"end":46.14,"text":"to the man who fears the LORD."},{"start":46.14,"end":50.15,"text":"May the LORD bless you from Zion,"},{"start":50.15,"end":54.17,"text":"that you may see the prosperity of Jerusalem"},{"start":54.17,"end":58.18,"text":"all the days of your life,"},{"start":58.18,"end":62.19,"text":"that you may see"},{"start":62.19,"end":66.2,"text":"your children’s children."},{"start":66.2,"end":70.22,"text":"Peace be upon Israel!"}]}