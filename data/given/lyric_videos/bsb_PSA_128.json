{"passage":"Psalm 128","credit":"Berean Standard Bible","duration":74.216009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.32,"end":7.45,"text":"A song of ascents."},{"start":7.5,"end":12.21,"text":"Blessed are all who fear the LORD,"},{"start":12.26,"end":14.73,"text":"who walk in His ways!"},{"start":14.78,"end":21.46,"text":"For when you eat the fruit of your labor,"},{"start":21.51,"end":25.04,"text":"blessings and prosperity will be yours."},{"start":25.09,"end":29.44,"text":"Your wife will be like a fruitful vine"},{"start":29.49,"end":32.22,"text":"flourishing within your house,"},{"start":32.27,"end":34.76,"text":"your sons like olive shoots"},{"start":34.81,"end":37.78,"text":"sitting around your table."},{"start":37.83,"end":42,"text":"In this way indeed shall blessing come"},{"start":42.05,"end":44.78,"text":"to the man who fears the LORD."},{"start":44.83,"end":48.74,"text":"May the LORD bless you from Zion,"},{"start":48.79,"end":54.16,"text":"that you may see the prosperity of Jerusalem"},{"start":54.21,"end":56.74,"text":"all the days of your life,"},{"start":56.79,"end":58.02,"text":"that you may see"},{"start":58.07,"end":60.48,"text":"your children’s children."},{"start":60.53,"end":74.22,"text":"Peace be upon Israel!"}]}