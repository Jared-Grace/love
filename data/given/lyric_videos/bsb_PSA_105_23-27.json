{"passage":"Psalm 105:23-27","credit":"Berean Standard Bible","duration":67.608005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":8.16,"text":"Then Israel entered Egypt;"},{"start":8.16,"end":14.32,"text":"Jacob dwelt in the land of Ham."},{"start":14.32,"end":20.48,"text":"And the LORD made His people very fruitful,"},{"start":20.48,"end":26.64,"text":"more numerous than their foes,"},{"start":26.64,"end":32.8,"text":"whose hearts He turned to hate His people,"},{"start":32.8,"end":38.96,"text":"to conspire against His servants."},{"start":38.96,"end":45.13,"text":"He sent Moses His servant,"},{"start":45.13,"end":51.29,"text":"and Aaron, whom He had chosen."},{"start":51.29,"end":57.45,"text":"They performed His miraculous signs among them,"},{"start":57.45,"end":63.61,"text":"and wonders in the land of Ham."}]}