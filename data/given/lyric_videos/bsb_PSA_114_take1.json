{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":80.133991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.63,"text":"When Israel departed from Egypt,"},{"start":6.63,"end":11.27,"text":"the house of Jacob from a people of foreign tongue,"},{"start":11.27,"end":15.9,"text":"Judah became God’s sanctuary,"},{"start":15.9,"end":20.53,"text":"Israel His dominion."},{"start":20.53,"end":25.17,"text":"The sea observed and fled;"},{"start":25.17,"end":29.8,"text":"the Jordan turned back;"},{"start":29.8,"end":34.43,"text":"the mountains skipped like rams,"},{"start":34.43,"end":39.07,"text":"the hills like lambs."},{"start":39.07,"end":43.7,"text":"Why was it, O sea, that you fled,"},{"start":43.7,"end":48.33,"text":"O Jordan, that you turned back,"},{"start":48.33,"end":52.97,"text":"O mountains, that you skipped like rams,"},{"start":52.97,"end":57.6,"text":"O hills, like lambs?"},{"start":57.6,"end":62.23,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":62.23,"end":66.87,"text":"at the presence of the God of Jacob,"},{"start":66.87,"end":71.5,"text":"who turned the rock into a pool,"},{"start":71.5,"end":76.13,"text":"the flint into a fountain of water!"}]}