{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":80.133991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.54,"end":9.33,"text":"When Israel departed from Egypt,"},{"start":9.38,"end":15.89,"text":"the house of Jacob from a people of foreign tongue,"},{"start":15.94,"end":20.11,"text":"Judah became God’s sanctuary,"},{"start":20.16,"end":23.71,"text":"Israel His dominion."},{"start":23.76,"end":26.94,"text":"The sea observed and fled;"},{"start":26.99,"end":30.14,"text":"the Jordan turned back;"},{"start":30.19,"end":33.4,"text":"the mountains skipped like rams,"},{"start":33.45,"end":37.54,"text":"the hills like lambs."},{"start":37.59,"end":42.56,"text":"Why was it, O sea, that you fled,"},{"start":42.61,"end":46.2,"text":"O Jordan, that you turned back,"},{"start":46.25,"end":49.42,"text":"O mountains, that you skipped like rams,"},{"start":49.47,"end":58.32,"text":"O hills, like lambs?"},{"start":58.37,"end":63.82,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":63.87,"end":68.14,"text":"at the presence of the God of Jacob,"},{"start":68.19,"end":71.18,"text":"who turned the rock into a pool,"},{"start":71.23,"end":80.13,"text":"the flint into a fountain of water!"}],"times_from":"machine"}