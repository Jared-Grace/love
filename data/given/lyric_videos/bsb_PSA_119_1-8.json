{"passage":"Psalm 119:1-8","credit":"Berean Standard Bible","duration":83.512993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":1.36,"end":7.67,"text":"Blessed are those whose way is blameless,"},{"start":7.72,"end":14.37,"text":"who walk in the Law of the LORD."},{"start":14.42,"end":20.71,"text":"Blessed are those who keep His testimonies"},{"start":20.76,"end":27.25,"text":"and seek Him with all their heart."},{"start":27.3,"end":30.52,"text":"They do no iniquity;"},{"start":30.57,"end":34,"text":"they walk in His ways."},{"start":34.05,"end":38.68,"text":"You have ordained Your precepts,"},{"start":38.73,"end":43.58,"text":"that we should keep them diligently."},{"start":43.63,"end":48.66,"text":"Oh, that my ways were committed"},{"start":48.71,"end":50.96,"text":"to keeping Your statutes!"},{"start":51.01,"end":55.64,"text":"Then I would not be ashamed"},{"start":55.69,"end":59.8,"text":"when I consider all Your commandments."},{"start":59.85,"end":69.1,"text":"I will praise You with an upright heart"},{"start":69.15,"end":73.68,"text":"when I learn Your righteous judgments."},{"start":73.73,"end":76.7,"text":"I will keep Your statutes;"},{"start":76.75,"end":83.51,"text":"do not utterly forsake me."}],"times_from":"machine"}