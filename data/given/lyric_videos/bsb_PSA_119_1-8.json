{"passage":"Psalm 119:1-8","credit":"Berean Standard Bible","duration":83.512993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.84,"text":"Blessed are those whose way is blameless,"},{"start":6.84,"end":11.69,"text":"who walk in the Law of the LORD."},{"start":11.69,"end":16.53,"text":"Blessed are those who keep His testimonies"},{"start":16.53,"end":21.38,"text":"and seek Him with all their heart."},{"start":21.38,"end":26.22,"text":"They do no iniquity;"},{"start":26.22,"end":31.07,"text":"they walk in His ways."},{"start":31.07,"end":35.91,"text":"You have ordained Your precepts,"},{"start":35.91,"end":40.76,"text":"that we should keep them diligently."},{"start":40.76,"end":45.6,"text":"Oh, that my ways were committed"},{"start":45.6,"end":50.45,"text":"to keeping Your statutes!"},{"start":50.45,"end":55.29,"text":"Then I would not be ashamed"},{"start":55.29,"end":60.13,"text":"when I consider all Your commandments."},{"start":60.13,"end":64.98,"text":"I will praise You with an upright heart"},{"start":64.98,"end":69.82,"text":"when I learn Your righteous judgments."},{"start":69.82,"end":74.67,"text":"I will keep Your statutes;"},{"start":74.67,"end":79.51,"text":"do not utterly forsake me."}]}