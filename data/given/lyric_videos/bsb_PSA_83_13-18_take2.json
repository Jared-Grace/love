{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":82.46,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.88,"text":"Make them like tumbleweed, O my God,"},{"start":7.88,"end":13.76,"text":"like chaff before the wind."},{"start":13.76,"end":19.64,"text":"As fire consumes a forest,"},{"start":19.64,"end":25.53,"text":"as a flame sets the mountains ablaze,"},{"start":25.53,"end":31.41,"text":"so pursue them with Your tempest,"},{"start":31.41,"end":37.29,"text":"and terrify them with Your storm."},{"start":37.29,"end":43.17,"text":"Cover their faces with shame,"},{"start":43.17,"end":49.05,"text":"that they may seek Your name, O LORD."},{"start":49.05,"end":54.93,"text":"May they be ever ashamed and terrified;"},{"start":54.93,"end":60.82,"text":"may they perish in disgrace."},{"start":60.82,"end":66.7,"text":"May they know that You alone,"},{"start":66.7,"end":72.58,"text":"whose name is the LORD,"},{"start":72.58,"end":78.46,"text":"are Most High over all the earth."}]}