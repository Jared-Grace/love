{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":74.723991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":3.52,"end":9.91,"text":"When Israel departed from Egypt,"},{"start":9.96,"end":16.04,"text":"the house of Jacob from a people of foreign tongue,"},{"start":16.09,"end":19.68,"text":"Judah became God’s sanctuary,"},{"start":19.73,"end":23.24,"text":"Israel His dominion."},{"start":23.29,"end":26.14,"text":"The sea observed and fled;"},{"start":26.19,"end":29.84,"text":"the Jordan turned back;"},{"start":29.89,"end":33.08,"text":"the mountains skipped like rams,"},{"start":33.13,"end":35.64,"text":"the hills like lambs."},{"start":35.69,"end":39.02,"text":"Why was it, O sea, that you fled,"},{"start":39.07,"end":42.2,"text":"O Jordan, that you turned back,"},{"start":42.25,"end":45.95,"text":"O mountains, that you skipped like rams,"},{"start":46,"end":47.49,"text":"O hills, like lambs?"},{"start":47.54,"end":56.21,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":56.26,"end":59.95,"text":"at the presence of the God of Jacob,"},{"start":60,"end":62.93,"text":"who turned the rock into a pool,"},{"start":62.98,"end":74.72,"text":"the flint into a fountain of water!"}],"times_from":"machine"}