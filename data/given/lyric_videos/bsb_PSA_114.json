{"passage":"Psalm 114","credit":"Berean Standard Bible","duration":74.723991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.3,"text":"When Israel departed from Egypt,"},{"start":6.3,"end":10.59,"text":"the house of Jacob from a people of foreign tongue,"},{"start":10.59,"end":14.89,"text":"Judah became God’s sanctuary,"},{"start":14.89,"end":19.18,"text":"Israel His dominion."},{"start":19.18,"end":23.48,"text":"The sea observed and fled;"},{"start":23.48,"end":27.77,"text":"the Jordan turned back;"},{"start":27.77,"end":32.07,"text":"the mountains skipped like rams,"},{"start":32.07,"end":36.36,"text":"the hills like lambs."},{"start":36.36,"end":40.66,"text":"Why was it, O sea, that you fled,"},{"start":40.66,"end":44.95,"text":"O Jordan, that you turned back,"},{"start":44.95,"end":49.25,"text":"O mountains, that you skipped like rams,"},{"start":49.25,"end":53.54,"text":"O hills, like lambs?"},{"start":53.54,"end":57.84,"text":"Tremble, O earth, at the presence of the Lord,"},{"start":57.84,"end":62.13,"text":"at the presence of the God of Jacob,"},{"start":62.13,"end":66.43,"text":"who turned the rock into a pool,"},{"start":66.43,"end":70.72,"text":"the flint into a fountain of water!"}]}