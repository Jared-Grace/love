{"passage":"Psalm 97:1-6","credit":"Berean Standard Bible","duration":114.178005,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":10.32,"text":"The LORD reigns, let the earth rejoice;"},{"start":10.32,"end":18.64,"text":"let the distant shores be glad."},{"start":18.64,"end":26.96,"text":"Clouds and darkness surround Him;"},{"start":26.96,"end":35.29,"text":"righteousness and justice are His throne’s foundation."},{"start":35.29,"end":43.61,"text":"Fire goes before Him"},{"start":43.61,"end":51.93,"text":"and consumes His foes on every side."},{"start":51.93,"end":60.25,"text":"His lightning illuminates the world;"},{"start":60.25,"end":68.57,"text":"the earth sees and trembles."},{"start":68.57,"end":76.89,"text":"The mountains melt like wax"},{"start":76.89,"end":85.21,"text":"at the presence of the LORD,"},{"start":85.21,"end":93.54,"text":"before the Lord of all the earth."},{"start":93.54,"end":101.86,"text":"The heavens proclaim His righteousness;"},{"start":101.86,"end":110.18,"text":"all the peoples see His glory."}]}