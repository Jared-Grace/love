{"passage":"Psalm 83:13-18","credit":"Berean Standard Bible","duration":71.923991,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":7.07,"text":"Make them like tumbleweed, O my God,"},{"start":7.07,"end":12.14,"text":"like chaff before the wind."},{"start":12.14,"end":17.21,"text":"As fire consumes a forest,"},{"start":17.21,"end":22.28,"text":"as a flame sets the mountains ablaze,"},{"start":22.28,"end":27.36,"text":"so pursue them with Your tempest,"},{"start":27.36,"end":32.43,"text":"and terrify them with Your storm."},{"start":32.43,"end":37.5,"text":"Cover their faces with shame,"},{"start":37.5,"end":42.57,"text":"that they may seek Your name, O LORD."},{"start":42.57,"end":47.64,"text":"May they be ever ashamed and terrified;"},{"start":47.64,"end":52.71,"text":"may they perish in disgrace."},{"start":52.71,"end":57.78,"text":"May they know that You alone,"},{"start":57.78,"end":62.85,"text":"whose name is the LORD,"},{"start":62.85,"end":67.92,"text":"are Most High over all the earth."}]}