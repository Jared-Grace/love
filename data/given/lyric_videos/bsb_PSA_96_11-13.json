{"passage":"Psalm 96:11-13","credit":"Berean Standard Bible","duration":59.386009,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.45,"text":"Let the heavens be glad"},{"start":6.45,"end":10.9,"text":"and the earth rejoice;"},{"start":10.9,"end":15.35,"text":"let the sea resound,"},{"start":15.35,"end":19.8,"text":"and all that fills it."},{"start":19.8,"end":24.24,"text":"Let the fields exult,"},{"start":24.24,"end":28.69,"text":"and all that is in them."},{"start":28.69,"end":33.14,"text":"Then all the trees of the forest"},{"start":33.14,"end":37.59,"text":"will sing for joy before the LORD,"},{"start":37.59,"end":42.04,"text":"for He is coming—"},{"start":42.04,"end":46.49,"text":"He is coming to judge the earth."},{"start":46.49,"end":50.94,"text":"He will judge the world in righteousness"},{"start":50.94,"end":55.39,"text":"and the peoples in His faithfulness."}]}