{"passage":"Psalm 98:1-3","credit":"Berean Standard Bible","duration":49.952993,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6,"text":"A Psalm."},{"start":6,"end":9.99,"text":"Sing to the LORD a new song,"},{"start":9.99,"end":13.99,"text":"for He has done wonders;"},{"start":13.99,"end":17.98,"text":"His right hand and holy arm"},{"start":17.98,"end":21.98,"text":"have gained Him the victory."},{"start":21.98,"end":25.97,"text":"The LORD has proclaimed His salvation"},{"start":25.97,"end":29.97,"text":"and revealed His righteousness to the nations."},{"start":29.97,"end":33.97,"text":"He has remembered His love and faithfulness"},{"start":33.97,"end":37.96,"text":"to the house of Israel;"},{"start":37.96,"end":41.96,"text":"all the ends of the earth"},{"start":41.96,"end":45.95,"text":"have seen the salvation of our God."}]}