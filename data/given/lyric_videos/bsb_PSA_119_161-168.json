{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":84.477007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":4.84,"end":11.19,"text":"Rulers persecute me without cause,"},{"start":11.24,"end":17.27,"text":"but my heart fears only Your word."},{"start":17.32,"end":20.39,"text":"I rejoice in Your promise"},{"start":20.44,"end":24.06,"text":"like one who finds great spoil."},{"start":24.11,"end":29.18,"text":"I hate and abhor falsehood,"},{"start":29.23,"end":31.38,"text":"but Your law I love."},{"start":31.43,"end":34.24,"text":"Seven times a day I praise You"},{"start":34.29,"end":38.76,"text":"for Your righteous judgments."},{"start":38.81,"end":44.48,"text":"Abundant peace belongs to those who love Your law;"},{"start":44.53,"end":47,"text":"nothing can make them stumble."},{"start":47.05,"end":51.66,"text":"I wait for Your salvation, O LORD,"},{"start":51.71,"end":55.88,"text":"and I carry out Your commandments."},{"start":55.93,"end":59.68,"text":"I obey Your testimonies"},{"start":59.73,"end":64.16,"text":"and love them greatly."},{"start":64.21,"end":72.39,"text":"I obey Your precepts and Your testimonies,"},{"start":72.44,"end":84.48,"text":"for all my ways are before You."}],"times_from":"machine"}