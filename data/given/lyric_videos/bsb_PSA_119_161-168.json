{"passage":"Psalm 119:161-168","credit":"Berean Standard Bible","duration":84.477007,"width":1080,"height":1920,"font_size":150,"passage_font_size":96,"credit_font_size":64,"lines":[{"start":2,"end":6.9,"text":"Rulers persecute me without cause,"},{"start":6.9,"end":11.81,"text":"but my heart fears only Your word."},{"start":11.81,"end":16.71,"text":"I rejoice in Your promise"},{"start":16.71,"end":21.62,"text":"like one who finds great spoil."},{"start":21.62,"end":26.52,"text":"I hate and abhor falsehood,"},{"start":26.52,"end":31.43,"text":"but Your law I love."},{"start":31.43,"end":36.33,"text":"Seven times a day I praise You"},{"start":36.33,"end":41.24,"text":"for Your righteous judgments."},{"start":41.24,"end":46.14,"text":"Abundant peace belongs to those who love Your law;"},{"start":46.14,"end":51.05,"text":"nothing can make them stumble."},{"start":51.05,"end":55.95,"text":"I wait for Your salvation, O LORD,"},{"start":55.95,"end":60.86,"text":"and I carry out Your commandments."},{"start":60.86,"end":65.76,"text":"I obey Your testimonies"},{"start":65.76,"end":70.67,"text":"and love them greatly."},{"start":70.67,"end":75.57,"text":"I obey Your precepts and Your testimonies,"},{"start":75.57,"end":80.48,"text":"for all my ways are before You."}]}