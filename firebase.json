{
  "hosting": {
    "public": "web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dev/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/alarms.apk",
        "destination": "https://firebasestorage.googleapis.com/v0/b/jared-grace.firebasestorage.app/o/http%2Falarms%2Fapp-debug.apk?alt=media",
        "type": 302
      },
      {
        "source": "/privacy_policy",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/privacy_policy.html",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/apps_all",
        "destination": "/app",
        "type": 301
      },
      {
        "source": "/apps_all.html",
        "destination": "/app",
        "type": 301
      },
      {
        "source": "/designs_universal",
        "destination": "/design",
        "type": 301
      },
      {
        "source": "/designs_universal.html",
        "destination": "/design",
        "type": 301
      },
      {
        "source": "/autopray",
        "destination": "/pray_auto",
        "type": 301
      },
      {
        "source": "/autopray.html",
        "destination": "/pray_auto",
        "type": 301
      },
      {
        "source": "/emoji_bible",
        "destination": "/bible_emoji",
        "type": 301
      },
      {
        "source": "/emoji_bible.html",
        "destination": "/bible_emoji",
        "type": 301
      },
      {
        "source": "/original_bible",
        "destination": "/learn_original",
        "type": 301
      },
      {
        "source": "/original_bible.html",
        "destination": "/learn_original",
        "type": 301
      },
      {
        "source": "/ceb_bible",
        "destination": "/learn_ceb",
        "type": 301
      },
      {
        "source": "/ceb_bible.html",
        "destination": "/learn_ceb",
        "type": 301
      },
      {
        "source": "/search",
        "destination": "/bible_search",
        "type": 301
      },
      {
        "source": "/search.html",
        "destination": "/bible_search",
        "type": 301
      },
      {
        "source": "/en_learn_bible",
        "destination": "/learn_en",
        "type": 301
      },
      {
        "source": "/en_learn_bible.html",
        "destination": "/learn_en",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
